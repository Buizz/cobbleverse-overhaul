{
  "$schema": "../../schemas/dungeon.schema.json",
  "schema_version": 1,
  "dungeon_id": "cobbleventure:dungeon/rocket_power_plant",
  "display_name": {
    "ko_kr": "점거된 발전소",
    "en_us": "Occupied Power Plant"
  },
  "description": {
    "ko_kr": "로켓단이 돌산터널 인근의 무인 발전소를 점거했습니다.",
    "en_us": "Team Rocket has occupied the abandoned power plant near Rock Tunnel."
  },
  "preset": "cobbleventure:team_rocket_facility",
  "entrances": [
    {
      "entrance_id": "cobbleventure:entrance/rocket_power_plant",
      "destination_entry": "main",
      "activation": "proximity",
      "visibility": "always",
      "return_policy": "source_safe_anchor"
    }
  ],
  "entry_ui": {
    "info_mode": "summary",
    "confirm_required": true,
    "background_texture": "cobbleventure_bootstrap:textures/gui/dungeons/rocket_facility.png"
  },
  "difficulty": {
    "recommended_min": 1,
    "recommended_max": 1,
    "internal_min": 1,
    "internal_max": 1
  },
  "eligibility": {
    "minimum_party_size": 1,
    "maximum_party_size": 6,
    "require_usable_pokemon": true,
    "level_measure": "average",
    "recommended_level_policy": "warn"
  },
  "multiplayer": {
    "mode": "solo",
    "min_size": 1,
    "max_size": 1
  },
  "match": {
    "required_players": 1,
    "scope": "same_entrance",
    "timeout_seconds": 300,
    "on_timeout": "cancel",
    "stay_radius": 8
  },
  "battle": {
    "allow_flee": false,
    "allow_capture": true,
    "allow_items": true,
    "allow_escape_actions": false
  },
  "terrain": {
    "mode": "fixed_template",
    "template": "cobbleventure:placeholder/power_plant"
  },
  "encounters": [
    {
      "id": "west_grunt",
      "display_name": {
        "ko_kr": "서쪽 정비 구역 로켓단",
        "en_us": "West Maintenance Team Rocket"
      },
      "npcs": [
        "cobbleventure:npc/rocket_power_plant_grunt"
      ],
      "opponents": [
        "cobbleventure:battle/rocket_power_plant_grunt"
      ],
      "requires": [],
      "run_state_keys": [
        "cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated"
      ],
      "yaw": 90,
      "boss": false
    },
    {
      "id": "east_grunt",
      "display_name": {
        "ko_kr": "동쪽 변전 구역 로켓단",
        "en_us": "East Transformer Team Rocket"
      },
      "npcs": [
        "cobbleventure:npc/rocket_power_plant_grunt_east"
      ],
      "opponents": [
        "cobbleventure:battle/rocket_power_plant_grunt"
      ],
      "requires": [],
      "run_state_keys": [
        "cobbleventure:flag/trainer/rocket_power_plant_grunt_east/defeated"
      ],
      "yaw": -90,
      "boss": false
    },
    {
      "id": "control_room_officer",
      "display_name": {
        "ko_kr": "제어실 로켓단 간부",
        "en_us": "Control Room Team Rocket Officer"
      },
      "npcs": [
        "cobbleventure:npc/rocket_power_plant_officer"
      ],
      "opponents": [
        "cobbleventure:battle/rocket_power_plant_officer"
      ],
      "requires": ["west_grunt", "east_grunt"],
      "run_state_keys": [
        "cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated"
      ],
      "yaw": 180,
      "boss": true
    }
  ],
  "random_encounters": {
    "enabled": true,
    "minimum_distance": 8,
    "maximum_distance": 16,
    "max_active": 2,
    "spawn_interval_ticks": 100,
    "spawn_bounds": {
      "min": [2, 1, 11],
      "max": [45, 1, 45]
    },
    "additions": [
      {
        "species": "cobblemon:magnemite",
        "min_level": 1,
        "max_level": 1,
        "weight": 35
      },
      {
        "species": "cobblemon:voltorb",
        "min_level": 1,
        "max_level": 1,
        "weight": 30
      },
      {
        "species": "cobblemon:grimer",
        "min_level": 1,
        "max_level": 1,
        "weight": 20
      },
      {
        "species": "cobblemon:koffing",
        "min_level": 1,
        "max_level": 1,
        "weight": 10
      },
      {
        "species": "cobblemon:electabuzz",
        "min_level": 1,
        "max_level": 1,
        "weight": 5
      }
    ]
  },
  "support": {
    "healing_stations": [
      {
        "id": "pre_control_room_station",
        "block": "minecraft:lodestone",
        "uses_per_run": 1,
        "restore_hp": true,
        "restore_status": true,
        "restore_pp": true
      }
    ]
  },
  "gates": [
    {
      "id": "control_room_lockdown",
      "placement": "marker",
      "min": [-2, 0, 0],
      "max": [3, 2, 0],
      "block": "minecraft:iron_bars",
      "requires": ["west_grunt", "east_grunt"]
    }
  ],
  "loot": {
    "loot_table": "cobbleventure:dungeon/rocket_power_plant_supplies",
    "ownership": "per_player",
    "on_failure": "grant_on_clear_only",
    "containers": [
      {
        "id": "west_maintenance_cache",
        "block": "barrel",
        "facing": "south",
        "requires_completion": false
      },
      {
        "id": "east_transformer_cache",
        "block": "chest",
        "facing": "west",
        "requires_completion": false
      },
      {
        "id": "control_room_cache",
        "block": "chest",
        "facing": "west",
        "requires_completion": true,
        "loot_table": "cobbleventure:dungeon/rocket_power_plant_control_room"
      }
    ]
  },
  "rewards": {
    "first_clear_table": "cobbleventure:dungeon/rocket_power_plant_first_clear",
    "repeat_table": "cobbleventure:dungeon/rocket_power_plant_repeat_clear",
    "first_clear_field_moves": ["flash"]
  },
  "lifecycle": {
    "on_wipe": "reset_run",
    "wipe_return": "source_entrance",
    "heal_on_wipe": true,
    "resume_mode": "full_reset",
    "reconnect_grace_seconds": 120
  },
  "completion": {
    "victory_flag": "cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated",
    "repeatable": true,
    "return_trigger": "clear_exit",
    "clear_exit_block": "minecraft:lodestone"
  }
}
