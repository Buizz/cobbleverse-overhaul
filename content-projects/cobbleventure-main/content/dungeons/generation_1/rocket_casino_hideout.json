{
  "$schema": "../../schemas/dungeon.schema.json",
  "schema_version": 1,
  "dungeon_id": "cobbleventure:dungeon/rocket_casino_hideout",
  "music_track": "dungeon.rocket_hideout",
  "display_name": { "ko_kr": "카지노 지하 로켓단 기지", "en_us": "Rocket Casino Hideout" },
  "description": { "ko_kr": "무지개시티 카지노 아래의 로켓단 비밀기지를 공략합니다.", "en_us": "Raid Team Rocket's hideout beneath the Celadon casino." },
  "preset": "cobbleventure:team_rocket_facility",
  "entrances": [{
    "entrance_id": "cobbleventure:entrance/casino_hideout",
    "destination_entry": "main", "activation": "proximity",
    "visibility": "always", "return_policy": "source_safe_anchor"
  }],
  "entry_ui": {
    "info_mode": "summary",
    "confirm_required": true,
    "background_texture": "cobbleventure_bootstrap:textures/gui/dungeons/rocket_facility.png"
  },
  "difficulty": { "recommended_min": 25, "recommended_max": 29, "internal_min": 24, "internal_max": 29 },
  "eligibility": {
    "minimum_party_size": 1, "maximum_party_size": 6,
    "require_usable_pokemon": true, "level_measure": "average",
    "recommended_level_policy": "warn"
  },
  "multiplayer": {
    "mode": "cooperative", "min_size": 2, "max_size": 2,
    "battle_join": "summon_all",
    "tether": { "warn_distance": 24, "max_distance": 40, "on_exceed": "return_to_partner" }
  },
  "match": { "required_players": 2, "scope": "same_entrance", "timeout_seconds": 300, "on_timeout": "keep_waiting", "stay_radius": 8 },
  "battle": { "allow_flee": false, "allow_capture": true, "allow_items": true, "allow_escape_actions": false },
  "plan": {
    "mode": "runtime", "seed_policy": "random_per_run",
    "fallback": "use_fallback_plan", "generation_timeout_ms": 1500,
    "max_attempts": 128
  },
  "terrain": {
    "mode": "nbt_pieces",
    "piece_pool": "cobbleventure:dungeon_pool/rocket_test",
    "bounds": [128, 48, 128]
  },
  "layout": {
    "mode": "rooms_and_corridors", "critical_path_rooms": [12, 13],
    "branch_count": [1, 2], "branch_depth": [1, 2], "loop_chance": 0.06,
    "vertical_direction": "descending", "floor_changes": [1, 2]
  },
  "topology": { "mode": "room_network", "critical_path_rooms": [12, 13], "branch_count": [1, 2], "branch_depth": [1, 2], "loop_chance": 0.06 },
  "vertical": { "mode": "discrete_floors", "direction": "descending", "floor_count": [2, 3], "floor_height": 8, "connections_per_floor": [1, 1] },
  "npc_placement": { "capacity_mode": "from_encounters", "minimum_spacing": 4, "maximum_per_room": 2 },
  "encounters": [
    {
      "id": "basement_guard", "display_name": { "ko_kr": "지하 창고 경비", "en_us": "Basement Guard" },
      "trainers": [{ "id": "basement_guard", "display_name": { "ko_kr": "카지노 지하 경비", "en_us": "Casino Basement Guard" }, "trainer_class": "cobbleventure:trainer_class/villain_grunt", "battle": "cobbleventure:battle/rocket_casino_guard" }],
      "requires": [],
      "trigger": {
        "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3,
        "warning_track": "encounter.trainer_bad_guys",
        "start_lines": ["침입자다!", "비밀기지에 들어온 걸 후회하게 해주지!"],
        "win_lines": ["내가 지다니..."],
        "loss_lines": ["로켓단의 기지를 얕보지 마라!"]
      },
      "yaw": -90, "boss": false
    },
    {
      "id": "storage_guard", "display_name": { "ko_kr": "지하 창고 로켓단", "en_us": "Storage Floor Grunt" },
      "trainers": [{ "id": "storage_guard", "display_name": { "ko_kr": "로켓단 조무래기", "en_us": "Team Rocket Grunt" }, "trainer_class": "cobbleventure:trainer_class/villain_grunt", "battle": "cobbleventure:battle/rocket_casino_guard_partner" }],
      "requires": ["basement_guard"],
      "trigger": {
        "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3,
        "warning_track": "encounter.trainer_bad_guys",
        "start_lines": ["더 아래로는 못 간다!"], "win_lines": ["경비를 뚫다니..."], "loss_lines": ["이곳은 로켓단의 구역이다!"]
      },
      "yaw": 90, "boss": false
    },
    {
      "id": "lift_guard", "display_name": { "ko_kr": "엘리베이터 경비 로켓단", "en_us": "Elevator Guard" },
      "trainers": [{ "id": "lift_guard", "display_name": { "ko_kr": "로켓단 조무래기", "en_us": "Team Rocket Grunt" }, "trainer_class": "cobbleventure:trainer_class/villain_grunt", "battle": "cobbleventure:battle/rocket_casino_guard" }],
      "requires": ["storage_guard"],
      "trigger": { "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3, "warning_track": "encounter.trainer_bad_guys", "start_lines": ["엘리베이터는 사용하게 둘 수 없다!"], "win_lines": ["열쇠를 지키지 못했군..."], "loss_lines": ["여기서 돌아가라!"] },
      "yaw": -90, "boss": false
    },
    {
      "id": "admin_guard", "display_name": { "ko_kr": "간부실 앞 호위", "en_us": "Admin Room Guard" },
      "trainers": [{ "id": "admin_guard", "display_name": { "ko_kr": "로켓단 호위", "en_us": "Team Rocket Guard" }, "trainer_class": "cobbleventure:trainer_class/villain_grunt", "battle": "cobbleventure:battle/rocket_casino_admin_guard" }],
      "requires": ["lift_guard"],
      "trigger": { "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3, "warning_track": "encounter.trainer_bad_guys", "start_lines": ["보스께는 접근할 수 없다!"], "win_lines": ["보스를 지켜야 하는데..."], "loss_lines": ["네 진격은 여기까지다!"] },
      "yaw": 180, "boss": false
    },
    {
      "id": "hideout_admin", "display_name": { "ko_kr": "로켓단 보스 비주기", "en_us": "Team Rocket Boss Giovanni" },
      "trainers": [{ "id": "hideout_admin", "display_name": { "ko_kr": "비주기", "en_us": "Giovanni" }, "trainer_class": "cobbleventure:trainer_class/villain_admin", "battle": "cobbleventure:battle/rocket_casino_admin" }],
      "requires": ["admin_guard"],
      "trigger": { "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3, "warning_track": "encounter.trainer_bad_guys", "start_lines": ["여기까지 온 실력은 인정하지. 하지만 이곳이 끝이다."], "win_lines": ["이번에는 물러나도록 하지."], "loss_lines": ["조직적인 전투가 무엇인지 이제 알겠나?"] },
      "yaw": 180, "boss": true
    }
  ],
  "random_encounters": {
    "enabled": false, "minimum_distance": 8, "maximum_distance": 16,
    "max_active": 1, "spawn_interval_ticks": 100,
    "spawn_bounds": { "min": [2, 1, 2], "max": [125, 45, 125] }, "additions": []
  },
  "support": { "healing_stations": [] },
  "gates": [],
  "loot": {
    "loot_table": "cobbleventure:dungeon/rocket_power_plant_supplies",
    "ownership": "per_player", "on_failure": "grant_on_clear_only",
    "containers": [{ "id": "hideout_vault", "block": "chest", "facing": "west", "requires_completion": true }]
  },
  "rewards": {
    "first_clear_table": "cobbleventure:dungeon/rocket_power_plant_first_clear",
    "repeat_table": "cobbleventure:dungeon/rocket_power_plant_repeat_clear", "first_clear_field_moves": []
  },
  "lifecycle": { "on_wipe": "reset_run", "wipe_return": "source_entrance", "heal_on_wipe": true, "reconnect_grace_seconds": 120 },
  "completion": {
    "victory_flag": "cobbleventure:flag/dungeon/rocket_casino_hideout/boss_defeated",
    "repeatable": true, "return_trigger": "clear_exit",
    "clear_exit_block": "minecraft:lodestone"
  }
}
