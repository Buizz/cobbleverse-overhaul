      { "battle_start_line": "침입자다!", "battle_end_line": "내가 지다니...", "weight": 2 },
      { "battle_start_line": "더 아래로는 못 간다!", "battle_end_line": "경비를 뚫다니...", "weight": 1 },
      { "battle_start_line": "엘리베이터는 사용하게 둘 수 없다!", "battle_end_line": "열쇠를 지키지 못했군...", "weight": 1 },
      { "battle_start_line": "보스께는 접근할 수 없다!", "battle_end_line": "보스를 지켜야 하는데...", "weight": 1 }
    ],
    "pokemon_pool": [
      { "species": "cobblemon:rattata", "weight": 2 }, { "species": "cobblemon:koffing", "weight": 2 },
      { "species": "cobblemon:zubat", "weight": 1 }, { "species": "cobblemon:ekans", "weight": 1 },
      { "species": "cobblemon:drowzee", "weight": 1 }
    ],
    "team_size": [1, 3], "allow_duplicates": false
