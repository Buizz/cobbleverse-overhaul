{
  "$schema": "../../schemas/dungeon.schema.json",
  "schema_version": 1,
  "dungeon_id": "cobbleventure:dungeon/rocket_casino_hideout",
  "display_name": { "ko_kr": "카지노 지하 로켓단 기지", "en_us": "Rocket Casino Hideout" },
  "description": { "ko_kr": "넓은 지하층을 차례로 내려가는 로켓단 비밀기지 테스트입니다.", "en_us": "A test hideout descending through broad underground floors." },
  "preset": "cobbleventure:team_rocket_facility",
  "entrances": [{
    "entrance_id": "cobbleventure:entrance/casino_hideout",
    "destination_entry": "main", "activation": "proximity",
    "visibility": "always", "return_policy": "source_safe_anchor"
  }],
  "entry_ui": {
    "info_mode": "summary",
    "confirm_required": true,
    "background_texture": "cobbleventure_bootstrap:textures/gui/dungeons/rocket_facility.png"
  },
  "difficulty": { "recommended_min": 1, "recommended_max": 1, "internal_min": 1, "internal_max": 1 },
  "eligibility": {
    "minimum_party_size": 1, "maximum_party_size": 6,
    "require_usable_pokemon": true, "level_measure": "average",
    "recommended_level_policy": "warn"
  },
  "multiplayer": {
    "mode": "cooperative", "min_size": 2, "max_size": 2,
    "battle_join": "summon_all",
    "tether": { "warn_distance": 24, "max_distance": 40, "on_exceed": "return_to_partner" }
  },
  "match": { "required_players": 2, "scope": "same_entrance", "timeout_seconds": 300, "on_timeout": "keep_waiting", "stay_radius": 8 },
  "battle": { "allow_flee": false, "allow_capture": true, "allow_items": true, "allow_escape_actions": false },
  "plan": {
    "mode": "runtime", "seed_policy": "random_per_run",
    "fallback": "use_fallback_plan", "generation_timeout_ms": 1500,
    "max_attempts": 128
  },
  "terrain": {
    "mode": "nbt_pieces",
    "piece_pool": "cobbleventure:dungeon_pool/rocket_test",
    "bounds": [128, 48, 128]
  },
  "layout": {
    "mode": "rooms_and_corridors", "critical_path_rooms": [12, 16],
    "branch_count": [4, 7], "branch_depth": [2, 4], "loop_chance": 0.1,
    "vertical_direction": "descending", "floor_changes": [2, 5]
  },
  "encounters": [
    {
      "id": "basement_guard", "display_name": { "ko_kr": "지하 창고 경비", "en_us": "Basement Guard" },
      "npcs": ["cobbleventure:npc/rocket_casino_guard", "cobbleventure:npc/rocket_casino_guard_partner"],
      "opponents": ["cobbleventure:battle/rocket_casino_guard", "cobbleventure:battle/rocket_casino_guard_partner"],
      "requires": [],
      "run_state_keys": [
        "cobbleventure:flag/trainer/rocket_casino_guard/defeated",
        "cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated"
      ],
      "yaw": -90, "boss": false
    },
    {
      "id": "hideout_admin", "display_name": { "ko_kr": "지하기지 관리자", "en_us": "Hideout Administrator" },
      "npcs": ["cobbleventure:npc/rocket_casino_admin", "cobbleventure:npc/rocket_casino_admin_guard"],
      "opponents": ["cobbleventure:battle/rocket_casino_admin", "cobbleventure:battle/rocket_casino_admin_guard"],
      "requires": ["basement_guard"],
      "run_state_keys": [
        "cobbleventure:flag/trainer/rocket_casino_admin/defeated",
        "cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated"
      ],
      "yaw": 180, "boss": true
    }
  ],
  "random_encounters": {
    "enabled": false, "minimum_distance": 8, "maximum_distance": 16,
    "max_active": 1, "spawn_interval_ticks": 100,
    "spawn_bounds": { "min": [2, 1, 2], "max": [45, 17, 45] }, "additions": []
  },
  "support": { "healing_stations": [] },
  "gates": [],
  "loot": {
    "loot_table": "cobbleventure:dungeon/rocket_power_plant_supplies",
    "ownership": "per_player", "on_failure": "grant_on_clear_only",
    "containers": [{ "id": "hideout_vault", "block": "chest", "facing": "west", "requires_completion": true }]
  },
  "rewards": {
    "first_clear_table": "cobbleventure:dungeon/rocket_power_plant_first_clear",
    "repeat_table": "cobbleventure:dungeon/rocket_power_plant_repeat_clear", "first_clear_field_moves": []
  },
  "lifecycle": { "on_wipe": "reset_run", "wipe_return": "source_entrance", "heal_on_wipe": true, "reconnect_grace_seconds": 120 },
  "completion": {
    "victory_flag": "cobbleventure:flag/dungeon/rocket_casino_hideout/boss_defeated",
    "repeatable": true, "return_trigger": "clear_exit",
    "clear_exit_block": "minecraft:lodestone"
  }
}
