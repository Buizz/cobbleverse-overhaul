    "dialogue_pool": [
      { "battle_start_line": "추모하러 온 녀석인가? 여기서 돌아가라!", "battle_end_line": "이 층을 지키지 못하다니...", "weight": 1 },
      { "battle_start_line": "이 위층은 우리 로켓단이 점거했다!", "battle_end_line": "동료들에게 알려야 하는데...", "weight": 1 },
      { "battle_start_line": "아래층 경비를 쓰러뜨렸다고 끝난 줄 알았나?", "battle_end_line": "상층까지 올라오다니...", "weight": 1 },
      { "battle_start_line": "간부님께는 한 발짝도 접근할 수 없다!", "battle_end_line": "간부님을 지켜야 하는데...", "weight": 1 }
    ],
    "pokemon_pool": [
      { "species": "cobblemon:rattata", "weight": 2 }, { "species": "cobblemon:zubat", "weight": 2 },
      { "species": "cobblemon:golbat", "weight": 1 }
