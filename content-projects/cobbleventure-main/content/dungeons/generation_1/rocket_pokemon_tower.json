      "requires": [],
      "trigger": { "type": "proximity", "leader": 0, "range": 6, "warning_offset": 3, "warning_track": "encounter.trainer_bad_guys", "start_lines": ["여기까지 올라온 집념만큼은 인정하지."], "win_lines": ["포켓몬타워에서 철수하겠다..."], "loss_lines": ["로켓단의 계획은 누구도 막을 수 없다!"] },
      "yaw": 180, "boss": true
    }
  ],
