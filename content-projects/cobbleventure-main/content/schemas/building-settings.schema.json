{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/building-settings.schema.json",
  "title": "Cobbleventure building settings",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "buildings"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "buildings": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fixed_npcs", "citizen_placement_allowed", "interiors", "door_routes"],
        "properties": {
          "placement_y_offset": { "type": "integer", "minimum": -64, "maximum": 64 },
          "fixed_npcs": {
            "type": "object",
            "propertyNames": { "pattern": "^(?:[a-z0-9][a-z0-9_]*:)?[a-z0-9][a-z0-9_]*$" },
            "additionalProperties": { "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" }
          },
          "citizen_placement_allowed": { "type": "boolean" },
          "interiors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["key", "structure"],
              "properties": {
                "key": { "pattern": "^[a-z0-9][a-z0-9_]*$" },
                "structure": { "pattern": "^[a-z0-9_.-]+:interiors/[a-z0-9_./-]+$" }
              }
            }
          },
          "door_routes": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_]*:[a-z0-9][a-z0-9_]*$" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": ["space", "door"],
              "properties": {
                "space": { "pattern": "^[a-z0-9][a-z0-9_]*$" },
                "door": { "pattern": "^[a-z0-9][a-z0-9_]*$" },
                "condition_mode": { "enum": ["all", "any"] },
                "conditions": { "type": "array", "items": { "type": "object" } },
                "locked_dialogue": { "type": "array", "items": { "type": "string" } },
                "enter_dialogue": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    }
  }
}
