{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/building-settings.schema.json",
  "title": "Cobbleventure building settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "buildings"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 1
    },
    "facility_defaults": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pokemon_center": {
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "pokemart": {
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        },
        "department_store": {
          "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
        }
      }
    },
    "buildings": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
      },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fixed_npcs",
          "citizen_placement_allowed",
          "interiors",
          "door_routes"
        ],
        "properties": {
          "placement_y_offset": {
            "type": "integer",
            "minimum": -64,
            "maximum": 64
          },
          "structure_category": {
            "enum": [
              "building",
              "residential",
              "gym_exterior",
              "gym_interior",
              "interior",
              "league",
              "placeholder",
              "decoration",
              "natural_feature"
            ]
          },
          "music_track": {
            "type": "string",
            "pattern": "^[a-z0-9_.-]+$"
          },
          "no_interior_space": {
            "type": "boolean"
          },
          "town_placement": {
            "type": "object",
            "additionalProperties": false,
            "required": ["enabled", "id", "label", "note", "color"],
            "properties": {
              "enabled": { "type": "boolean" },
              "id": { "pattern": "^[a-z0-9_.-]+$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 32 },
              "note": { "type": "string", "maxLength": 96 },
              "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
            }
          },
          "fixed_npcs": {
            "type": "object",
            "propertyNames": {
              "pattern": "^(?:[a-z0-9][a-z0-9_]*:)?[a-z0-9][a-z0-9_]*$"
            },
            "additionalProperties": {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            }
          },
          "fixed_pokemon": {
            "type": "object",
            "description": "npc_position 앵커에 배치할 Cobblemon PokemonProperties 문자열",
            "propertyNames": {
              "pattern": "^(?:[a-z0-9][a-z0-9_]*:)?[a-z0-9][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "string",
              "minLength": 1
            }
          },
          "fixed_vendors": {
            "type": "object",
            "description": "npc_position 앵커에 배치할 상점 판매원 ID",
            "propertyNames": {
              "pattern": "^(?:[a-z0-9][a-z0-9_]*:)?[a-z0-9][a-z0-9_]*$"
            },
            "additionalProperties": {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            }
          },
          "citizen_placement_allowed": {
            "type": "boolean"
          },
          "interiors": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "key",
                "structure"
              ],
              "properties": {
                "key": {
                  "pattern": "^[a-z0-9][a-z0-9_]*$"
                },
                "structure": {
                  "pattern": "^[a-z0-9_.-]+:interiors/[a-z0-9_./-]+$"
                }
              }
            }
          },
          "door_routes": {
            "type": "object",
            "description": "건물 문 또는 배리어 접촉 전환 영역 사이의 이동 연결",
            "propertyNames": {
              "pattern": "^[a-z0-9][a-z0-9_]*:[a-z0-9][a-z0-9_]*$"
            },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "space",
                "door"
              ],
              "properties": {
                "space": {
                  "pattern": "^[a-z0-9][a-z0-9_]*$"
                },
                "door": {
                  "description": "목적지 공간의 door 또는 transition 앵커 라벨",
                  "pattern": "^[a-z0-9][a-z0-9_]*$"
                },
                "condition_mode": {
                  "$ref": "player-condition.schema.json#/$defs/mode"
                },
                "conditions": {
                  "$ref": "player-condition.schema.json#/$defs/condition_list"
                },
                "locked_dialogue": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "enter_dialogue": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              }
            }
          },
          "fixed_gacha_machines": {
            "type": "object",
            "description": "npc_position 앵커에 배치할 Cobbleventure 가챠 기계 프로필 ID",
            "propertyNames": {
              "pattern": "^(?:[a-z0-9][a-z0-9_]*:)?[a-z0-9][a-z0-9_]*$"
            },
            "additionalProperties": {
              "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
            }
          }
        }
      }
    }
  }
}
