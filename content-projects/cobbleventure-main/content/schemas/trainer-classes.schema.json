{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/trainer-classes.schema.json",
  "title": "Cobbleventure trainer class catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "display_name", "title_pattern", "body", "default_appearance", "tags"],
        "properties": {
          "id": { "$ref": "#/$defs/resource_id" },
          "category": {
            "enum": ["children", "outdoor", "specialist", "occupation", "social", "advanced", "boss", "custom"]
          },
          "display_name": { "$ref": "#/$defs/localized_text" },
          "title_pattern": { "$ref": "#/$defs/localized_text" },
          "body": {
            "type": "object",
            "additionalProperties": false,
            "required": ["age_group", "height_scale", "arm_model"],
            "properties": {
              "age_group": { "enum": ["child", "teen", "adult"] },
              "height_scale": { "type": "number", "minimum": 0.5, "maximum": 1.25 },
              "arm_model": { "enum": ["classic", "slim"] }
            }
          },
          "default_appearance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "type", "resource", "implementation_status"],
            "properties": {
              "source": { "enum": ["custom", "rct_single", "rct_group"] },
              "type": { "enum": ["skin", "model"] },
              "resource": { "$ref": "#/$defs/resource_id" },
              "portrait": { "$ref": "#/$defs/resource_id" },
              "implementation_status": { "enum": ["ready", "placeholder"] }
            }
          },
          "appearance_options": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source", "type", "resource", "implementation_status"],
              "properties": {
                "source": { "enum": ["custom", "rct_single", "rct_group"] },
                "type": { "enum": ["skin", "model"] },
                "resource": { "$ref": "#/$defs/resource_id" },
                "portrait": { "$ref": "#/$defs/resource_id" },
                "implementation_status": { "enum": ["ready", "placeholder"] }
              }
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "required": ["ko_kr"],
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
