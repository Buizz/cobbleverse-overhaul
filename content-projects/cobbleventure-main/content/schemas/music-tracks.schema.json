{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/music-tracks.schema.json",
  "title": "Cobbleventure music track catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "datapack_required",
    "source",
    "music_notification",
    "defaults",
    "tracks",
    "review_candidates"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "namespace": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "datapack_required": { "const": false },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "audio_tracked_by_git", "local_directory", "notes"],
      "properties": {
        "label": { "type": "string", "minLength": 1 },
        "audio_tracked_by_git": { "const": false },
        "local_directory": {
          "type": "string",
          "pattern": "^local-assets/music/[a-z0-9_.-]+$"
        },
        "notes": { "type": "string", "minLength": 1 }
      }
    },
    "music_notification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "album", "author"],
      "properties": {
        "enabled": { "const": true },
        "album": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 }
      }
    },
    "defaults": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tile", "road", "settlement", "building", "pokemon_center", "pokemart", "battle", "gym"],
      "properties": {
        "tile": { "$ref": "#/$defs/trackId" },
        "road": { "$ref": "#/$defs/trackId" },
        "settlement": { "$ref": "#/$defs/trackId" },
        "building": { "$ref": "#/$defs/trackId" },
        "pokemon_center": { "$ref": "#/$defs/trackId" },
        "pokemart": { "$ref": "#/$defs/trackId" },
        "battle": { "$ref": "#/$defs/trackId" },
        "gym": { "$ref": "#/$defs/trackId" }
      }
    },
    "tracks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/track" }
    },
    "review_candidates": {
      "type": "array",
      "items": { "$ref": "#/$defs/reviewCandidate" }
    }
  },
  "$defs": {
    "trackId": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "track": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "sound_event",
        "resource",
        "source_file",
        "category",
        "usage"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "sound_event": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "resource": {
          "type": "string",
          "pattern": "^[a-z0-9_./-]+$"
        },
        "source_file": { "type": "string", "pattern": "(?i)\\.ogg$" },
        "category": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "usage": { "type": "string", "minLength": 1 }
      }
    },
    "reviewCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_file", "reason"],
      "properties": {
        "source_file": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    }
  }
}
