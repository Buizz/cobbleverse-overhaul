{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/npc-event-script.schema.json",
  "title": "Cobbleventure NPC event script",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "enabled", "name", "tags", "npc", "event_design"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 4 },
    "id": { "type": "string", "pattern": "^[a-z0-9_.-]+:npc/[a-z0-9_./-]+$" },
    "enabled": { "type": "boolean" },
    "name": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
    "description": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
    "placement_profile": { "$ref": "content-bundle.schema.json#/$defs/placement_profile" },
    "tags": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "npc": { "$ref": "content-bundle.schema.json#/$defs/npc" },
    "event_runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["engine"],
      "properties": {
        "engine": { "enum": ["easy_npc_v4", "cves_v5"] },
        "authoring": { "enum": ["preset", "custom"] },
        "script_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:event_script/[a-z0-9_./-]+$"
        }
      },
      "allOf": [
        {
          "if": { "properties": { "engine": { "const": "cves_v5" } } },
          "then": { "required": ["authoring", "script_id"] }
        }
      ]
    },
    "event_design": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preset"],
          "properties": {
            "mode": { "const": "preset" },
            "preset": { "$ref": "#/$defs/eventPreset" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "const": "easy_npc_events" }
          }
        }
      ]
    },
    "events": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "trigger", "commands"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "trigger": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "range"],
                "properties": {
                  "type": { "const": "interact" },
                  "range": { "type": "number", "exclusiveMinimum": 0, "default": 4 }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "range"],
                "properties": {
                  "type": { "const": "proximity" },
                  "range": { "type": "number", "exclusiveMinimum": 0, "default": 4 },
                  "warning_offset": { "type": "number", "minimum": 0, "default": 2 },
                  "indicator": { "enum": ["trainer_nearby"] }
                }
              }
            ]
          },
          "commands": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/command" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "event_design": {
            "properties": { "mode": { "const": "easy_npc_events" } },
            "required": ["mode"]
          }
        }
      },
      "then": { "required": ["events"] }
    }
  ],
  "$defs": {
    "eventTrigger": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "range"],
          "properties": {
            "type": { "const": "interact" },
            "range": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "range"],
          "properties": {
            "type": { "const": "proximity" },
            "range": { "type": "number", "exclusiveMinimum": 0 },
            "warning_offset": { "type": "number", "minimum": 0 },
            "indicator": { "enum": ["trainer_nearby"] }
          }
        }
      ]
    },
    "eventPreset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "initial_trigger", "first_text"],
      "allOf": [
        {
          "if": { "properties": { "type": { "enum": ["battle", "gym", "elite", "champion"] } } },
          "then": { "required": ["battle", "after_victory_trigger", "win_text", "loss_text"] }
        }
      ],
      "properties": {
        "type": { "enum": ["simple", "repeat", "item", "battle", "gym", "elite", "champion"] },
        "initial_trigger": { "$ref": "#/$defs/eventTrigger" },
        "after_victory_trigger": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "range"],
          "properties": {
            "type": { "const": "interact" },
            "range": { "type": "number", "exclusiveMinimum": 0 }
          }
        },
        "first_text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "repeat_text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "win_text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "loss_text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "auto_state_key": { "type": "boolean", "default": true },
        "state_key": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "victory_state_key": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "item": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "item_count": { "type": "integer", "minimum": 1 },
        "after_item_text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "battle": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "clear_key": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "badge": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "win_item": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "win_item_count": { "type": "integer", "minimum": 1 },
        "loss_money": { "type": "integer", "minimum": 0 },
        "currency_objective": { "type": "string", "minLength": 1 }
      }
    },
    "condition": { "$ref": "player-condition.schema.json#/$defs/condition" },
    "command": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "branch", "label", "dialogue", "choices", "goto", "start_battle",
            "set_flag", "mark_clear", "give_money", "take_money", "give_item", "grant_loot", "grant_badge", "grant_field_move",
            "start_starter_roulette", "teleport_to_gate", "unlock_feature", "set_level_cap", "end"
          ]
        },
        "conditions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/condition" } },
        "target": { "type": "string" },
        "name": { "type": "string" },
        "id": { "type": "string" },
        "speaker": { "enum": ["npc", "player", "system"] },
        "text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "text", "target"],
            "properties": {
              "id": { "type": "string" },
              "text": { "$ref": "content-bundle.schema.json#/$defs/localized_text" },
              "target": { "type": "string" }
            }
          }
        },
        "battle": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "results": {
          "type": "object",
          "properties": {
            "player_win": { "type": "string" },
            "player_loss": { "type": "string" },
            "cancelled": { "type": "string" }
          }
        },
        "key": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "value": { "type": ["string", "number", "boolean"] },
        "mode": { "enum": ["fixed", "level_cap_multiplier"] },
        "amount": { "type": "integer", "minimum": 0 },
        "multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "currency_objective": { "type": "string" },
        "level_cap_objective": { "type": "string" },
        "item": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1 },
        "loot_table": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "badge": { "$ref": "content-bundle.schema.json#/$defs/resource_id" },
        "move": {
          "enum": ["surf", "fly", "flash", "defog", "rock_climb", "whirlpool", "strength", "rock_smash"]
        },
        "gate": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "feature": { "enum": ["map", "settlement_teleport", "pc"] },
        "level_cap": { "type": "integer", "minimum": 1, "maximum": 100 },
        "subject": { "enum": ["player", "npc"] },
        "side": { "enum": ["front", "back", "center"] }
      }
    }
  }
}
