{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/league-progression.schema.json",
  "title": "Cobbleventure league progression catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entries"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "entries": {
      "type": "array",
      "items": { "$ref": "#/$defs/entry" }
    }
  },
  "$defs": {
    "resource_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "localized_text": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "required": ["ko_kr"],
      "properties": { "ko_kr": { "type": "string", "minLength": 1 }, "en_us": { "type": "string", "minLength": 1 } }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "display_name", "generation", "region", "order", "level_cap", "primary_type"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "role": { "enum": ["gym_leader", "elite_four", "champion"] },
        "primary_type": { "enum": ["normal", "fire", "water", "electric", "grass", "ice", "fighting", "poison", "ground", "flying", "psychic", "bug", "rock", "ghost", "dragon", "dark", "steel", "fairy"] },
        "badge_id": { "$ref": "#/$defs/resource_id" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9 },
        "region": { "$ref": "#/$defs/resource_id" },
        "order": { "type": "integer", "minimum": 1, "maximum": 99 },
        "trainer_card_order": { "type": "integer", "minimum": 1, "maximum": 99 },
        "trainer_card_visible": { "type": "boolean" },
        "level_cap": {
          "type": "integer", "minimum": 1, "maximum": 100,
          "description": "이 관장에게 도전하기 전에 적용되는 레벨캡"
        },
        "trainer_id": { "$ref": "#/$defs/resource_id" },
        "encounter": {
          "type": "object",
          "additionalProperties": false,
          "required": ["battle_id", "appearance", "dialogue", "rewards"],
          "properties": {
            "battle_id": { "$ref": "#/$defs/resource_id" },
            "character": { "$ref": "#/$defs/resource_id" },
            "appearance": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "type", "resource"],
              "properties": {
                "source": { "type": "string", "minLength": 1 },
                "type": { "type": "string", "minLength": 1 },
                "resource": { "$ref": "#/$defs/resource_id" },
                "texture": { "$ref": "#/$defs/resource_id" },
                "arm_model": { "enum": ["wide", "slim", "classic"] }
              }
            },
            "dialogue": {
              "type": "object", "additionalProperties": false,
              "required": ["challenge", "victory", "defeat", "cleared"],
              "properties": {
                "challenge": { "$ref": "#/$defs/dialogue_lines" },
                "victory": { "$ref": "#/$defs/dialogue_lines" },
                "defeat": { "$ref": "#/$defs/dialogue_lines" },
                "cleared": { "$ref": "#/$defs/dialogue_lines" }
              }
            },
            "rewards": {
              "type": "object", "additionalProperties": false,
              "required": ["money", "badge_id"],
              "properties": {
                "money": { "type": "integer", "minimum": 0 },
                "item": { "$ref": "#/$defs/resource_id" },
                "item_count": { "type": "integer", "minimum": 1, "maximum": 999 },
                "badge_id": { "$ref": "#/$defs/resource_id" }
              }
            }
          }
        }
      },
      "allOf": [{
        "if": { "properties": { "role": { "const": "gym_leader" } } },
        "then": { "required": ["encounter"] },
        "else": { "required": ["trainer_id"] }
      }]
    },
    "dialogue_lines": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      ]
    }
  }
}
