{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/gacha-machines.schema.json",
  "title": "Cobbleventure Gacha Machines",
  "type": "object",
  "required": [
    "schema_version",
    "tickets",
    "reward_catalog",
    "casino_sets",
    "machines"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 4
    },
    "tickets": {
      "type": "object",
      "required": [
        "pokemon",
        "item",
        "technical_machine"
      ],
      "properties": {
        "pokemon": {
          "$ref": "#/$defs/ticket"
        },
        "item": {
          "$ref": "#/$defs/ticket"
        },
        "technical_machine": {
          "$ref": "#/$defs/ticket"
        }
      },
      "additionalProperties": false
    },
    "casino_sets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/casino_set"
      }
    },
    "machines": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/machine"
      }
    },
    "reward_catalog": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/reward_template"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "resource": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "machine": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "machine_type",
        "enabled",
        "pity_group",
        "appearance",
        "rarities",
        "pity"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resource"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "machine_type": {
          "enum": [
            "pokemon",
            "item",
            "technical_machine"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "pity_group": {
          "type": "string",
          "minLength": 1
        },
        "appearance": {
          "type": "object",
          "required": [
            "model_block",
            "facing",
            "show_nameplate"
          ],
          "properties": {
            "model_block": {
              "$ref": "#/$defs/resource"
            },
            "facing": {
              "enum": ["north", "east", "south", "west"]
            },
            "show_nameplate": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "rarities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/rarity"
          }
        },
        "pity": {
          "$ref": "#/$defs/pity"
        }
      },
      "additionalProperties": false
    },
    "rarity": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "weight",
        "rewards"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rewards": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/reward"
          }
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "required": [
        "catalog_id",
        "weight",
        "selectable"
      ],
      "properties": {
        "catalog_id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "weight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "selectable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "pity": {
      "type": "object",
      "required": [
        "soft",
        "hard",
        "selection"
      ],
      "properties": {
        "soft": {
          "type": "object",
          "required": [
            "enabled",
            "start",
            "max_at",
            "target_rarity",
            "max_chance"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "start": {
              "type": "integer",
              "minimum": 1
            },
            "max_at": {
              "type": "integer",
              "minimum": 1
            },
            "target_rarity": {
              "type": "string"
            },
            "max_chance": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 1
            }
          },
          "additionalProperties": false
        },
        "hard": {
          "type": "object",
          "required": [
            "enabled",
            "count",
            "target_rarity"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "count": {
              "type": "integer",
              "minimum": 1
            },
            "target_rarity": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "required": [
            "enabled",
            "points_per_pull",
            "required_points"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "points_per_pull": {
              "type": "integer",
              "minimum": 1
            },
            "required_points": {
              "type": "integer",
              "minimum": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "ticket": {
      "type": "object",
      "required": [
        "display_name",
        "price",
        "purchase_min",
        "purchase_max"
      ],
      "properties": {
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "price": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2147483647
        },
        "purchase_min": {
          "type": "integer",
          "minimum": 1
        },
        "purchase_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6400
        }
      },
      "additionalProperties": false
    },
    "casino_set": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "machines"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/resource"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "machines": {
          "type": "object",
          "required": [
            "pokemon",
            "item",
            "technical_machine"
          ],
          "properties": {
            "pokemon": {
              "$ref": "#/$defs/resource"
            },
            "item": {
              "$ref": "#/$defs/resource"
            },
            "technical_machine": {
              "$ref": "#/$defs/resource"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "reward_template": {
      "type": "object",
      "required": [
        "id",
        "display_name",
        "machine_type",
        "kind",
        "value",
        "count"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+$"
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        },
        "machine_type": {
          "enum": [
            "pokemon",
            "item",
            "technical_machine"
          ]
        },
        "kind": {
          "enum": [
            "item",
            "pokemon"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
