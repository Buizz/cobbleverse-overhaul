{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.dev/schemas/underground-road.schema.json",
  "title": "Cobbleventure Modular Underground Passage",
  "type": "object",
  "required": ["schema_version", "id", "enabled", "display_name", "dimension", "modules", "ports"],
  "properties": {
    "schema_version": { "const": 2 },
    "id": { "type": "string", "pattern": "^cobbleventure:underground_road/[a-z0-9_./-]+$" },
    "enabled": { "type": "boolean" },
    "display_name": { "$ref": "#/$defs/localizedText" },
    "dimension": {
      "type": "object",
      "required": ["id", "region_id", "origin"],
      "properties": {
        "id": { "const": "cobbleventure:dungeons" },
        "region_id": { "type": "string", "pattern": "^generation_[1-9]/[a-z0-9_.-]+$" },
        "origin": { "$ref": "#/$defs/position" }
      },
      "additionalProperties": false
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "structure", "position", "rotation"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "structure": { "type": "string", "pattern": "^cobbleventure:underground_road_modules/[a-z0-9_./-]+$" },
          "position": { "$ref": "#/$defs/position" },
          "rotation": { "enum": ["none", "clockwise_90", "clockwise_180", "counterclockwise_90"] }
        },
        "additionalProperties": false
      }
    },
    "ports": {
      "type": "object",
      "minProperties": 2,
      "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
      "additionalProperties": {
        "type": "object",
        "required": ["display_name", "module", "connector"],
        "properties": {
          "display_name": { "type": "string", "minLength": 1 },
          "module": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "connector": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        },
        "additionalProperties": false
      }
    },
    "music_track": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
  },
  "$defs": {
    "localizedText": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "position": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
