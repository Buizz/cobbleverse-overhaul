{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/forest.schema.json",
  "title": "Cobbleventure 2D forest definition",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "enabled", "display_name", "generation", "dimension", "environment", "tree_barrier", "undergrowth", "generator", "paths", "terrain_tiles", "entrances"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/resource_id" },
    "enabled": { "type": "boolean" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 9 },
    "dimension": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "region_id", "origin", "bounds"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "region_id": { "type": "string", "pattern": "^[a-z0-9_./-]+$" },
        "origin": { "$ref": "#/$defs/block_position" },
        "bounds": { "$ref": "#/$defs/bounds" }
      }
    },
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["fixed_time", "weather"],
      "properties": {
        "fixed_time": { "type": "integer", "minimum": 0, "maximum": 23999 },
        "weather": { "enum": ["clear", "rain", "thunder"] }
      }
    },
    "tree_barrier": {
      "type": "object", "additionalProperties": false,
      "required": ["min_height", "max_height", "trunk_blocks", "foliage_blocks", "barrier_block"],
      "properties": {
        "min_height": { "type": "integer", "minimum": 2, "maximum": 64 },
        "max_height": { "type": "integer", "minimum": 2, "maximum": 64 },
        "trunk_blocks": { "$ref": "#/$defs/block_list" },
        "foliage_blocks": { "$ref": "#/$defs/block_list" },
        "barrier_block": { "$ref": "#/$defs/resource_id" }
      }
    },
    "undergrowth": {
      "type": "object", "additionalProperties": false,
      "required": ["density", "blocks", "path_clearance"],
      "properties": {
        "density": { "type": "number", "minimum": 0, "maximum": 1 },
        "blocks": { "$ref": "#/$defs/block_list" },
        "path_clearance": { "type": "integer", "minimum": 0, "maximum": 16 }
      }
    },
    "generator": {
      "type": "object", "additionalProperties": false,
      "required": ["layout", "seed_salt", "cell_size", "maze_complexity", "loop_chance", "spline_enabled", "spline_tension"],
      "properties": {
        "layout": { "enum": ["maze", "manual", "hybrid"] },
        "seed_salt": { "type": "integer" },
        "cell_size": { "type": "integer", "minimum": 4, "maximum": 64 },
        "maze_complexity": { "type": "number", "minimum": 0, "maximum": 1 },
        "loop_chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "spline_enabled": { "type": "boolean" },
        "spline_tension": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "paths": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/path" } },
    "terrain_tiles": { "type": "array", "items": { "$ref": "#/$defs/terrain_tile" } },
    "entrances": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entrance" } }
  },
  "$defs": {
    "resource_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "localized_text": { "type": "object", "minProperties": 1, "properties": { "ko_kr": { "type": "string", "minLength": 1 }, "en_us": { "type": "string", "minLength": 1 } }, "additionalProperties": { "type": "string", "minLength": 1 } },
    "block_position": { "type": "object", "additionalProperties": false, "required": ["x", "y", "z"], "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "z": { "type": "integer" } } },
    "point": { "type": "object", "additionalProperties": false, "required": ["x", "z"], "properties": { "x": { "type": "integer" }, "z": { "type": "integer" } } },
    "bounds": { "type": "object", "additionalProperties": false, "required": ["min_x", "min_z", "max_x", "max_z"], "properties": { "min_x": { "type": "integer" }, "min_z": { "type": "integer" }, "max_x": { "type": "integer" }, "max_z": { "type": "integer" } } },
    "block_list": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } },
    "path": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "width", "surface", "points", "spline"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "width": { "type": "integer", "minimum": 2, "maximum": 32 },
        "surface": { "$ref": "#/$defs/resource_id" },
        "points": { "type": "array", "minItems": 2, "items": { "$ref": "#/$defs/point" } },
        "spline": { "type": "object", "additionalProperties": false, "required": ["enabled", "tension"], "properties": { "enabled": { "type": "boolean" }, "tension": { "type": "number", "minimum": 0, "maximum": 1 } } }
      }
    },
    "terrain_tile": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "z", "height_offset"],
      "properties": {
        "x": { "type": "integer" }, "z": { "type": "integer" },
        "height_offset": { "type": "integer", "minimum": -16, "maximum": 16 }
      }
    },
    "entrance": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "display_name", "position"],
      "properties": { "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }, "display_name": { "type": "string", "minLength": 1 }, "position": { "$ref": "#/$defs/point" }, "required_progress": { "$ref": "#/$defs/resource_id" } }
    }
  }
}
