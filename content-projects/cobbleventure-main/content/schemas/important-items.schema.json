{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/important-items.schema.json",
  "title": "Cobbleventure Important Items",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "items"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item", "acquisition_flag", "minimum_count"],
        "properties": {
          "item": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
          "acquisition_flag": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
          "minimum_count": { "type": "integer", "minimum": 1, "maximum": 64 }
        }
      }
    }
  }
}
