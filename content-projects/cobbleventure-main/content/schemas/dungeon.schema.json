{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/dungeon.schema.json",
  "title": "Cobbleventure dungeon definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "dungeon_id", "display_name", "description",
    "preset", "entrances", "entry_ui", "difficulty", "eligibility", "multiplayer", "match", "battle", "terrain", "encounters",
    "random_encounters", "support", "gates", "loot", "rewards", "lifecycle", "completion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "dungeon_id": { "$ref": "#/$defs/resource_id" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "description": { "$ref": "#/$defs/localized_text" },
    "preset": { "$ref": "#/$defs/resource_id" },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrance" }
    },
    "entry_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info_mode", "confirm_required"],
      "properties": {
        "info_mode": { "enum": ["exact", "summary", "mystery"] },
        "confirm_required": { "type": "boolean" }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_min", "recommended_max", "internal_min", "internal_max"],
      "properties": {
        "recommended_min": { "$ref": "#/$defs/level" },
        "recommended_max": { "$ref": "#/$defs/level" },
        "internal_min": { "$ref": "#/$defs/level" },
        "internal_max": { "$ref": "#/$defs/level" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_party_size", "maximum_party_size", "require_usable_pokemon",
        "level_measure", "recommended_level_policy"
      ],
      "properties": {
        "minimum_party_size": { "type": "integer", "minimum": 1, "maximum": 6 },
        "maximum_party_size": { "type": "integer", "minimum": 1, "maximum": 6 },
        "require_usable_pokemon": { "type": "boolean" },
        "level_measure": { "enum": ["average", "highest"] },
        "recommended_level_policy": { "enum": ["ignore", "warn", "enforce"] }
      }
    },
    "multiplayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min_size", "max_size"],
      "properties": {
        "mode": { "enum": ["solo", "cooperative", "independent"] },
        "min_size": { "type": "integer", "minimum": 1, "maximum": 4 },
        "max_size": { "type": "integer", "minimum": 1, "maximum": 4 },
        "battle_join": {
          "enum": ["summon_all", "require_nearby", "initiator_only"]
        },
        "tether": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warn_distance", "max_distance", "on_exceed"],
          "properties": {
            "warn_distance": { "type": "integer", "minimum": 1, "maximum": 255 },
            "max_distance": { "type": "integer", "minimum": 2, "maximum": 256 },
            "on_exceed": { "const": "return_to_partner" }
          }
        }
      },
      "allOf": [{
        "if": {
          "properties": { "mode": { "const": "cooperative" } },
          "required": ["mode"]
        },
        "then": { "required": ["battle_join", "tether"] }
      }]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_players", "scope", "timeout_seconds", "on_timeout", "stay_radius"
      ],
      "properties": {
        "required_players": { "type": "integer", "minimum": 1, "maximum": 4 },
        "scope": { "const": "same_entrance" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "on_timeout": { "enum": ["cancel", "keep_waiting"] },
        "stay_radius": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "battle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_flee", "allow_capture", "allow_items", "allow_escape_actions"
      ],
      "properties": {
        "allow_flee": { "type": "boolean" },
        "allow_capture": { "type": "boolean" },
        "allow_items": { "type": "boolean" },
        "allow_escape_actions": { "type": "boolean" }
      }
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed_template", "nbt_pieces", "procedural_cave", "hybrid"] },
        "template": { "$ref": "#/$defs/resource_id" },
        "entry_position": { "$ref": "#/$defs/block_position" },
        "exit_position": { "$ref": "#/$defs/block_position" }
      },
      "allOf": [{
        "if": { "properties": { "mode": { "const": "fixed_template" } }, "required": ["mode"] },
        "then": { "required": ["template", "entry_position", "exit_position"] }
      }]
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/encounter" }
    },
    "random_encounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "minimum_distance", "maximum_distance", "max_active",
        "spawn_interval_ticks", "spawn_bounds", "additions"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minimum_distance": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maximum_distance": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_active": { "type": "integer", "minimum": 1, "maximum": 16 },
        "spawn_interval_ticks": { "type": "integer", "minimum": 20, "maximum": 12000 },
        "spawn_bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "$ref": "#/$defs/block_position" },
            "max": { "$ref": "#/$defs/block_position" }
          }
        },
        "additions": {
          "type": "array",
          "items": { "$ref": "#/$defs/wild_species" }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healing_stations"],
      "properties": {
        "healing_stations": {
          "type": "array",
          "items": { "$ref": "#/$defs/healing_station" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loot_table", "ownership", "on_failure", "containers"],
      "properties": {
        "loot_table": { "$ref": "#/$defs/resource_id" },
        "ownership": { "enum": ["per_player", "run_shared", "first_claim"] },
        "on_failure": {
          "enum": ["keep_collected", "remove_run_loot", "grant_on_clear_only"]
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/loot_container" }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_clear_table", "first_clear_field_moves"],
      "properties": {
        "first_clear_table": { "$ref": "#/$defs/resource_id" },
        "repeat_table": { "$ref": "#/$defs/resource_id" },
        "first_clear_field_moves": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_wipe", "wipe_return", "heal_on_wipe", "reconnect_grace_seconds"
      ],
      "properties": {
        "on_wipe": { "const": "reset_run" },
        "wipe_return": { "enum": ["source_entrance", "pokemon_center"] },
        "heal_on_wipe": { "type": "boolean" },
        "reconnect_grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["victory_flag", "repeatable", "return_trigger"],
      "properties": {
        "victory_flag": { "$ref": "#/$defs/resource_id" },
        "repeatable": { "type": "boolean" },
        "return_trigger": { "enum": ["automatic", "clear_exit"] },
        "clear_exit_position": { "$ref": "#/$defs/block_position" },
        "clear_exit_block": { "$ref": "#/$defs/resource_id" }
      },
      "allOf": [{
        "if": {
          "properties": { "return_trigger": { "const": "clear_exit" } },
          "required": ["return_trigger"]
        },
        "then": {
          "required": ["clear_exit_position", "clear_exit_block"]
        }
      }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "completion": {
            "properties": { "repeatable": { "const": true } },
            "required": ["repeatable"]
          }
        },
        "required": ["completion"]
      },
      "then": {
        "properties": {
          "rewards": { "required": ["repeat_table"] }
        }
      }
    }
  ],
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "properties": {
        "ko_kr": { "type": "string", "minLength": 1 },
        "en_us": { "type": "string", "minLength": 1 }
      }
    },
    "level": { "type": "integer", "minimum": 1, "maximum": 100 },
    "block_position": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" }, { "type": "integer" }, { "type": "integer" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrance_id", "destination_entry", "activation", "visibility", "return_policy"
      ],
      "properties": {
        "entrance_id": { "$ref": "#/$defs/resource_id" },
        "destination_entry": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "activation": { "enum": ["interact", "cross", "portal", "proximity"] },
        "visibility": { "enum": ["always", "discovered", "conditioned", "hidden"] },
        "return_policy": { "enum": ["source_position", "source_safe_anchor", "configured_exit"] }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "npcs", "opponents", "requires", "position", "boss"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "npcs": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "opponents": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        },
        "position": { "$ref": "#/$defs/block_position" },
        "yaw": { "type": "number", "minimum": -180, "maximum": 180 },
        "boss": { "type": "boolean" }
      }
    },
    "loot_container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position", "block", "facing", "requires_completion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "position": { "$ref": "#/$defs/block_position" },
        "block": { "enum": ["chest", "barrel"] },
        "facing": { "enum": ["north", "south", "west", "east"] },
        "requires_completion": { "type": "boolean" },
        "loot_table": { "$ref": "#/$defs/resource_id" }
      }
    },
    "wild_species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "min_level", "max_level", "weight"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "$ref": "#/$defs/level" },
        "max_level": { "$ref": "#/$defs/level" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "spawn_as_evolved": { "type": "boolean", "default": false }
      }
    },
    "healing_station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "position", "block", "uses_per_run",
        "restore_hp", "restore_status", "restore_pp"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "position": { "$ref": "#/$defs/block_position" },
        "block": { "$ref": "#/$defs/resource_id" },
        "uses_per_run": { "type": "integer", "minimum": 1, "maximum": 64 },
        "restore_hp": { "type": "boolean" },
        "restore_status": { "type": "boolean" },
        "restore_pp": { "type": "boolean" }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "block", "requires"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "min": { "$ref": "#/$defs/block_position" },
        "max": { "$ref": "#/$defs/block_position" },
        "block": { "$ref": "#/$defs/resource_id" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        }
      }
    }
  }
}
