{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/dungeon.schema.json",
  "title": "Cobbleventure dungeon definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "dungeon_id", "display_name", "description",
    "preset", "entrances", "entry_ui", "difficulty", "eligibility", "multiplayer", "match", "battle", "terrain", "encounters",
    "random_encounters", "support", "gates", "loot", "rewards", "lifecycle", "completion"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "dungeon_id": { "$ref": "#/$defs/resource_id" },
    "music_track": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "description": { "$ref": "#/$defs/localized_text" },
    "preset": { "$ref": "#/$defs/resource_id" },
    "generated_trainers": { "$ref": "#/$defs/generated_trainers" },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/entrance" }
    },
    "entry_ui": {
      "type": "object",
      "additionalProperties": false,
      "required": ["info_mode", "confirm_required"],
      "properties": {
        "info_mode": { "enum": ["exact", "summary", "mystery"] },
        "confirm_required": { "type": "boolean" },
        "background_texture": { "$ref": "#/$defs/resource_id" }
      }
    },
    "difficulty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended_min", "recommended_max", "internal_min", "internal_max"],
      "properties": {
        "recommended_min": { "$ref": "#/$defs/level" },
        "recommended_max": { "$ref": "#/$defs/level" },
        "internal_min": { "$ref": "#/$defs/level" },
        "internal_max": { "$ref": "#/$defs/level" }
      }
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_party_size", "maximum_party_size", "require_usable_pokemon",
        "level_measure", "recommended_level_policy"
      ],
      "properties": {
        "minimum_party_size": { "type": "integer", "minimum": 1, "maximum": 6 },
        "maximum_party_size": { "type": "integer", "minimum": 1, "maximum": 6 },
        "require_usable_pokemon": { "type": "boolean" },
        "level_measure": { "enum": ["average", "highest"] },
        "recommended_level_policy": { "enum": ["ignore", "warn", "enforce"] },
        "condition_mode": { "$ref": "player-condition.schema.json#/$defs/mode" },
        "conditions": { "$ref": "player-condition.schema.json#/$defs/condition_list" },
        "locked_message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    },
    "multiplayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "min_size", "max_size"],
      "properties": {
        "mode": { "enum": ["solo", "cooperative", "independent"] },
        "min_size": { "type": "integer", "minimum": 1, "maximum": 4 },
        "max_size": { "type": "integer", "minimum": 1, "maximum": 4 },
        "battle_join": {
          "enum": ["summon_all", "require_nearby", "initiator_only"]
        },
        "tether": {
          "type": "object",
          "additionalProperties": false,
          "required": ["warn_distance", "max_distance", "on_exceed"],
          "properties": {
            "warn_distance": { "type": "integer", "minimum": 1, "maximum": 255 },
            "max_distance": { "type": "integer", "minimum": 2, "maximum": 256 },
            "on_exceed": { "const": "return_to_partner" }
          }
        }
      },
      "allOf": [{
        "if": {
          "properties": { "mode": { "const": "cooperative" } },
          "required": ["mode"]
        },
        "then": { "required": ["battle_join", "tether"] }
      }]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required_players", "scope", "timeout_seconds", "on_timeout", "stay_radius"
      ],
      "properties": {
        "required_players": { "type": "integer", "minimum": 1, "maximum": 4 },
        "scope": { "const": "same_entrance" },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "on_timeout": { "enum": ["cancel", "keep_waiting"] },
        "stay_radius": { "type": "integer", "minimum": 1, "maximum": 64 }
      }
    },
    "battle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allow_flee", "allow_capture", "allow_items", "allow_escape_actions"
      ],
      "properties": {
        "allow_flee": { "type": "boolean" },
        "allow_capture": { "type": "boolean" },
        "allow_items": { "type": "boolean" },
        "allow_escape_actions": { "type": "boolean" }
      }
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "seed_policy", "fallback"],
      "properties": {
        "mode": { "enum": ["authored", "runtime", "authored_pool"] },
        "plan_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "seed_policy": {
          "enum": ["fixed", "random_per_run", "daily", "weekly", "match", "player"]
        },
        "fallback": {
          "enum": ["reject_entry", "use_last_valid", "use_fallback_plan"]
        },
        "generation_timeout_ms": {
          "type": "integer", "minimum": 1, "maximum": 60000, "default": 1000
        },
        "max_attempts": {
          "type": "integer", "minimum": 1, "maximum": 1000, "default": 32
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "mode": { "const": "authored" } },
            "required": ["mode"]
          },
          "then": {
            "required": ["plan_ids"],
            "properties": { "plan_ids": { "minItems": 1, "maxItems": 1 } }
          }
        },
        {
          "if": {
            "properties": { "mode": { "const": "authored_pool" } },
            "required": ["mode"]
          },
          "then": { "required": ["plan_ids"] }
        }
      ]
    },
    "terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["fixed_template", "nbt_pieces", "procedural_cave", "hybrid"] },
        "template": { "$ref": "#/$defs/resource_id" },
        "entry_position": { "$ref": "#/$defs/block_position" },
        "exit_position": { "$ref": "#/$defs/block_position" },
        "piece_pool": { "$ref": "#/$defs/resource_id" },
        "cave_generator": { "const": "minecraft_worldgen" },
        "style": { "$ref": "cave.schema.json#/properties/style" },
        "requires_flash": { "$ref": "cave.schema.json#/properties/requires_flash" },
        "generator": { "$ref": "cave.schema.json#/properties/generator" },
        "bounds": { "$ref": "#/$defs/positive_block_position" }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed_template" } }, "required": ["mode"] },
          "then": { "required": ["template"] }
        },
        {
          "if": { "properties": { "mode": { "const": "nbt_pieces" } }, "required": ["mode"] },
          "then": { "required": ["piece_pool", "bounds"] }
        },
        {
          "if": { "properties": { "mode": { "const": "procedural_cave" } }, "required": ["mode"] },
          "then": { "required": ["cave_generator", "style", "requires_flash", "generator", "bounds"] }
        },
        {
          "if": { "properties": { "mode": { "const": "hybrid" } }, "required": ["mode"] },
          "then": { "required": ["piece_pool", "cave_generator", "style", "requires_flash", "generator", "bounds"] }
        }
      ]
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode", "critical_path_rooms", "branch_count", "branch_depth"
      ],
      "properties": {
        "mode": {
          "enum": ["fixed", "critical_path_branches", "maze", "rooms_and_corridors"]
        },
        "critical_path_rooms": { "$ref": "#/$defs/room_range" },
        "branch_count": { "$ref": "#/$defs/nonnegative_range" },
        "branch_depth": { "$ref": "#/$defs/positive_range" },
        "vertical_direction": {
          "enum": ["flat", "ascending", "descending", "mixed"],
          "default": "mixed"
        },
        "floor_changes": { "$ref": "#/$defs/nonnegative_range" },
        "loop_chance": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0
        }
      }
    },
    "topology": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "critical_path_rooms", "branch_count", "branch_depth"],
      "properties": {
        "mode": {
          "enum": ["authored", "corridor_spine", "hub_and_spokes", "room_network", "chamber_maze", "natural_network"]
        },
        "critical_path_rooms": { "$ref": "#/$defs/room_range" },
        "branch_count": { "$ref": "#/$defs/nonnegative_range" },
        "branch_depth": { "$ref": "#/$defs/positive_range" },
        "chamber_grid": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "items": { "type": "integer", "minimum": 3, "maximum": 64 }
        },
        "loop_chance": {
          "type": "number", "minimum": 0, "maximum": 1, "default": 0
        }
      },
      "allOf": [{
        "if": {
          "properties": { "mode": { "const": "chamber_maze" } },
          "required": ["mode"]
        },
        "then": { "required": ["chamber_grid"] }
      }]
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pattern"],
      "properties": {
        "pattern": {
          "enum": ["linear", "branching", "cyclic", "parallel_gate", "key_lock", "shortcut_loop"]
        },
        "required_targets": {
          "type": "integer", "minimum": 1, "maximum": 16, "default": 2
        },
        "encounter_order": {
          "enum": ["boss_only", "sequential"],
          "default": "boss_only"
        }
      },
      "allOf": [{
        "if": {
          "properties": { "pattern": { "const": "parallel_gate" } },
          "required": ["pattern"]
        },
        "then": { "required": ["required_targets"] }
      }]
    },
    "spatial_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm"],
      "properties": {
        "algorithm": {
          "enum": ["room_scatter", "corridor_halls", "socket_accretion"]
        },
        "chamber_pieces": {
          "type": "array",
          "description": "이 던전에서 일반 공동으로 사용할 명시적 후보 목록입니다. 빈 목록이면 일반 공동을 자동 배치하지 않습니다.",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource_id" }
        }
      }
    },
    "vertical": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["flat", "continuous", "discrete_floors", "authored"] },
        "direction": { "enum": ["ascending", "descending", "mixed"] },
        "floor_count": { "$ref": "#/$defs/positive_range" },
        "floor_height": { "type": "integer", "minimum": 4, "maximum": 64 },
        "connections_per_floor": { "$ref": "#/$defs/positive_range" }
      },
      "allOf": [{
        "if": {
          "properties": { "mode": { "const": "discrete_floors" } },
          "required": ["mode"]
        },
        "then": {
          "required": ["direction", "floor_count", "floor_height", "connections_per_floor"]
        }
      }]
    },
    "npc_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity_mode", "minimum_spacing"],
      "properties": {
        "capacity_mode": { "enum": ["fixed", "from_encounters"] },
        "required_slots": {
          "type": "integer", "minimum": 1, "maximum": 256
        },
        "minimum_spacing": {
          "type": "number", "minimum": 0, "maximum": 32
        }
      },
      "allOf": [{
        "if": {
          "properties": { "capacity_mode": { "const": "fixed" } },
          "required": ["capacity_mode"]
        },
        "then": { "required": ["required_slots"] },
        "else": { "not": { "required": ["required_slots"] } }
      }]
    },
    "encounters": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/encounter" }
    },
    "random_encounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "minimum_distance", "maximum_distance", "max_active",
        "spawn_interval_ticks", "additions"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "minimum_distance": { "type": "integer", "minimum": 1, "maximum": 128 },
        "maximum_distance": { "type": "integer", "minimum": 1, "maximum": 128 },
        "max_active": { "type": "integer", "minimum": 1, "maximum": 16 },
        "spawn_interval_ticks": { "type": "integer", "minimum": 20, "maximum": 12000 },
        "additions": {
          "type": "array",
          "items": { "$ref": "#/$defs/wild_species" }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["healing_stations"],
      "properties": {
        "healing_stations": {
          "type": "array",
          "items": { "$ref": "#/$defs/healing_station" }
        },
        "checkpoints": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/checkpoint" }
        }
      }
    },
    "gates": {
      "type": "array",
      "items": { "$ref": "#/$defs/gate" }
    },
    "objectives": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/objective" },
      "default": []
    },
    "loot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["loot_table", "ownership", "on_failure", "containers"],
      "properties": {
        "loot_table": { "$ref": "#/$defs/resource_id" },
        "ownership": { "enum": ["per_player", "run_shared", "first_claim"] },
        "on_failure": {
          "enum": ["keep_collected", "remove_run_loot", "grant_on_clear_only"]
        },
        "containers": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/loot_container" }
        }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_clear_table", "first_clear_field_moves"],
      "properties": {
        "first_clear_table": { "$ref": "#/$defs/resource_id" },
        "repeat_table": { "$ref": "#/$defs/resource_id" },
        "first_clear_field_moves": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]+$" }
        }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "on_wipe", "wipe_return", "heal_on_wipe", "reconnect_grace_seconds"
      ],
      "properties": {
        "on_wipe": { "const": "reset_run" },
        "wipe_return": { "enum": ["source_entrance", "pokemon_center"] },
        "heal_on_wipe": { "type": "boolean" },
        "resume_mode": {
          "enum": ["full_reset", "checkpoint", "keep_until_timeout"],
          "default": "keep_until_timeout"
        },
        "reconnect_grace_seconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        }
      }
    },
    "completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["victory_flag", "repeatable", "return_trigger"],
      "properties": {
        "victory_flag": { "$ref": "#/$defs/resource_id" },
        "repeatable": { "type": "boolean" },
        "return_trigger": { "enum": ["automatic", "clear_exit"] },
        "clear_exit_position": { "$ref": "#/$defs/block_position" },
        "clear_exit_block": { "$ref": "#/$defs/resource_id" }
      },
      "allOf": [{
        "if": {
          "properties": { "return_trigger": { "const": "clear_exit" } },
          "required": ["return_trigger"]
        },
        "then": {
          "required": ["clear_exit_block"]
        }
      }]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "terrain": {
            "properties": { "mode": { "const": "nbt_pieces" } },
            "required": ["mode"]
          }
        },
        "required": ["terrain"]
      },
      "then": { "required": ["plan", "layout"] }
    },
    {
      "if": {
        "properties": {
          "terrain": {
            "properties": { "mode": { "enum": ["procedural_cave", "hybrid"] } },
            "required": ["mode"]
          }
        },
        "required": ["terrain"]
      },
      "then": { "required": ["plan"] }
    },
    {
      "if": {
        "properties": {
          "completion": {
            "properties": { "repeatable": { "const": true } },
            "required": ["repeatable"]
          }
        },
        "required": ["completion"]
      },
      "then": {
        "properties": {
          "rewards": { "required": ["repeat_table"] }
        }
      }
    },
    {
      "if": {
        "properties": {
          "terrain": {
            "properties": { "mode": { "const": "procedural_cave" } },
            "required": ["mode"]
          }
        },
        "required": ["terrain"]
      },
      "then": {
        "properties": {
          "plan": {
            "properties": { "mode": { "const": "runtime" } },
            "required": ["mode"]
          }
        }
      }
    }
  ],
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "string", "minLength": 1 },
      "properties": {
        "ko_kr": { "type": "string", "minLength": 1 },
        "en_us": { "type": "string", "minLength": 1 }
      }
    },
    "level": { "type": "integer", "minimum": 1, "maximum": 100 },
    "block_position": {
      "type": "array",
      "prefixItems": [
        { "type": "integer" }, { "type": "integer" }, { "type": "integer" }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "positive_block_position": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ],
      "minItems": 3,
      "maxItems": 3
    },
    "room_range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 3, "maximum": 256 },
        { "type": "integer", "minimum": 3, "maximum": 256 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "nonnegative_range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 0, "maximum": 128 },
        { "type": "integer", "minimum": 0, "maximum": 128 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "positive_range": {
      "type": "array",
      "prefixItems": [
        { "type": "integer", "minimum": 1, "maximum": 64 },
        { "type": "integer", "minimum": 1, "maximum": 64 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entrance_id", "destination_entry", "activation", "visibility", "return_policy"
      ],
      "properties": {
        "entrance_id": { "$ref": "#/$defs/resource_id" },
        "destination_entry": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "activation": { "enum": ["interact", "cross", "portal", "proximity"] },
        "visibility": { "enum": ["always", "discovered", "conditioned", "hidden"] },
        "return_policy": { "enum": ["source_position", "source_safe_anchor", "configured_exit"] }
      }
    },
    "encounter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "display_name", "requires", "boss"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "kind": { "enum": ["trainer", "wild_pokemon"], "default": "trainer" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "npcs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "trainers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/trainer_actor" }
        },
        "opponents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "trigger": { "$ref": "#/$defs/encounter_trigger" },
        "pokemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["species", "level", "catchable"],
          "properties": {
            "species": { "$ref": "#/$defs/resource_id" },
            "level": { "$ref": "#/$defs/level" },
            "catchable": { "type": "boolean" }
          }
        },
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        },
        "run_state_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource_id" },
          "default": []
        },
        "position": { "$ref": "#/$defs/block_position" },
        "yaw": { "type": "number", "minimum": -180, "maximum": 180 },
        "boss": { "type": "boolean" }
      },
      "allOf": [{
        "if": {
          "properties": { "kind": { "const": "wild_pokemon" } },
          "required": ["kind"]
        },
        "then": {
          "required": ["pokemon"],
          "not": { "anyOf": [
            { "required": ["npcs"] }, { "required": ["trainers"] },
            { "required": ["opponents"] }, { "required": ["trigger"] }
          ] }
        },
        "else": {
          "oneOf": [
            {
              "required": ["trainers", "trigger"],
              "not": { "anyOf": [
                { "required": ["npcs"] }, { "required": ["opponents"] }
              ] }
            },
            {
              "required": ["npcs", "opponents"],
              "not": { "anyOf": [
                { "required": ["trainers"] },
                { "required": ["trigger"] }
              ] }
            }
          ]
        }
      }]
    },
    "trainer_actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "trainer_class", "battle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "trainer_class": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:trainer_class/[a-z0-9_./-]+$"
        },
        "battle": {
          "type": "string",
          "pattern": "^[a-z0-9_.-]+:battle/[a-z0-9_./-]+$"
        },
        "inline_battle": {
          "$ref": "content-bundle.schema.json#/$defs/battle"
        }
      }
    },
    "encounter_trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type", "leader", "range", "warning_offset", "warning_track",
        "start_lines", "win_lines", "loss_lines"
      ],
      "properties": {
        "type": { "const": "proximity" },
        "leader": { "type": "integer", "minimum": 0, "maximum": 1 },
        "range": { "type": "number", "exclusiveMinimum": 0 },
        "warning_offset": { "type": "number", "minimum": 0 },
        "warning_track": {
          "type": "string", "pattern": "^[A-Za-z0-9._-]+$"
        },
        "start_lines": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "win_lines": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "loss_lines": {
          "type": "array", "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "generated_trainers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled", "count", "appearance_pool", "dialogue_pool",
        "pokemon_pool", "team_size", "allow_duplicates"
      ],
      "properties": {
        "enabled": { "type": "boolean" },
        "count": {
          "type": "array", "minItems": 2, "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 256 },
            { "type": "integer", "minimum": 1, "maximum": 256 }
          ],
          "items": false
        },
        "appearance_pool": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["display_name", "trainer_class", "weight"],
            "properties": {
              "display_name": { "$ref": "#/$defs/localized_text" },
              "trainer_class": {
                "type": "string",
                "pattern": "^[a-z0-9_.-]+:trainer_class/[a-z0-9_./-]+$"
              },
              "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "dialogue_pool": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["battle_start_line", "battle_end_line", "weight"],
            "properties": {
              "battle_start_line": { "type": "string", "minLength": 1 },
              "battle_end_line": { "type": "string", "minLength": 1 },
              "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "pokemon_pool": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["species", "weight"],
            "properties": {
              "species": { "$ref": "#/$defs/resource_id" },
              "weight": { "type": "integer", "minimum": 1, "maximum": 1000 }
            }
          }
        },
        "team_size": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "prefixItems": [
            { "type": "integer", "minimum": 1, "maximum": 6 },
            { "type": "integer", "minimum": 1, "maximum": 6 }
          ],
          "items": false
        },
        "allow_duplicates": { "type": "boolean" }
      }
    },
    "loot_container": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "block", "facing", "requires_completion"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "position": { "$ref": "#/$defs/block_position" },
        "block": { "enum": ["chest", "barrel"] },
        "facing": { "enum": ["north", "south", "west", "east"] },
        "requires_completion": { "type": "boolean" },
        "loot_table": { "$ref": "#/$defs/resource_id" }
      }
    },
    "wild_species": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "min_level", "max_level", "weight"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "$ref": "#/$defs/level" },
        "max_level": { "$ref": "#/$defs/level" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "spawn_as_evolved": { "type": "boolean", "default": false }
      }
    },
    "healing_station": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "block", "uses_per_run",
        "restore_hp", "restore_status", "restore_pp"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "position": { "$ref": "#/$defs/block_position" },
        "block": { "$ref": "#/$defs/resource_id" },
        "uses_per_run": { "type": "integer", "minimum": 1, "maximum": 64 },
        "restore_hp": { "type": "boolean" },
        "restore_status": { "type": "boolean" },
        "restore_pp": { "type": "boolean" }
      }
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "position"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "position": { "$ref": "#/$defs/block_position" },
        "activation_radius": {
          "type": "integer", "minimum": 1, "maximum": 8, "default": 2
        }
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "min", "max", "block"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "placement": { "enum": ["fixed", "marker"], "default": "fixed" },
        "min": { "$ref": "#/$defs/block_position" },
        "max": { "$ref": "#/$defs/block_position" },
        "block": { "$ref": "#/$defs/resource_id" },
        "requires": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/gate_requirement" }
        }
      },
      "anyOf": [{ "required": ["requires"] }, { "required": ["requirements"] }]
    },
    "gate_requirement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "encounter" },
            "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "id"],
          "properties": {
            "type": { "const": "objective" },
            "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "item", "count", "consume"],
          "properties": {
            "type": { "const": "item" },
            "item": { "$ref": "#/$defs/resource_id" },
            "count": { "type": "integer", "minimum": 1, "maximum": 64 },
            "consume": { "type": "boolean" }
          }
        }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "placement", "block", "activation_radius"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "kind": { "enum": ["switch", "investigate"] },
        "placement": { "enum": ["fixed", "marker"] },
        "position": { "$ref": "#/$defs/block_position" },
        "block": { "$ref": "#/$defs/resource_id" },
        "activation_radius": { "type": "integer", "minimum": 1, "maximum": 8 }
      },
      "allOf": [{
        "if": { "properties": { "placement": { "const": "fixed" } }, "required": ["placement"] },
        "then": { "required": ["position"] }
      }]
    }
  }
}
