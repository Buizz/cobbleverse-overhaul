{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/player-condition.schema.json",
  "title": "Cobbleventure shared player conditions",
  "$defs": {
    "mode": {
      "enum": ["all", "any"]
    },
    "condition_list": {
      "type": "array",
      "items": { "$ref": "#/$defs/condition" }
    },
    "condition": {
      "oneOf": [
        { "$ref": "#/$defs/variable" },
        { "$ref": "#/$defs/flag" },
        { "$ref": "#/$defs/item" },
        { "$ref": "#/$defs/badge" },
        { "$ref": "#/$defs/pokemon" },
        { "$ref": "#/$defs/party_count" },
        { "$ref": "#/$defs/always" },
        { "$ref": "#/$defs/legacy_flag_equals" },
        { "$ref": "#/$defs/legacy_has_item" }
      ]
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "key", "operator", "value"],
      "properties": {
        "type": { "const": "variable" },
        "source": { "enum": ["scoreboard", "persistent_data"] },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "operator": { "$ref": "#/$defs/operator" },
        "value": { "type": "number" }
      }
    },
    "flag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "key", "value"],
      "properties": {
        "type": { "const": "flag" },
        "key": { "$ref": "#/$defs/resource_id" },
        "value": { "type": ["number", "boolean"] }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "item", "count"],
      "properties": {
        "type": { "const": "item" },
        "item": { "$ref": "#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "negate": { "type": "boolean" }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "badge"],
      "properties": {
        "type": { "const": "badge" },
        "badge": { "$ref": "#/$defs/resource_id" },
        "negate": { "type": "boolean" }
      }
    },
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "species"],
      "properties": {
        "type": { "const": "pokemon" },
        "species": { "$ref": "#/$defs/resource_id" },
        "negate": { "type": "boolean" }
      }
    },
    "party_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operator", "value"],
      "properties": {
        "type": { "const": "party_count" },
        "operator": { "$ref": "#/$defs/operator" },
        "value": { "type": "integer", "minimum": 0, "maximum": 6 }
      }
    },
    "always": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": { "type": { "const": "always" } }
    },
    "legacy_flag_equals": {
      "type": "object",
      "required": ["type", "key", "value"],
      "properties": {
        "type": { "const": "flag_equals" },
        "key": { "$ref": "#/$defs/resource_id" },
        "value": { "type": ["number", "boolean", "string"] }
      }
    },
    "legacy_has_item": {
      "type": "object",
      "required": ["type", "item"],
      "properties": {
        "type": { "const": "has_item" },
        "item": { "$ref": "#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1 }
      }
    },
    "operator": {
      "enum": ["==", "!=", ">", ">=", "<", "<="]
    },
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    }
  }
}
