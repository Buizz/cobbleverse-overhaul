{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/hex-world.schema.json",
  "title": "Cobbleventure generation hex world",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "dimension", "seed_salt", "grid",
    "settlements", "connections"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "enum": [1, 2] },
    "id": { "$ref": "#/$defs/resource_id" },
    "dimension": { "$ref": "#/$defs/resource_id" },
    "pokemon_generations": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 9 }
    },
    "seed_salt": { "type": "integer" },
    "grid": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "tile_radius_blocks", "origin"],
      "properties": {
        "orientation": { "const": "pointy_top" },
        "tile_radius_blocks": { "type": "integer", "minimum": 32, "maximum": 256 },
        "map_radius_cells": { "type": "integer", "minimum": 3, "maximum": 14 },
        "origin": { "$ref": "#/$defs/block_position" }
      }
    },
    "settlements": {
      "type": "array",
      "items": { "$ref": "#/$defs/settlement_footprint" }
    },
    "tiles": {
      "type": "array",
      "items": { "$ref": "#/$defs/placed_tile" }
    },
    "environment_overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/environment_override" }
    },
    "level_overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/level_override" }
    },
    "music_overrides": {
      "type": "array",
      "items": { "$ref": "#/$defs/music_override" }
    },
    "empty_terrain": { "$ref": "#/$defs/empty_terrain" },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/connection" }
    },
    "objects": {
      "type": "array",
      "items": { "$ref": "#/$defs/custom_object" }
    },
    "cave_entrances": {
      "type": "array",
      "items": { "$ref": "#/$defs/cave_entrance" }
    },
    "forest_entrances": {
      "type": "array",
      "items": { "$ref": "#/$defs/forest_entrance" }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "route_endpoint_id": {
      "type": "string",
      "pattern": "^(?:[a-z0-9_.-]+:[a-z0-9_./-]+|[a-z0-9_.-]+)$"
    },
    "music_track": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+$"
    },
    "block_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "axial_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 }
      }
    },
    "placed_tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r", "biome", "boundary_profile", "terrain_profile"],
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "biome": { "$ref": "#/$defs/resource_id" },
        "boundary_profile": { "$ref": "#/$defs/resource_id" },
        "terrain_profile": { "$ref": "#/$defs/terrain_profile" },
        "music_track": { "$ref": "#/$defs/music_track" },
        "access_requirement": { "$ref": "#/$defs/resource_id" }
      }
    },
    "environment_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "minProperties": 3,
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "temperature": { "enum": ["cold", "cool", "temperate", "hot"] },
        "humidity": { "enum": ["dry", "normal", "humid", "aquatic"] },
        "weather": { "enum": ["clear", "rain", "thunder", "snow", "fog"] }
      }
    },
    "level_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r", "average_level"],
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "average_level": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "music_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r", "music_track"],
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "music_track": { "$ref": "#/$defs/music_track" }
      }
    },
    "empty_terrain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default_type", "tiles"],
      "properties": {
        "default_type": { "$ref": "#/$defs/empty_terrain_type" },
        "tiles": {
          "type": "array",
          "items": { "$ref": "#/$defs/empty_terrain_tile" }
        }
      }
    },
    "empty_terrain_type": {
      "enum": ["high_forest", "dense_forest", "ocean", "deep_ocean", "desert", "stone_mountain", "red_rock_mountain", "snow_mountain"]
    },
    "empty_terrain_tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r", "type"],
      "properties": {
        "q": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "r": { "type": "integer", "minimum": -1024, "maximum": 1024 },
        "type": { "$ref": "#/$defs/empty_terrain_type" }
      }
    },
    "spawn_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "rarities", "include_secondary"],
      "properties": {
        "generation": { "type": "integer", "minimum": 0, "maximum": 9 },
        "series": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "habitat_variant": { "type": "integer", "minimum": 0 },
        "rarities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["common", "medium", "uncommon", "rare", "legendary"] }
        },
        "include_secondary": { "type": "boolean" }
      }
    },
    "terrain_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_height_offset", "height_variation", "noise_scale_blocks"],
      "properties": {
        "base_height_offset": { "type": "integer", "minimum": -48, "maximum": 32 },
        "height_variation": { "type": "integer", "minimum": 0, "maximum": 8 },
        "noise_scale_blocks": { "type": "number", "minimum": 16, "maximum": 512 },
        "connection_height": { "type": "integer", "minimum": -8, "maximum": 8, "default": 0 }
      }
    },
    "biome_region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "biome", "tile_count", "preferred_direction", "growth",
        "influence_radius_blocks", "edge_noise", "boundary_profile",
        "habitat_profile", "spawn_settings", "terrain_profile"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "biome": { "$ref": "#/$defs/resource_id" },
        "tile_count": { "type": "integer", "minimum": 1, "maximum": 128 },
        "preferred_direction": { "enum": ["north_east", "east", "south_east", "south_west", "west", "north_west", "auto"] },
        "growth": { "enum": ["compact", "organic", "linear"] },
        "influence_radius_blocks": { "type": "number", "minimum": 24, "maximum": 512 },
        "edge_noise": { "type": "number", "minimum": 0, "maximum": 0.45 },
        "boundary_profile": { "$ref": "#/$defs/resource_id" },
        "habitat_profile": { "$ref": "#/$defs/resource_id" },
        "spawn_settings": { "$ref": "#/$defs/spawn_settings" },
        "terrain_profile": { "$ref": "#/$defs/terrain_profile" },
        "music_track": { "$ref": "#/$defs/music_track" },
        "pokemon_spawns": { "$ref": "#/$defs/route_pokemon_spawns" },
        "access_requirement": { "$ref": "#/$defs/resource_id" }
      }
    },
    "settlement_footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "settlement", "anchor", "town_radius_cells", "town_biome",
        "surroundings", "boundary_profile", "terrain_profile"
      ],
      "properties": {
        "settlement": { "$ref": "#/$defs/resource_id" },
        "anchor": { "$ref": "#/$defs/axial_coordinate" },
        "town_radius_cells": { "type": "integer", "enum": [1, 3, 5, 7, 19] },
        "town_footprint_shape": { "type": "string", "enum": ["triangle_up", "triangle_down", "line_q", "line_r", "line_s", "five_up", "five_down", "custom"] },
        "town_footprint_cells": {
          "type": "array", "minItems": 1, "maxItems": 19, "uniqueItems": true,
          "items": { "$ref": "#/$defs/axial_coordinate" }
        },
        "town_road_exits": {
          "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
          "items": { "$ref": "#/$defs/axial_coordinate" }
        },
        "town_biome": { "$ref": "#/$defs/resource_id" },
        "surroundings": {
          "type": "array",
          "maxItems": 6,
          "items": { "$ref": "#/$defs/biome_region" }
        },
        "boundary_profile": { "$ref": "#/$defs/resource_id" },
        "terrain_profile": { "$ref": "#/$defs/terrain_profile" },
        "access_requirement": { "$ref": "#/$defs/resource_id" }
      }
    },
    "connection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "cells", "corridor_width_blocks", "surface_style"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "route_preset": { "$ref": "#/$defs/resource_id" },
        "from": { "$ref": "#/$defs/route_endpoint_id" },
        "to": { "$ref": "#/$defs/route_endpoint_id" },
        "route_biome": { "$ref": "#/$defs/resource_id" },
        "width_cells": { "type": "integer", "minimum": 1, "maximum": 3 },
        "pathfinding": { "enum": ["shortest", "organic", "explicit"] },
        "detour_cells": { "type": "integer", "minimum": 0, "maximum": 32 },
        "corridor_width_blocks": { "type": "number", "minimum": 12, "maximum": 256 },
        "edge_noise": { "type": "number", "minimum": 0, "maximum": 0.35 },
        "boundary_profile": { "$ref": "#/$defs/resource_id" },
        "terrain_profile": { "$ref": "#/$defs/terrain_profile" },
        "surface_style": { "enum": ["road", "natural", "water", "log_bridge"] },
        "music_track": { "$ref": "#/$defs/music_track" },
        "access_requirement": { "$ref": "#/$defs/resource_id" },
        "anchors": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/axial_coordinate" }
        },
        "cells": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/axial_coordinate" }
        }
      }
    },
    "route_pokemon_spawns": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherit_biome", "excluded_species", "additions"],
      "properties": {
        "inherit_biome": { "type": "boolean" },
        "excluded_species": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource_id" }
        },
        "additions": {
          "type": "array",
          "items": { "$ref": "#/$defs/route_pokemon_addition" }
        },
        "level_overrides": {
          "type": "array",
          "items": { "$ref": "#/$defs/pokemon_level_override" }
        }
      }
    },
    "route_pokemon_addition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "min_level", "max_level"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "spawn_as_evolved": { "type": "boolean", "default": false }
      }
    },
    "pokemon_level_override": {
      "type": "object",
      "additionalProperties": false,
      "required": ["species", "min_level", "max_level"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "custom_object": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "anchor"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "type": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "anchor": { "$ref": "#/$defs/axial_coordinate" },
        "resource": { "$ref": "#/$defs/resource_id" },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 5 },
        "properties": { "type": "object" }
      },
      "allOf": [{
        "if": { "properties": { "type": { "const": "gate" } }, "required": ["type"] },
        "then": {
          "required": ["rotation", "properties"],
          "properties": {
            "rotation": { "type": "integer", "minimum": 0, "maximum": 3 },
            "properties": { "$ref": "#/$defs/gate_properties" }
          },
          "allOf": [{
            "if": {
              "properties": {
                "properties": {
                  "properties": { "building_enabled": { "const": false } },
                  "required": ["building_enabled"]
                }
              }
            },
            "else": { "required": ["resource"] }
          }]
        }
      }, {
        "if": { "properties": { "type": { "const": "villain_base" } }, "required": ["type"] },
        "then": {
          "required": ["resource", "rotation"],
          "properties": {
            "rotation": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        }
      }, {
        "if": { "properties": { "type": { "const": "legendary_site" } }, "required": ["type"] },
        "then": {
          "required": ["resource", "rotation"],
          "properties": {
            "rotation": { "type": "integer", "minimum": 0, "maximum": 3 }
          }
        }
      }]
    },
    "gate_properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facing", "wall_block", "wall_thickness", "wall_height",
        "opening_width", "barrier_height", "condition_mode", "conditions"
      ],
      "properties": {
        "facing": { "enum": ["north", "east", "south", "west"] },
        "gate_mode": { "enum": ["classic", "npc_only", "system_only"] },
        "building_enabled": { "type": "boolean" },
        "surrounding_type": { "enum": ["wall", "trees", "none"] },
        "wall_block": { "$ref": "#/$defs/resource_id" },
        "tree_log": { "$ref": "#/$defs/resource_id" },
        "tree_leaves": { "$ref": "#/$defs/resource_id" },
        "wall_thickness": { "type": "integer", "minimum": 1, "maximum": 15 },
        "wall_height": { "type": "integer", "minimum": 3, "maximum": 32 },
        "opening_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "barrier_height": { "type": "integer", "minimum": 8, "maximum": 128 },
        "condition_mode": { "enum": ["all", "any"] },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/gate_condition" }
        },
        "deny_message": { "type": "string", "minLength": 1, "maxLength": 256 },
        "npc": { "$ref": "#/$defs/resource_id" }
      },
      "allOf": [{
        "if": {
          "properties": {
            "gate_mode": { "const": "npc_only" }
          },
          "required": ["gate_mode"]
        },
        "then": { "required": ["npc"] }
      }, {
        "if": {
          "properties": { "gate_mode": { "const": "system_only" } },
          "required": ["gate_mode"]
        },
        "then": {
          "required": ["deny_message"],
          "properties": { "conditions": { "minItems": 1 } }
        }
      }]
    },
    "gate_condition": {
      "oneOf": [
        { "$ref": "#/$defs/gate_variable_condition" },
        { "$ref": "#/$defs/gate_item_condition" },
        { "$ref": "#/$defs/gate_pokemon_condition" }
      ]
    },
    "gate_variable_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "key", "operator", "value"],
      "properties": {
        "type": { "const": "variable" },
        "source": { "enum": ["scoreboard", "persistent_data"] },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "operator": { "enum": ["==", "!=", ">", ">=", "<", "<="] },
        "value": { "type": "number" }
      }
    },
    "gate_item_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "item", "count"],
      "properties": {
        "type": { "const": "item" },
        "item": { "$ref": "#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "negate": { "type": "boolean" }
      }
    },
    "gate_pokemon_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "species"],
      "properties": {
        "type": { "const": "pokemon" },
        "species": { "$ref": "#/$defs/resource_id" },
        "negate": { "type": "boolean" }
      }
    },
    "cave_entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "cave", "entrance", "anchor", "facing", "structure"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "cave": { "$ref": "#/$defs/resource_id" },
        "entrance": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "anchor": { "$ref": "#/$defs/axial_coordinate" },
        "facing": { "enum": ["north", "east", "south", "west"] },
        "structure": { "$ref": "#/$defs/resource_id" },
        "pokemon_center_enabled": { "type": "boolean", "default": false },
        "structure_variants": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "high_forest": { "$ref": "#/$defs/resource_id" },
            "dense_forest": { "$ref": "#/$defs/resource_id" },
            "desert": { "$ref": "#/$defs/resource_id" },
            "ocean": { "$ref": "#/$defs/resource_id" },
            "deep_ocean": { "$ref": "#/$defs/resource_id" },
            "stone_mountain": { "$ref": "#/$defs/resource_id" },
            "red_rock_mountain": { "$ref": "#/$defs/resource_id" },
            "snow_mountain": { "$ref": "#/$defs/resource_id" }
          }
        },
        "pokemon_center": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "offset"],
          "properties": {
            "structure": { "$ref": "#/$defs/resource_id" },
            "offset": { "$ref": "#/$defs/axial_coordinate" }
          }
        }
      }
    },
    "forest_entrance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "forest", "entrance", "anchor", "facing", "structure", "rotation", "tree_log", "tree_leaves", "wall_thickness", "wall_height", "opening_width", "barrier_height"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "forest": { "$ref": "#/$defs/resource_id" },
        "entrance": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "anchor": { "$ref": "#/$defs/axial_coordinate" },
        "facing": { "enum": ["north", "east", "south", "west"] },
        "structure": { "$ref": "#/$defs/resource_id" },
        "pokemon_center_enabled": { "type": "boolean", "default": false },
        "rotation": { "type": "integer", "minimum": 0, "maximum": 3 },
        "tree_log": { "$ref": "#/$defs/resource_id" },
        "tree_leaves": { "$ref": "#/$defs/resource_id" },
        "wall_thickness": { "type": "integer", "minimum": 1, "maximum": 15 },
        "wall_height": { "type": "integer", "minimum": 3, "maximum": 32 },
        "opening_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "barrier_height": { "type": "integer", "minimum": 8, "maximum": 128 }
      }
    }
  }
}
