{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/cave.schema.json",
  "title": "Cobbleventure cave definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "id", "enabled", "display_name",
    "cave_type", "style", "dimension", "requires_flash", "random_encounters",
    "trainer_settings", "entrances"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "id": { "$ref": "#/$defs/resource_id" },
    "enabled": { "type": "boolean" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "music_track": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
    "cave_type": { "$ref": "#/$defs/resource_id" },
    "style": { "enum": ["rock", "dripstone", "crystal", "lush", "ice", "lava"] },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "region_id", "origin", "bounds"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "region_id": { "type": "string", "pattern": "^[a-z0-9_./-]+$" },
        "origin": { "$ref": "#/$defs/block_position" },
        "bounds": { "$ref": "#/$defs/bounds", "description": "입구와 공동 배치에서 빌드 시 자동 계산되는 읽기 전용 영역" }
      }
    },
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "layout", "seed_salt", "main_rooms", "branch_count", "loop_chance",
        "vertical_range", "room_radius", "tunnel_radius", "surface_roughness",
        "water_level", "water_depth"
      ],
      "properties": {
        "layout": { "const": "natural_network" },
        "seed_salt": { "type": "integer" },
        "main_rooms": { "type": "integer", "minimum": 3, "maximum": 32 },
        "branch_count": { "type": "integer", "minimum": 0, "maximum": 16 },
        "loop_chance": { "type": "number", "minimum": 0, "maximum": 1 },
        "vertical_range": { "type": "integer", "minimum": 8, "maximum": 96 },
        "room_radius": { "$ref": "#/$defs/radius_range" },
        "tunnel_radius": { "$ref": "#/$defs/radius_range" },
        "surface_roughness": { "type": "number", "minimum": 0, "maximum": 1 },
        "water_level": { "type": "integer", "minimum": 1, "maximum": 250 },
        "water_depth": { "type": "integer", "minimum": 1, "maximum": 96 },
        "grand_room_scale": { "type": "number", "minimum": 1, "maximum": 3 },
        "elevated_crossing": { "type": "boolean" },
        "bridge_clearance": { "type": "integer", "minimum": 7, "maximum": 32 },
        "room_types": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/room_type" }
        },
        "path_types": {
          "type": "array", "minItems": 1,
          "items": { "$ref": "#/$defs/path_type" }
        },
        "decorations": { "$ref": "#/$defs/decorations" },
        "manual_layout": { "$ref": "#/$defs/manual_layout" }
      }
    },
    "requires_flash": { "type": "boolean" },
    "random_encounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "minimum_distance", "maximum_distance", "minimum_level", "maximum_level", "pokemon_biome", "inherit_biome", "excluded_species", "additions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "minimum_distance": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "maximum_distance": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "minimum_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "maximum_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "pokemon_biome": { "$ref": "#/$defs/resource_id" },
        "inherit_biome": { "type": "boolean" },
        "excluded_species": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } },
        "additions": { "type": "array", "items": { "$ref": "#/$defs/pokemon_addition" } },
        "level_overrides": { "type": "array", "items": { "$ref": "#/$defs/pokemon_level_override" } },
        "time_overrides": { "type": "array", "items": { "$ref": "#/$defs/pokemon_time_override" } }
      }
    },
    "trainer_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "max_active", "class_pool", "placements"],
      "properties": {
        "enabled": { "type": "boolean" },
        "max_active": { "type": "integer", "minimum": 0, "maximum": 128 },
        "use_biome_defaults": { "type": "boolean", "default": true },
        "direct_trainers": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } },
        "trigger_override": { "$ref": "#/$defs/trigger_override" },
        "trainer_trigger_overrides": {
          "type": "object",
          "propertyNames": { "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
          "additionalProperties": { "$ref": "#/$defs/trigger_override" }
        },
        "class_pool": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } },
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "trainer_id", "position"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "trainer_id": { "$ref": "#/$defs/resource_id" },
              "position": { "$ref": "#/$defs/block_position" },
              "required_progress": { "$ref": "#/$defs/resource_id" },
              "trigger_override": { "$ref": "#/$defs/trigger_override" }
            }
          }
        }
      }
    },
    "dungeon_entrances": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entrance_id", "position", "safe_spawn"],
        "properties": {
          "entrance_id": { "$ref": "#/$defs/resource_id" },
          "position": { "$ref": "#/$defs/block_position" },
          "safe_spawn": { "$ref": "#/$defs/block_position" }
        }
      }
    },
    "embedded_sites": {
      "type": "array",
      "items": { "$ref": "#/$defs/embedded_site" }
    },
    "entrances": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "destination_anchor", "fallback_anchor"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
          "display_name": { "type": "string", "minLength": 1 },
          "destination_anchor": { "$ref": "#/$defs/block_position" },
          "fallback_anchor": { "$ref": "#/$defs/block_position" },
          "required_progress": { "$ref": "#/$defs/resource_id" }
        }
      }
    }
  },
  "$defs": {
    "resource_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" },
    "trigger_override": { "enum": ["preset", "source", "interact", "proximity"] },
    "localized_text": {
      "type": "object", "minProperties": 1,
      "properties": { "ko_kr": { "type": "string", "minLength": 1 }, "en_us": { "type": "string", "minLength": 1 } },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "block_position": {
      "type": "object", "additionalProperties": false, "required": ["x", "y", "z"],
      "properties": { "x": { "type": "integer" }, "y": { "type": "integer" }, "z": { "type": "integer" } }
    },
    "bounds": {
      "type": "object", "additionalProperties": false, "required": ["min_x", "min_z", "max_x", "max_z"],
      "properties": { "min_x": { "type": "integer" }, "min_z": { "type": "integer" }, "max_x": { "type": "integer" }, "max_z": { "type": "integer" } }
    },
    "radius_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "number", "minimum": 2, "maximum": 64 },
        "max": { "type": "number", "minimum": 2, "maximum": 96 }
      }
    },
    "integer_range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min", "max"],
      "properties": {
        "min": { "type": "integer", "minimum": 1, "maximum": 16 },
        "max": { "type": "integer", "minimum": 1, "maximum": 24 }
      }
    },
    "pokemon_addition": {
      "type": "object", "additionalProperties": false,
      "required": ["species", "min_level", "max_level"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "spawn_as_evolved": { "type": "boolean", "default": false }
      }
    },
    "pokemon_level_override": {
      "type": "object", "additionalProperties": false,
      "required": ["species", "min_level", "max_level"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 }
      }
    },
    "pokemon_time_override": {
      "type": "object", "additionalProperties": false,
      "required": ["species", "time"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "time": { "enum": ["any", "day", "night"] }
      }
    },
    "room_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "decoration"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "decoration": { "enum": ["rock", "dripstone", "crystal", "lush", "ice", "lava"] },
        "radius_scale": { "type": "number", "minimum": 0.5, "maximum": 2 },
        "height_scale": { "type": "number", "minimum": 0.5, "maximum": 2 }
      }
    },
    "path_type": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "weight", "width", "floor"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "weight": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "width": { "type": "integer", "minimum": 3, "maximum": 15 },
        "floor": { "enum": ["natural", "rugged", "worked"] }
      }
    },
    "decorations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_density", "patch_radius", "dripstone_length", "route_clearance"
      ],
      "properties": {
        "cluster_density": { "type": "number", "minimum": 0, "maximum": 4 },
        "patch_radius": { "$ref": "#/$defs/integer_range" },
        "dripstone_length": { "$ref": "#/$defs/integer_range" },
        "route_clearance": { "type": "integer", "minimum": 2, "maximum": 12 }
      }
    },
    "manual_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "anchors", "connections"],
      "properties": {
        "enabled": { "type": "boolean" },
        "anchors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "kind", "position", "radius_x", "radius_z", "height"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "kind": { "enum": ["room", "grand", "junction", "landmark"] },
              "room_type": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "position": { "$ref": "#/$defs/block_position" },
              "radius_x": { "type": "number", "minimum": 3, "maximum": 96 },
              "radius_z": { "type": "number", "minimum": 3, "maximum": 96 },
              "height": { "type": "number", "minimum": 5, "maximum": 96 }
            }
          }
        },
        "connections": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "from", "to", "kind", "width"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "from": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "to": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "kind": { "enum": ["tunnel", "stairs", "bridge"] },
              "path_type": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "width": { "type": "integer", "minimum": 3, "maximum": 15 }
            }
          }
        }
      }
    },
    "embedded_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "entrance_id", "placement"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "entrance_id": { "$ref": "#/$defs/resource_id" },
        "placement": { "enum": ["fixed", "anchor", "rule"] },
        "position": { "$ref": "#/$defs/block_position", "description": "차원 내부 절대 좌표" },
        "anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "candidate": { "enum": ["any", "main_path", "landmark"] },
        "offset": { "$ref": "#/$defs/block_position" },
        "safe_spawn": { "$ref": "#/$defs/block_position", "description": "차원 내부 절대 좌표" },
        "structure": { "$ref": "#/$defs/resource_id" },
        "door_anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "rotation": { "enum": ["none", "clockwise_90", "clockwise_180", "counterclockwise_90"] }
      },
      "dependentRequired": {
        "structure": ["door_anchor"],
        "door_anchor": ["structure"]
      },
      "allOf": [
        { "if": { "properties": { "placement": { "const": "fixed" } } }, "then": { "required": ["position"] } },
        { "if": { "properties": { "placement": { "const": "anchor" } } }, "then": { "required": ["anchor"] } },
        { "if": { "properties": { "placement": { "const": "rule" } } }, "then": { "required": ["candidate"] } }
      ]
    }
  }
}
