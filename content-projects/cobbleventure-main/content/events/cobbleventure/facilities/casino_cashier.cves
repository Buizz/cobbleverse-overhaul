event interact(range: 4) {
  page default {
    say npc {
      ko_kr: "어서 오세요. 이곳에서는 보유한 돈을 카지노 게임 잔액으로 환전해 드립니다."
      en_us: "Welcome. Here you can convert your money directly into casino game balance."
    }
    if has_item("cobbleventure_casino:coin_case", 1) {
      choice {
        ko_kr: "환전은 되돌릴 수 없습니다. 환전하시겠습니까?"
        en_us: "Exchange cannot be reversed. Would you like to continue?"
      } {
        {
          ko_kr: "환전하기"
          en_us: "Exchange"
        } {
          if money() >= 100 {
            let current_money = money()
            let affordable_chips = floor_div(current_money, 100)
            say npc {
              ko_kr: "카지노 칩 수량을 입력해 주세요. 칩 1개는 100 코블달러입니다."
              en_us: "Enter the number of casino chips. One chip costs 100 CobbleDollars."
            }
            id "exchange/amount" await number_input {
              min: 1
              max: affordable_chips
              current: current_money
              unit_price: 100
            } -> amount
            let exchange_cost = amount * 100
            id "exchange/perform" server_command "cvcasino exchange" amount -> exchanged
            if exchanged {
              say npc {
                ko_kr: "${exchange_cost} 코블달러로 카지노 칩 ${amount}개를 충전했습니다. 즐거운 시간 보내세요."
                en_us: "${exchange_cost} CobbleDollars were exchanged for ${amount} casino chips. Enjoy."
              }
            } else {
              say npc {
                ko_kr: "환전하지 못했습니다. 현재 잔액과 환전 한도를 확인해 주세요."
                en_us: "The exchange failed. Check your current balance and casino balance limit."
              }
            }
          } else {
            say npc {
              ko_kr: "카지노 칩 1개를 환전하려면 최소 100 코블달러가 필요합니다."
              en_us: "You need at least 100 CobbleDollars to exchange one casino chip."
            }
          }
        }
        {
          ko_kr: "그만두기"
          en_us: "Cancel"
        } {
          say npc {
            ko_kr: "필요할 때 다시 말씀해 주세요."
            en_us: "Come back whenever you need me."
          }
        }
      }
    } else {
      say npc {
        ko_kr: "먼저 동전케이스를 준비해 주세요. 동전케이스가 있어야 환전을 이용할 수 있습니다."
        en_us: "Please bring a Coin Case first. It is required to use the exchange."
      }
    }
  }
}
