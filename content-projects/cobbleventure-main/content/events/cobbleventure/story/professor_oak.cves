event interact(range: 4) {
  page when flag("cobbleventure:flag/story/pokedex_received") {
    say npc {
      ko_kr: "이미 첫 포켓몬을 골랐구나. 그 아이와 함께 멋진 모험을 해 보렴!"
      en_us: "You've already chosen your first Pokémon. Have a wonderful adventure together!"
    }
  }

  page when flag("cobbleventure:flag/story/starter_received") {
    say npc {
      ko_kr: "좋은 포켓몬을 골랐구나!"
      en_us: "You chose a fine Pokémon!"
    }
    say npc {
      ko_kr: "그럼 이것도 받아라. 포켓몬 도감이란다."
      en_us: "Then take this as well. It's a Pokédex."
    }
    id "retry/give_pokedex" give_item "cobblemon:pokedex_red" count 1 notify -> pokedex
    if pokedex.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 포켓몬 도감을 받을 수 없습니다."
      stop
    }
    id "retry/set_pokedex_received" set_flag "cobbleventure:flag/story/pokedex_received" true
    say npc {
      ko_kr: "포켓몬 도감은 만난 포켓몬과 잡은 포켓몬의 정보를 자동으로 기록해 준단다. 여러 포켓몬을 만나 도감을 완성해 보렴!"
      en_us: "The Pokédex automatically records information about Pokémon you meet and catch. Meet many Pokémon and try to complete it!"
    }
  }

  page default {
    say npc {
      ko_kr: "어서 오너라! 나는 포켓몬을 연구하는 오박사란다."
      en_us: "Welcome! I'm Professor Oak, a Pokémon researcher."
    }
    say npc {
      ko_kr: "이제 너와 함께 모험할 첫 포켓몬을 정해 보자꾸나!"
      en_us: "Let's choose the first Pokémon that will join you on your adventure!"
    }
    id "first/starter_roulette" await starter_roulette -> starter
    say npc {
      ko_kr: "${starter.name|josa:을/를} 골랐구나!"
      en_us: "You chose ${starter.name}!"
    }
    say npc {
      ko_kr: "그럼 이것도 받아라. 포켓몬 도감이란다."
      en_us: "Then take this as well. It's a Pokédex."
    }
    id "first/give_pokedex" give_item "cobblemon:pokedex_red" count 1 notify -> pokedex
    if pokedex.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 포켓몬 도감을 받을 수 없습니다."
      stop
    }
    id "first/set_pokedex_received" set_flag "cobbleventure:flag/story/pokedex_received" true
    say npc {
      ko_kr: "포켓몬 도감은 만난 포켓몬과 잡은 포켓몬의 정보를 자동으로 기록해 준단다. 여러 포켓몬을 만나 도감을 완성해 보렴!"
      en_us: "The Pokédex automatically records information about Pokémon you meet and catch. Meet many Pokémon and try to complete it!"
    }
  }
}
