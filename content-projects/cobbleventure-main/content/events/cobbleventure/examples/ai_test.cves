event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/ai_test/defeated") {
    say npc "졌지만 좋은 승부였어! 다음에도 다시 상대해 줘."
    choice "" {
      "다음에 또 보자" {
        stop
      }
    }
  }

  page default {
    if has_item("cobblemon:potion", 1) {
      say npc "상처약까지 챙겼구나! 준비가 철저한데? 바로 승부하자!"
      choice "" {
        "승부한다" {
          id "prepared/battle" await battle "cobbleventure:battle/ai_test" -> battle_result
          if battle_result.outcome == "win" {
            id "prepared/give_loot" give_loot "cobbleventure:trainer/ai_test_rewards" count 1 notify -> reward
            if reward.remaining_count > 0 {
              narrate "가방에 빈 공간이 없어 승리 보상을 모두 받을 수 없습니다."
              stop
            }
            id "prepared/set_defeated" set_flag "cobbleventure:flag/trainer/ai_test/defeated" true
            say npc "졌지만 좋은 승부였어! 다음에도 다시 상대해 줘."
          } else {
            say npc "좋은 승부였어. 준비가 되면 다시 도전해 줘!"
          }
        }
      }
    } else {
      say npc "잠깐! 나는 배틀 연습 중인 AI 맨이야. 준비가 됐다면 나와 승부하자!"
      choice "" {
        "승부한다" {
          id "default/battle" await battle "cobbleventure:battle/ai_test" -> battle_result
          if battle_result.outcome == "win" {
            id "default/give_loot" give_loot "cobbleventure:trainer/ai_test_rewards" count 1 notify -> reward
            if reward.remaining_count > 0 {
              narrate "가방에 빈 공간이 없어 승리 보상을 모두 받을 수 없습니다."
              stop
            }
            id "default/set_defeated" set_flag "cobbleventure:flag/trainer/ai_test/defeated" true
            say npc "졌지만 좋은 승부였어! 다음에도 다시 상대해 줘."
          } else {
            say npc "좋은 승부였어. 준비가 되면 다시 도전해 줘!"
          }
        }
        "다음에" {
          stop
        }
      }
    }
  }
}
