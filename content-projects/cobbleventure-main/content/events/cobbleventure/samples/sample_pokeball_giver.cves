event interact(range: 4) {
  page when flag("cobbleventure:flag/sample/sample_pokeball_giver/claimed") {
    say npc {
      ko_kr: "몬스터볼은 한 번 건넸어. 멋진 파트너를 만나길 바랄게!"
    }
  }

  page default {
    say npc {
      ko_kr: "새로운 포켓몬을 만날 때를 대비해 몬스터볼을 챙겨 가."
    }
    id "first/give_item" give_item "cobblemon:poke_ball" count 5 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 보상을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/sample/sample_pokeball_giver/claimed" true
  }
}
