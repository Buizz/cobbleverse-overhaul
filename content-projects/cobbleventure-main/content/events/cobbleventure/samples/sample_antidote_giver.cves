event interact(range: 4) {
  page when flag("cobbleventure:flag/sample/sample_antidote_giver/claimed") {
    say npc {
      ko_kr: "숲에서는 독 상태를 조심해. 해독제는 이미 건넸단다."
    }
  }

  page default {
    say npc {
      ko_kr: "숲에는 독을 쓰는 포켓몬이 많아. 이 해독제를 가져가."
    }
    id "first/give_item" give_item "cobblemon:antidote" count 2 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 보상을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/sample/sample_antidote_giver/claimed" true
  }
}
