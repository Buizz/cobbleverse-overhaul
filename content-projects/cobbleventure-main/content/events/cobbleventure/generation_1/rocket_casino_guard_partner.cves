event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated") {
    say npc { ko_kr: "혼자 온 게 아니야. 우리 경비조를 함께 상대해라!" }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_casino_guard_partner" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated" true
      say npc { ko_kr: "둘이 동시에 밀리다니…" }
    } else {
      say npc { ko_kr: "경비조를 얕보지 마라!" }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated") {
    say npc { ko_kr: "둘이 동시에 밀리다니…" }
  }
  page default {
    say npc { ko_kr: "혼자 온 게 아니야. 우리 경비조를 함께 상대해라!" }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_casino_guard_partner" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_guard_partner/defeated" true
          say npc { ko_kr: "둘이 동시에 밀리다니…" }
        } else {
          say npc { ko_kr: "경비조를 얕보지 마라!" }
        }
      }
      { ko_kr: "다음에 도전한다" } { stop }
    }
  }
}
