event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") {
    say npc {
      ko_kr: "여긴 로켓단 작전 구역이다. 돌아가!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_grunt" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated" true
      say npc {
        ko_kr: "으윽, 간부님께 가기 전에 막았어야 했는데…"
      }
    } else {
      say npc {
        ko_kr: "로켓단을 얕보지 마라!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") {
    say npc {
      ko_kr: "으윽, 간부님께 가기 전에 막았어야 했는데…"
    }
  }

  page default {
    say npc {
      ko_kr: "여긴 로켓단 작전 구역이다. 돌아가!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_grunt" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated" true
          say npc {
            ko_kr: "으윽, 간부님께 가기 전에 막았어야 했는데…"
          }
        } else {
          say npc {
            ko_kr: "로켓단을 얕보지 마라!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
