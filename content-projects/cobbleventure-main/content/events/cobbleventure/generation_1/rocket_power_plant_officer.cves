event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated") && (flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") && flag("cobbleventure:flag/trainer/rocket_power_plant_grunt_east/defeated")) {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated") && (flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") && flag("cobbleventure:flag/trainer/rocket_power_plant_grunt_east/defeated")) {
    say npc {
      ko_kr: "발전소의 전력은 이제 로켓단의 것이다. 방해자는 제거한다!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_officer" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated" true
      say npc {
        ko_kr: "작전은 실패다… 철수한다!"
      }
    } else {
      say npc {
        ko_kr: "이 발전소는 계속 로켓단이 사용하겠다."
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated") {
    say npc {
      ko_kr: "작전은 실패다… 철수한다!"
    }
  }

  page when flag("cobbleventure:flag/trainer/rocket_power_plant_grunt/defeated") && flag("cobbleventure:flag/trainer/rocket_power_plant_grunt_east/defeated") {
    say npc {
      ko_kr: "발전소의 전력은 이제 로켓단의 것이다. 방해자는 제거한다!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_officer" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/dungeon/rocket_power_plant/boss_defeated" true
          say npc {
            ko_kr: "작전은 실패다… 철수한다!"
          }
        } else {
          say npc {
            ko_kr: "이 발전소는 계속 로켓단이 사용하겠다."
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
