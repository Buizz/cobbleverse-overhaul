event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_admin/defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_admin/defeated") {
    say npc {
      ko_kr: "이 넓은 기지를 여기까지 내려오다니 제법이군."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_officer" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_admin/defeated" true
      say npc {
        ko_kr: "본부에 보고해야겠군…"
      }
    } else {
      say npc {
        ko_kr: "침입자는 지상으로 돌려보내 주지."
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/rocket_casino_admin/defeated") {
    say npc {
      ko_kr: "본부에 보고해야겠군…"
    }
  }

  page default {
    say npc {
      ko_kr: "이 넓은 기지를 여기까지 내려오다니 제법이군."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_officer" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_admin/defeated" true
          say npc {
            ko_kr: "본부에 보고해야겠군…"
          }
        } else {
          say npc {
            ko_kr: "침입자는 지상으로 돌려보내 주지."
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
