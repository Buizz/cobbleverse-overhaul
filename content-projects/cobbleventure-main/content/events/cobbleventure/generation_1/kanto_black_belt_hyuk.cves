event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/kanto_black_belt_hyuk/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/kanto_black_belt_hyuk/defeated") {
    say npc {
      ko_kr: "석영고원은 단련된 자만 지나갈 수 있다!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/kanto_black_belt_hyuk" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_black_belt_hyuk/defeated" true
      say npc {
        ko_kr: "좋다! 네 수련은 진짜로군!"
      }
    } else {
      say npc {
        ko_kr: "정신과 몸을 함께 단련하고 돌아와라!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/kanto_black_belt_hyuk/defeated") {
    say npc {
      ko_kr: "좋다! 네 수련은 진짜로군!"
    }
  }

  page default {
    say npc {
      ko_kr: "석영고원은 단련된 자만 지나갈 수 있다!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/kanto_black_belt_hyuk" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_black_belt_hyuk/defeated" true
          say npc {
            ko_kr: "좋다! 네 수련은 진짜로군!"
          }
        } else {
          say npc {
            ko_kr: "정신과 몸을 함께 단련하고 돌아와라!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
