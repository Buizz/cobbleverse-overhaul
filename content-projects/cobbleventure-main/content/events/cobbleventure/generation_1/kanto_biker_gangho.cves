event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "이 길을 지나려면 우리 독 포켓몬부터 상대해!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/kanto_biker_gangho" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_biker_gangho/defeated" true
      say npc {
        ko_kr: "흥, 제법인데!"
      }
    } else {
      say npc {
        ko_kr: "우리 구역에선 방심하면 안 된다고!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "흥, 제법인데!"
    }
  }

  page default {
    say npc {
      ko_kr: "이 길을 지나려면 우리 독 포켓몬부터 상대해!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/kanto_biker_gangho" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_biker_gangho/defeated" true
          say npc {
            ko_kr: "흥, 제법인데!"
          }
        } else {
          say npc {
            ko_kr: "우리 구역에선 방심하면 안 된다고!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
