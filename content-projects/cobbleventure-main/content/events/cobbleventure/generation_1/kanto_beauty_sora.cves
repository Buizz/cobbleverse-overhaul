event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "예쁘게 키운 포켓몬의 실력도 확인해 볼래?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/kanto_beauty_sora" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_beauty_sora/defeated" true
      say npc {
        ko_kr: "멋지고 우아한 승부였어."
      }
    } else {
      say npc {
        ko_kr: "겉모습만 보고 얕보면 곤란해."
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "멋지고 우아한 승부였어."
    }
  }

  page default {
    say npc {
      ko_kr: "예쁘게 키운 포켓몬의 실력도 확인해 볼래?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/kanto_beauty_sora" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_beauty_sora/defeated" true
          say npc {
            ko_kr: "멋지고 우아한 승부였어."
          }
        } else {
          say npc {
            ko_kr: "겉모습만 보고 얕보면 곤란해."
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
