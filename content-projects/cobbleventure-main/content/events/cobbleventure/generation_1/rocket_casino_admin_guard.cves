event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated") {
    say npc { ko_kr: "관리자님께는 손끝 하나 대지 못한다!" }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_casino_admin_guard" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated" true
      say npc { ko_kr: "호위 임무에 실패하다니…" }
    } else {
      say npc { ko_kr: "여기서 침입은 끝이다!" }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated") {
    say npc { ko_kr: "호위 임무에 실패하다니…" }
  }
  page default {
    say npc { ko_kr: "관리자님께는 손끝 하나 대지 못한다!" }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_casino_admin_guard" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_admin_guard/defeated" true
          say npc { ko_kr: "호위 임무에 실패하다니…" }
        } else {
          say npc { ko_kr: "여기서 침입은 끝이다!" }
        }
      }
      { ko_kr: "다음에 도전한다" } { stop }
    }
  }
}
