event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_guard/defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/rocket_casino_guard/defeated") {
    say npc {
      ko_kr: "손님은 여기까지다. 아래층은 로켓단 전용이야!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_grunt" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_guard/defeated" true
      say npc {
        ko_kr: "비밀 계단까지 들킨 건가…"
      }
    } else {
      say npc {
        ko_kr: "지하에는 내려갈 수 없다!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/rocket_casino_guard/defeated") {
    say npc {
      ko_kr: "비밀 계단까지 들킨 건가…"
    }
  }

  page default {
    say npc {
      ko_kr: "손님은 여기까지다. 아래층은 로켓단 전용이야!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/rocket_power_plant_grunt" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/rocket_casino_guard/defeated" true
          say npc {
            ko_kr: "비밀 계단까지 들킨 건가…"
          }
        } else {
          say npc {
            ko_kr: "지하에는 내려갈 수 없다!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
