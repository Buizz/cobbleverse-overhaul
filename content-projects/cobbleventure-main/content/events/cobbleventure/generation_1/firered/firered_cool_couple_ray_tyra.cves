event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "레이: 우리 둘이 함께라면 위대한 트레이너가 될 운명이야!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_cool_couple_ray_tyra" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cool_couple_ray_tyra/defeated" true
      say npc {
        ko_kr: "레이: 말도 안 돼! 이럴 수가! 레이: 우리를 이겼군. 위대함은 아직 멀었나 봐…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "레이: 말도 안 돼! 이럴 수가! 레이: 우리를 이겼군. 위대함은 아직 멀었나 봐…"
    }
  }

  page default {
    say npc {
      ko_kr: "레이: 우리 둘이 함께라면 위대한 트레이너가 될 운명이야!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_cool_couple_ray_tyra" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cool_couple_ray_tyra/defeated" true
          say npc {
            ko_kr: "레이: 말도 안 돼! 이럴 수가! 레이: 우리를 이겼군. 위대함은 아직 멀었나 봐…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
