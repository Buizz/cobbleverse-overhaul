event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "거기서 멈춰! 웅이를 만나려면 아직 1만 광년은 멀었어!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_camper_liam" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_camper_liam/defeated" true
      say npc {
        ko_kr: "이런! 광년은 시간이 아니라 거리였지! 제법 뜨겁군. 그래도 웅이만큼은 아니야!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "이런! 광년은 시간이 아니라 거리였지! 제법 뜨겁군. 그래도 웅이만큼은 아니야!"
    }
  }

  page default {
    say npc {
      ko_kr: "거기서 멈춰! 웅이를 만나려면 아직 1만 광년은 멀었어!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_camper_liam" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_camper_liam/defeated" true
          say npc {
            ko_kr: "이런! 광년은 시간이 아니라 거리였지! 제법 뜨겁군. 그래도 웅이만큼은 아니야!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
