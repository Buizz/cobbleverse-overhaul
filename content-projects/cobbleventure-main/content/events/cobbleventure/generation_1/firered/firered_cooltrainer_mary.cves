event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "무지개체육관에 온 걸 환영해! 여기의 상냥한 숙녀들을 얕보지 마."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_mary" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_mary/defeated" true
      say npc {
        ko_kr: "어머! 져 버렸어! 가장 강한 포켓몬은 데려오지 않았어. 다음에는 다를걸!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "어머! 져 버렸어! 가장 강한 포켓몬은 데려오지 않았어. 다음에는 다를걸!"
    }
  }

  page default {
    say npc {
      ko_kr: "무지개체육관에 온 걸 환영해! 여기의 상냥한 숙녀들을 얕보지 마."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_mary" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_mary/defeated" true
          say npc {
            ko_kr: "어머! 져 버렸어! 가장 강한 포켓몬은 데려오지 않았어. 다음에는 다를걸!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
