event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "…아까 여기 안을 엿보던 사람 아니야?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_picnicker_tina" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_tina/defeated" true
      say npc {
        ko_kr: "정말 눈이 번쩍 뜨이는 실력이네! 민화를 보고 있었구나… 나는 아니고…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "정말 눈이 번쩍 뜨이는 실력이네! 민화를 보고 있었구나… 나는 아니고…"
    }
  }

  page default {
    say npc {
      ko_kr: "…아까 여기 안을 엿보던 사람 아니야?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_picnicker_tina" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_tina/defeated" true
          say npc {
            ko_kr: "정말 눈이 번쩍 뜨이는 실력이네! 민화를 보고 있었구나… 나는 아니고…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
