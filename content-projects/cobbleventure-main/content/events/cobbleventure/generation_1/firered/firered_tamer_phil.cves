event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_tamer_phil/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_tamer_phil/defeated") {
    say npc {
      ko_kr: "거기 멈춰! 연분홍체육관의 유명한 보이지 않는 벽 때문에 답답하지?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_tamer_phil" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_tamer_phil/defeated" true
      say npc {
        ko_kr: "오! 알아냈구나! 힌트를 주지. 보이지 않는 벽의 틈을 자세히 살펴봐!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_tamer_phil/defeated") {
    say npc {
      ko_kr: "오! 알아냈구나! 힌트를 주지. 보이지 않는 벽의 틈을 자세히 살펴봐!"
    }
  }

  page default {
    say npc {
      ko_kr: "거기 멈춰! 연분홍체육관의 유명한 보이지 않는 벽 때문에 답답하지?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_tamer_phil" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_tamer_phil/defeated" true
          say npc {
            ko_kr: "오! 알아냈구나! 힌트를 주지. 보이지 않는 벽의 틈을 자세히 살펴봐!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
