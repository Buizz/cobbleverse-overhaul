event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_hiker_wayne/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_hiker_wayne/defeated") {
    say npc {
      ko_kr: "이수재를 만나러 간다고? 그 전에 나와 승부다!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_hiker_wayne" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_hiker_wayne/defeated" true
      say npc {
        ko_kr: "보통이 아니군. 아래쪽 길은 블루시티로 가는 지름길이야."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_hiker_wayne/defeated") {
    say npc {
      ko_kr: "보통이 아니군. 아래쪽 길은 블루시티로 가는 지름길이야."
    }
  }

  page default {
    say npc {
      ko_kr: "이수재를 만나러 간다고? 그 전에 나와 승부다!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_hiker_wayne" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_hiker_wayne/defeated" true
          say npc {
            ko_kr: "보통이 아니군. 아래쪽 길은 블루시티로 가는 지름길이야."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
