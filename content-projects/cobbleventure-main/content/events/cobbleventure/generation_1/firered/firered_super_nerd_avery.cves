event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_super_nerd_avery/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_super_nerd_avery/defeated") {
    say npc {
      ko_kr: "포켓몬을 철저히 연구했어. 네가 이길 리 없어!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_avery" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_avery/defeated" true
      say npc {
        ko_kr: "으아! 공부가 부족했어! 내 이론은 네가 이해하기엔 너무 복잡해."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_super_nerd_avery/defeated") {
    say npc {
      ko_kr: "으아! 공부가 부족했어! 내 이론은 네가 이해하기엔 너무 복잡해."
    }
  }

  page default {
    say npc {
      ko_kr: "포켓몬을 철저히 연구했어. 네가 이길 리 없어!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_avery" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_avery/defeated" true
          say npc {
            ko_kr: "으아! 공부가 부족했어! 내 이론은 네가 이해하기엔 너무 복잡해."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
