event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_juggler_nate/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_juggler_nate/defeated") {
    say npc {
      ko_kr: "내 특수 기술을 이겨 낼 수 있는지 보자!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_juggler_nate" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_juggler_nate/defeated" true
      say npc {
        ko_kr: "완전히 속았군! 독과 잠처럼 승부 뒤에도 남는 기술이 좋아!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_juggler_nate/defeated") {
    say npc {
      ko_kr: "완전히 속았군! 독과 잠처럼 승부 뒤에도 남는 기술이 좋아!"
    }
  }

  page default {
    say npc {
      ko_kr: "내 특수 기술을 이겨 낼 수 있는지 보자!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_juggler_nate" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_juggler_nate/defeated" true
          say npc {
            ko_kr: "완전히 속았군! 독과 잠처럼 승부 뒤에도 남는 기술이 좋아!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
