event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_juggler_nelson/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_juggler_nelson/defeated") {
    say npc {
      ko_kr: "사천왕에게 도전하러 가는 모양이군?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_juggler_nelson" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_juggler_nelson/defeated" true
      say npc {
        ko_kr: "당했군! 네 라이벌도 이곳을 지나갔어."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_juggler_nelson/defeated") {
    say npc {
      ko_kr: "당했군! 네 라이벌도 이곳을 지나갔어."
    }
  }

  page default {
    say npc {
      ko_kr: "사천왕에게 도전하러 가는 모양이군?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_juggler_nelson" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_juggler_nelson/defeated" true
          say npc {
            ko_kr: "당했군! 네 라이벌도 이곳을 지나갔어."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
