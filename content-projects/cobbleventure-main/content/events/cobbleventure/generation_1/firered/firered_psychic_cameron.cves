event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "초련은 어리지만 뛰어난 관장이야. 쉽게 만나지는 못할걸!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_psychic_cameron" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_psychic_cameron/defeated" true
      say npc {
        ko_kr: "으윽! 완전히 졌어! 예전 노랑시티에는 체육관이 둘이었지만 격투도장이 우리에게 져서 자격을 잃었지."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "으윽! 완전히 졌어! 예전 노랑시티에는 체육관이 둘이었지만 격투도장이 우리에게 져서 자격을 잃었지."
    }
  }

  page default {
    say npc {
      ko_kr: "초련은 어리지만 뛰어난 관장이야. 쉽게 만나지는 못할걸!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_psychic_cameron" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_psychic_cameron/defeated" true
          say npc {
            ko_kr: "으윽! 완전히 졌어! 예전 노랑시티에는 체육관이 둘이었지만 격투도장이 우리에게 져서 자격을 잃었지."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
