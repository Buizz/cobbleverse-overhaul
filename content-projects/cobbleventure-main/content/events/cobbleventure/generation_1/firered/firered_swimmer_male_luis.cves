event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_swimmer_male_luis/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_swimmer_male_luis/defeated") {
    say npc {
      ko_kr: "첨벙! 내가 첫 상대다! 시작하자!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_swimmer_male_luis" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_swimmer_male_luis/defeated" true
      say npc {
        ko_kr: "그럴 리가! 이슬이는 계속 성장하는 트레이너야. 너 같은 상대에게 지지 않아!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_swimmer_male_luis/defeated") {
    say npc {
      ko_kr: "그럴 리가! 이슬이는 계속 성장하는 트레이너야. 너 같은 상대에게 지지 않아!"
    }
  }

  page default {
    say npc {
      ko_kr: "첨벙! 내가 첫 상대다! 시작하자!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_swimmer_male_luis" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_swimmer_male_luis/defeated" true
          say npc {
            ko_kr: "그럴 리가! 이슬이는 계속 성장하는 트레이너야. 너 같은 상대에게 지지 않아!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
