event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_caroline/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_caroline/defeated") {
    say npc {
      ko_kr: "네 실력이 얼마나 대단한지 보여 주지. 대단하지 않다는 걸!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_caroline" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_caroline/defeated" true
      say npc {
        ko_kr: "정말 화나! 오히려 네가 내 실력이 어느 정도인지 보여 줬네…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_cooltrainer_caroline/defeated") {
    say npc {
      ko_kr: "정말 화나! 오히려 네가 내 실력이 어느 정도인지 보여 줬네…"
    }
  }

  page default {
    say npc {
      ko_kr: "네 실력이 얼마나 대단한지 보여 주지. 대단하지 않다는 걸!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_caroline" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_caroline/defeated" true
          say npc {
            ko_kr: "정말 화나! 오히려 네가 내 실력이 어느 정도인지 보여 줬네…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
