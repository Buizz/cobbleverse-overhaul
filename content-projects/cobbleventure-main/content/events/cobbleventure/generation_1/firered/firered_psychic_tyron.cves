event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "힘만으로 포켓몬 세계에서 이길 수 없다는 걸 알고 있겠지?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_psychic_tyron" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_psychic_tyron/defeated" true
      say npc {
        ko_kr: "믿을 수 없어! 초련은 바로 옆의 격투대왕을 단숨에 쓰러뜨렸어."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "믿을 수 없어! 초련은 바로 옆의 격투대왕을 단숨에 쓰러뜨렸어."
    }
  }

  page default {
    say npc {
      ko_kr: "힘만으로 포켓몬 세계에서 이길 수 없다는 걸 알고 있겠지?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_psychic_tyron" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_psychic_tyron/defeated" true
          say npc {
            ko_kr: "믿을 수 없어! 초련은 바로 옆의 격투대왕을 단숨에 쓰러뜨렸어."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
