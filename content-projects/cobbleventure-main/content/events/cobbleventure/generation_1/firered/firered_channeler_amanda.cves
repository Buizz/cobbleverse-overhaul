event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_channeler_amanda/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_channeler_amanda/defeated") {
    say npc {
      ko_kr: "초련은 나보다 훨씬 어리지만 존경할 만한 실력자야."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_channeler_amanda" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_channeler_amanda/defeated" true
      say npc {
        ko_kr: "아직 부족했군! 대등한 승부에서는 의지가 강한 쪽이 이겨. 초련을 이기려면 정신을 집중해."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_channeler_amanda/defeated") {
    say npc {
      ko_kr: "아직 부족했군! 대등한 승부에서는 의지가 강한 쪽이 이겨. 초련을 이기려면 정신을 집중해."
    }
  }

  page default {
    say npc {
      ko_kr: "초련은 나보다 훨씬 어리지만 존경할 만한 실력자야."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_channeler_amanda" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_channeler_amanda/defeated" true
          say npc {
            ko_kr: "아직 부족했군! 대등한 승부에서는 의지가 강한 쪽이 이겨. 초련을 이기려면 정신을 집중해."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
