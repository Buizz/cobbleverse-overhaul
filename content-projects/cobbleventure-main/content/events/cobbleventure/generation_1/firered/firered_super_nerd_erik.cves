event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "포켓몬의 불꽃 숨결이 얼마나 뜨거운지 알아?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_erik" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_erik/defeated" true
      say npc {
        ko_kr: "앗 뜨거! 너무 뜨거워! 불꽃, 정확히는 연소란… 공기 중 산소가… 어쩌고저쩌고…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "앗 뜨거! 너무 뜨거워! 불꽃, 정확히는 연소란… 공기 중 산소가… 어쩌고저쩌고…"
    }
  }

  page default {
    say npc {
      ko_kr: "포켓몬의 불꽃 숨결이 얼마나 뜨거운지 알아?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_erik" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_erik/defeated" true
          say npc {
            ko_kr: "앗 뜨거! 너무 뜨거워! 불꽃, 정확히는 연소란… 공기 중 산소가… 어쩌고저쩌고…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
