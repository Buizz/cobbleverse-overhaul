event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_tamer_cole/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_tamer_cole/defeated") {
    say npc {
      ko_kr: "내 채찍 소리에 네 포켓몬은 벌벌 떨 거다!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_tamer_cole" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_tamer_cole/defeated" true
      say npc {
        ko_kr: "아야! 채찍에 맞은 기분이군! 잠깐! 방심했을 뿐이야!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_tamer_cole/defeated") {
    say npc {
      ko_kr: "아야! 채찍에 맞은 기분이군! 잠깐! 방심했을 뿐이야!"
    }
  }

  page default {
    say npc {
      ko_kr: "내 채찍 소리에 네 포켓몬은 벌벌 떨 거다!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_tamer_cole" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_tamer_cole/defeated" true
          say npc {
            ko_kr: "아야! 채찍에 맞은 기분이군! 잠깐! 방심했을 뿐이야!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
