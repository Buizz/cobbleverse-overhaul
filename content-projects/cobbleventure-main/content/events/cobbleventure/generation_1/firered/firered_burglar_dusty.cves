event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_bad_guys"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "여러 체육관에 가 봤지만 여기가 내 방식에 가장 잘 맞아."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_burglar_dusty" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_burglar_dusty/defeated" true
      say npc {
        ko_kr: "으악! 너무 뜨거워! 포니타와 나인테일은 인기 있는 불꽃 포켓몬이지."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "으악! 너무 뜨거워! 포니타와 나인테일은 인기 있는 불꽃 포켓몬이지."
    }
  }

  page default {
    say npc {
      ko_kr: "여러 체육관에 가 봤지만 여기가 내 방식에 가장 잘 맞아."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_burglar_dusty" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_burglar_dusty/defeated" true
          say npc {
            ko_kr: "으악! 너무 뜨거워! 포니타와 나인테일은 인기 있는 불꽃 포켓몬이지."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
