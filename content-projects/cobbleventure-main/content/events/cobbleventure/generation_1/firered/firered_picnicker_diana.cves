event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "뭐야, 너? 이슬이가 나설 필요도 없이 내가 충분해!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_picnicker_diana" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_diana/defeated" true
      say npc {
        ko_kr: "완전히 압도당했어! 다른 트레이너와 싸워 봐야 자신의 실력을 알 수 있어."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "완전히 압도당했어! 다른 트레이너와 싸워 봐야 자신의 실력을 알 수 있어."
    }
  }

  page default {
    say npc {
      ko_kr: "뭐야, 너? 이슬이가 나설 필요도 없이 내가 충분해!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_picnicker_diana" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_diana/defeated" true
          say npc {
            ko_kr: "완전히 압도당했어! 다른 트레이너와 싸워 봐야 자신의 실력을 알 수 있어."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
