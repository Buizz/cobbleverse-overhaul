event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "여기를 통과하면 사천왕을 만날 수 있어."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_pokemaniac_dawson" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_pokemaniac_dawson/defeated" true
      say npc {
        ko_kr: "말도 안 돼! 그래도 포켓몬 지식만큼은 내가 더 뛰어나!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "말도 안 돼! 그래도 포켓몬 지식만큼은 내가 더 뛰어나!"
    }
  }

  page default {
    say npc {
      ko_kr: "여기를 통과하면 사천왕을 만날 수 있어."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_pokemaniac_dawson" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_pokemaniac_dawson/defeated" true
          say npc {
            ko_kr: "말도 안 돼! 그래도 포켓몬 지식만큼은 내가 더 뛰어나!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
