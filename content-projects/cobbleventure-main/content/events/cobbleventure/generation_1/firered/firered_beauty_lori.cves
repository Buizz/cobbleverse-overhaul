event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_beauty_lori/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_beauty_lori/defeated") {
    say npc {
      ko_kr: "만나서 반가워. 내 취미는 포켓몬 육성이야."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_beauty_lori" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_beauty_lori/defeated" true
      say npc {
        ko_kr: "어머! 훌륭해! 곧 소개팅이 있어서 예의 바르게 행동하는 법을 배우는 중이야."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_beauty_lori/defeated") {
    say npc {
      ko_kr: "어머! 훌륭해! 곧 소개팅이 있어서 예의 바르게 행동하는 법을 배우는 중이야."
    }
  }

  page default {
    say npc {
      ko_kr: "만나서 반가워. 내 취미는 포켓몬 육성이야."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_beauty_lori" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_beauty_lori/defeated" true
          say npc {
            ko_kr: "어머! 훌륭해! 곧 소개팅이 있어서 예의 바르게 행동하는 법을 배우는 중이야."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
