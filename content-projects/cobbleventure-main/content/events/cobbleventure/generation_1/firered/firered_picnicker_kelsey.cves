event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_picnicker_kelsey/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_picnicker_kelsey/defeated") {
    say npc {
      ko_kr: "안녕! 내 남자친구는 정말 멋져!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_picnicker_kelsey" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_kelsey/defeated" true
      say npc {
        ko_kr: "내 컨디션이 별로였나 봐… 내 남자친구도 너만큼 강했으면 좋겠다."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_picnicker_kelsey/defeated") {
    say npc {
      ko_kr: "내 컨디션이 별로였나 봐… 내 남자친구도 너만큼 강했으면 좋겠다."
    }
  }

  page default {
    say npc {
      ko_kr: "안녕! 내 남자친구는 정말 멋져!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_picnicker_kelsey" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_picnicker_kelsey/defeated" true
          say npc {
            ko_kr: "내 컨디션이 별로였나 봐… 내 남자친구도 너만큼 강했으면 좋겠다."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
