event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "강연이 왜 트레이너가 됐는지 알고 있어."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_derek" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_derek/defeated" true
      say npc {
        ko_kr: "아야! 산에서 길을 잃은 강연을 불꽃새 포켓몬의 빛이 안전하게 인도했대."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "아야! 산에서 길을 잃은 강연을 불꽃새 포켓몬의 빛이 안전하게 인도했대."
    }
  }

  page default {
    say npc {
      ko_kr: "강연이 왜 트레이너가 됐는지 알고 있어."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_super_nerd_derek" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_super_nerd_derek/defeated" true
          say npc {
            ko_kr: "아야! 산에서 길을 잃은 강연을 불꽃새 포켓몬의 빛이 안전하게 인도했대."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
