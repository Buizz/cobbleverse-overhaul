event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "어이! 잘 지냈냐? 네 실력이 늘었는지 확인하러 왔어!"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_rival_cerulean_charmander" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_rival_cerulean_charmander/defeated" true
      say npc {
        ko_kr: "흥! 너무 힘을 뺐나? 이수재에게 가는 길이라면 아직 멀었어. 냄새나 맡고 있어!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "흥! 너무 힘을 뺐나? 이수재에게 가는 길이라면 아직 멀었어. 냄새나 맡고 있어!"
    }
  }

  page default {
    say npc {
      ko_kr: "어이! 잘 지냈냐? 네 실력이 늘었는지 확인하러 왔어!"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_rival_cerulean_charmander" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_rival_cerulean_charmander/defeated" true
          say npc {
            ko_kr: "흥! 너무 힘을 뺐나? 이수재에게 가는 길이라면 아직 멀었어. 냄새나 맡고 있어!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
