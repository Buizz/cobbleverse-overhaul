event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_gentleman_tucker/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_gentleman_tucker/defeated") {
    say npc {
      ko_kr: "군대에 있을 때 마티스는 엄격한 상관이었지. 아주 혹독했어."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_gentleman_tucker" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_gentleman_tucker/defeated" true
      say npc {
        ko_kr: "그만! 정말 훌륭하군! 문을 여는 건 쉽지 않아. 마티스는 군대에서도 늘 신중하기로 유명했지."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_gentleman_tucker/defeated") {
    say npc {
      ko_kr: "그만! 정말 훌륭하군! 문을 여는 건 쉽지 않아. 마티스는 군대에서도 늘 신중하기로 유명했지."
    }
  }

  page default {
    say npc {
      ko_kr: "군대에 있을 때 마티스는 엄격한 상관이었지. 아주 혹독했어."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_gentleman_tucker" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_gentleman_tucker/defeated" true
          say npc {
            ko_kr: "그만! 정말 훌륭하군! 문을 여는 건 쉽지 않아. 마티스는 군대에서도 늘 신중하기로 유명했지."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
