event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_lass_reli/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_lass_reli/defeated") {
    say npc {
      ko_kr: "나는 4번! 슬슬 지치지 않았어?"
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_lass_reli" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_lass_reli/defeated" true
      say npc {
        ko_kr: "나도 져 버렸네! 최선을 다했으니 후회 없어!"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_lass_reli/defeated") {
    say npc {
      ko_kr: "나도 져 버렸네! 최선을 다했으니 후회 없어!"
    }
  }

  page default {
    say npc {
      ko_kr: "나는 4번! 슬슬 지치지 않았어?"
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_lass_reli" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_lass_reli/defeated" true
          say npc {
            ko_kr: "나도 져 버렸네! 최선을 다했으니 후회 없어!"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
