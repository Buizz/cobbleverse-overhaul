event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_naomi/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_naomi/defeated") {
    say npc {
      ko_kr: "네가 내 상대가 될 만큼 강한지 궁금하네."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_naomi" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_naomi/defeated" true
      say npc {
        ko_kr: "져 버렸어… 누구에게도, 특히 어린아이에게는 지고 싶지 않았는데…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_cooltrainer_naomi/defeated") {
    say npc {
      ko_kr: "져 버렸어… 누구에게도, 특히 어린아이에게는 지고 싶지 않았는데…"
    }
  }

  page default {
    say npc {
      ko_kr: "네가 내 상대가 될 만큼 강한지 궁금하네."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_naomi" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_naomi/defeated" true
          say npc {
            ko_kr: "져 버렸어… 누구에게도, 특히 어린아이에게는 지고 싶지 않았는데…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
