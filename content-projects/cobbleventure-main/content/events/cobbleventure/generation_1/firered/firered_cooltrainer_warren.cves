event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_warren/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_cooltrainer_warren/defeated") {
    say npc {
      ko_kr: "진정한 실력자는 멋지게 이기는 법이지."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_warren" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_warren/defeated" true
      say npc {
        ko_kr: "내가 중심을 잃었군! 이렇게 지면 관장님께 혼나겠어…"
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_cooltrainer_warren/defeated") {
    say npc {
      ko_kr: "내가 중심을 잃었군! 이렇게 지면 관장님께 혼나겠어…"
    }
  }

  page default {
    say npc {
      ko_kr: "진정한 실력자는 멋지게 이기는 법이지."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_cooltrainer_warren" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_cooltrainer_warren/defeated" true
          say npc {
            ko_kr: "내가 중심을 잃었군! 이렇게 지면 관장님께 혼나겠어…"
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
