event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_youngster_joey/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/firered_youngster_joey/defeated") {
    say npc {
      ko_kr: "이 근처 트레이너들은 여기서 연습해."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/firered_youngster_joey" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_youngster_joey/defeated" true
      say npc {
        ko_kr: "제법인데. 강한 포켓몬에게도 약점은 있어. 여러 타입을 함께 키우는 게 좋아."
      }
    } else {
      say npc {
        ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/firered_youngster_joey/defeated") {
    say npc {
      ko_kr: "제법인데. 강한 포켓몬에게도 약점은 있어. 여러 타입을 함께 키우는 게 좋아."
    }
  }

  page default {
    say npc {
      ko_kr: "이 근처 트레이너들은 여기서 연습해."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/firered_youngster_joey" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/firered_youngster_joey/defeated" true
          say npc {
            ko_kr: "제법인데. 강한 포켓몬에게도 약점은 있어. 여러 타입을 함께 키우는 게 좋아."
          }
        } else {
          say npc {
            ko_kr: "이번 승부는 내가 이겼어. 다시 준비해서 도전해!"
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
