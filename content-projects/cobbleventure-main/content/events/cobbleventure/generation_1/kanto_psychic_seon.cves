event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:flag/trainer/kanto_psychic_seon/defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:flag/trainer/kanto_psychic_seon/defeated") {
    say npc {
      ko_kr: "네가 올 것을 이미 알고 있었어."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/kanto_psychic_seon" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_psychic_seon/defeated" true
      say npc {
        ko_kr: "이 결과는 읽지 못했군."
      }
    } else {
      say npc {
        ko_kr: "마음이 흔들리면 다음 수도 보이지 않아."
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:flag/trainer/kanto_psychic_seon/defeated") {
    say npc {
      ko_kr: "이 결과는 읽지 못했군."
    }
  }

  page default {
    say npc {
      ko_kr: "네가 올 것을 이미 알고 있었어."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/kanto_psychic_seon" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_psychic_seon/defeated" true
          say npc {
            ko_kr: "이 결과는 읽지 못했군."
          }
        } else {
          say npc {
            ko_kr: "마음이 흔들리면 다음 수도 보이지 않아."
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
