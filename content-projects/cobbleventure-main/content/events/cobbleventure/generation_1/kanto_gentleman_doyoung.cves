event proximity_enter(range: 9, group: "trainer_battle", stage: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    encounter_warning "encounter.trainer_boy"
  }
}

event proximity_enter(range: 6, group: "trainer_battle", after: "warning") {
  page when !flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "여행길의 예의 바른 승부를 청하겠네."
    }
    id "proximity/challenge/battle" await battle "cobbleventure:battle/kanto_gentleman_doyoung" -> battle_result
    if battle_result.outcome == "win" {
      id "proximity/victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
      id "proximity/victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_gentleman_doyoung/defeated" true
      say npc {
        ko_kr: "훌륭한 실력이군. 경의를 표하지."
      }
    } else {
      say npc {
        ko_kr: "침착함을 잃지 않는 것이 중요하다네."
      }
    }
  }
}

event interact(range: 4) {
  page when flag("cobbleventure:runtime/npc_instance_defeated") {
    say npc {
      ko_kr: "훌륭한 실력이군. 경의를 표하지."
    }
  }

  page default {
    say npc {
      ko_kr: "여행길의 예의 바른 승부를 청하겠네."
    }
    choice { ko_kr: "도전하시겠습니까?" } {
      { ko_kr: "승부한다" } {
        id "challenge/battle" await battle "cobbleventure:battle/kanto_gentleman_doyoung" -> battle_result
        if battle_result.outcome == "win" {
          id "victory/set_instance_defeated" set_flag "cobbleventure:runtime/npc_instance_defeated" true
          id "victory/set_defeated" set_flag "cobbleventure:flag/trainer/kanto_gentleman_doyoung/defeated" true
          say npc {
            ko_kr: "훌륭한 실력이군. 경의를 표하지."
          }
        } else {
          say npc {
            ko_kr: "침착함을 잃지 않는 것이 중요하다네."
          }
        }
      }
      { ko_kr: "다음에 도전한다" } {
        stop
      }
    }
  }
}
