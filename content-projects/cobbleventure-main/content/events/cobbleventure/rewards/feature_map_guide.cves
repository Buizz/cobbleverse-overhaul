event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/feature/map") {
    say npc {
      ko_kr: "길이 헷갈리면 메뉴에서 지도를 펼쳐 봐. 마을과 길의 위치를 확인하면 다음 목적지를 찾기 쉬울 거야."
    }
  }

  page default {
    say npc {
      ko_kr: "상록시티에 처음 왔구나! 여행 중이라면 이 마을지도를 가져가. 처음 가는 길에서도 도움이 될 거야."
    }
    id "grant/feature" unlock_feature map
    id "grant/state" set_flag "cobbleventure:flag/rewards/feature/map" true
    say npc {
      ko_kr: "이제 메뉴에서 지도를 펼칠 수 있어. 마을과 길을 살펴보고 다음 목적지를 정해 봐!"
    }
  }
}
