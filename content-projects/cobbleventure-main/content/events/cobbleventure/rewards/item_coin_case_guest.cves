event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/item/coin_case_guest") {
    say npc {
      ko_kr: "동전은 정해 둔 만큼만 쓰게. 게임에 너무 빠지면 곤란하니까."
    }
  }

  page default {
    say npc {
      ko_kr: "난 이제 게임을 그만뒀네. 자네가 쓸 생각이라면 이 동전케이스를 가져가게."
    }
    id "first/give_item" give_item "cobbleventure_casino:coin_case" count 1 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 보상을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/rewards/item/coin_case_guest" true
  }
}
