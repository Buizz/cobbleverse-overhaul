event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/feature/pc") {
    say npc {
      ko_kr: "원격 PC 연결은 정상 작동 중이야. 플레이어 메뉴에서 PC를 선택하면 돼."
    }
  }

  page default {
    say npc {
      ko_kr: "나는 이수재야. 포켓몬 전송 시스템을 연구하고 있지."
    }
    say npc {
      ko_kr: "PC를 사용하면 파티에 데리고 다니지 않는 포켓몬을 박스에 맡기거나, 맡긴 포켓몬을 다시 꺼낼 수 있어."
    }
    say npc {
      ko_kr: "네 사용자 정보를 전송망에 등록해 둘게. 그러면 플레이어 메뉴에서도 원격으로 PC를 열 수 있어."
    }
    id "grant/feature" unlock_feature pc
    id "grant/state" set_flag "cobbleventure:flag/rewards/feature/pc" true
    say npc {
      ko_kr: "등록 완료! 이제 플레이어 메뉴의 PC를 선택하면 어디서든 포켓몬 박스를 이용할 수 있어."
    }
  }
}
