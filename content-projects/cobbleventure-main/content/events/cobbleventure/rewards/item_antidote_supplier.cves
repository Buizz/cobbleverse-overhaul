event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/item/antidote_supplier") {
    say npc {
      ko_kr: "독에 걸리면 늦기 전에 해독제를 사용해."
    }
  }

  page default {
    say npc {
      ko_kr: "숲과 동굴에는 독을 쓰는 포켓몬이 많아. 해독제를 챙겨 가."
    }
    id "first/give_item" give_item "cobblemon:antidote" count 2 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 보상을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/rewards/item/antidote_supplier" true
  }
}
