event interact(range: 4) {
  page when !flag("cobbleventure:flag/story/starter_received") {
    say npc {
      ko_kr: "오박사님과 먼저 이야기해 보세요. 첫 파트너를 정하면 여행에 필요한 물품을 챙겨 드릴게요."
    }
  }

  page when flag("cobbleventure:flag/rewards/item/pokeball_supplier") {
    say npc {
      ko_kr: "야생 포켓몬은 체력을 줄이거나 상태 이상으로 만들면 훨씬 잡기 쉬워져요."
    }
  }

  page default {
    say npc {
      ko_kr: "첫 파트너를 정했군요. 오박사님이 초보 트레이너를 위해 준비한 몬스터볼이에요. 야생 포켓몬을 만났을 때 사용해 보세요."
    }
    id "first/give_item" give_item "cobblemon:poke_ball" count 5 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 몬스터볼을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/rewards/item/pokeball_supplier" true
  }
}
