event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/item/potion_supplier") {
    say npc {
      ko_kr: "상처약은 필요한 순간 바로 쓸 수 있게 정리해 두세요."
    }
  }

  page default {
    say npc {
      ko_kr: "모험 중에는 작은 상처도 방심하면 안 돼요. 상처약을 챙겨 가세요."
    }
    id "first/give_item" give_item "cobblemon:potion" count 3 notify -> reward
    if reward.remaining_count > 0 {
      narrate "가방에 빈 공간이 없어 보상을 모두 받을 수 없습니다."
      stop
    }
    id "first/set_claimed" set_flag "cobbleventure:flag/rewards/item/potion_supplier" true
  }
}
