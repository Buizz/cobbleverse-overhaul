event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/field_move/fly") {
    say npc {
      ko_kr: "석영고원까지 올라온 트레이너라면 공중날기를 맡겨도 안심이야."
    }
  }

  page default {
    say npc {
      ko_kr: "석영고원에 처음 도착했구나. 먼 길을 다시 걸어 내려갈 필요가 없도록 공중날기를 허가해 줄게."
    }
    id "grant/field_move" grant_field_move fly -> granted
    id "grant/state" set_flag "cobbleventure:flag/rewards/field_move/fly" true
    say npc {
      ko_kr: "이제 방문한 장소를 오갈 때 공중날기를 이용할 수 있어."
    }
  }
}
