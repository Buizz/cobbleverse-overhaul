event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/feature/settlement_teleport") {
    say npc {
      ko_kr: "순간이동으로 갈 수 있는 곳은 네가 직접 방문해 기억한 마을뿐이야."
    }
  }

  page default {
    say npc {
      ko_kr: "달맞이산을 넘어오느라 고생했구나. 집으로 돌아가고 싶을 때 쓸 수 있도록 순간이동을 가르쳐 줄게."
    }
    id "grant/feature" unlock_feature settlement_teleport
    id "grant/state" set_flag "cobbleventure:flag/rewards/feature/settlement_teleport" true
    say npc {
      ko_kr: "이제 지도에서 네가 방문한 마을을 골라 순간이동할 수 있어."
    }
  }
}
