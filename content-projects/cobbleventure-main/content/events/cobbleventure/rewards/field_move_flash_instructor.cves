event interact(range: 4) {
  page when flag("cobbleventure:flag/rewards/field_move/flash") {
    say npc {
      ko_kr: "빛이 있어도 발밑은 항상 조심해."
    }
  }

  page default {
    say npc {
      ko_kr: "어두운 동굴에서는 주변을 밝히는 기술이 필요해. 플래시 사용법을 알려 줄게."
    }
    id "grant/field_move" grant_field_move flash -> granted
    id "grant/state" set_flag "cobbleventure:flag/rewards/field_move/flash" true
    say npc {
      ko_kr: "이제 어두운 장소에서 플래시를 사용할 수 있어."
    }
  }
}
