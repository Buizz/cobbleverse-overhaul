{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/gacha_ticket_vendor",
  "enabled": true,
  "name": {"ko_kr": "가챠 티켓 교환상", "en_us": "Gacha Ticket Vendor"},
  "description": {
    "ko_kr": "동전케이스를 확인하고 카지노 칩을 모든 카지노에서 사용하는 종류별 공통 물리 가챠 티켓으로 교환합니다.",
    "en_us": "Checks the Coin Case and exchanges casino chips for physical shared tickets usable at every casino."
  },
  "tags": ["service", "casino", "gacha", "building_runtime"],
  "placement_profile": {
    "classification": "ambient",
    "preferred_biomes": [],
    "automatic_town_placement": false,
    "automatic_route_placement": false
  },
  "npc": {
    "display_name": {"ko_kr": "가챠 티켓 교환상", "en_us": "Gacha Ticket Vendor"},
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/waiter",
    "appearance": {
      "source": "custom",
      "type": "skin",
      "resource": "cobbleventure:trainer_skin/waiter",
      "arm_model": "slim"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "invulnerable": true,
      "collision": true
    }
  },
  "event_runtime": {
    "engine": "cves_v5",
    "authoring": "custom",
    "script_id": "cobbleventure:event_script/facilities/gacha_ticket_vendor"
  },
  "event_design": {"mode": "easy_npc_events"},
  "events": [{
    "id": "on_interact",
    "trigger": {"type": "interact", "range": 4},
    "commands": [{
      "type": "dialogue",
      "id": "fallback",
      "speaker": "npc",
      "text": {
        "ko_kr": "가챠 티켓 교환에는 동전케이스가 필요합니다.",
        "en_us": "A Coin Case is required for gacha ticket exchange."
      }
    }, {"type": "end"}]
  }]
}
