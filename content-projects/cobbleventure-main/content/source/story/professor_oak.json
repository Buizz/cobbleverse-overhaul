{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/professor_oak",
  "enabled": true,
  "name": {
    "ko_kr": "오박사",
    "en_us": "Professor Oak"
  },
  "description": {
    "ko_kr": "태초마을 연구소에서 플레이어의 첫 포켓몬 선택을 돕는 오박사입니다."
  },
  "tags": [
    "story",
    "required",
    "professor",
    "starter"
  ],
  "placement_profile": {
    "classification": "ambient",
    "preferred_biomes": [],
    "automatic_town_placement": false,
    "automatic_route_placement": false
  },
  "npc": {
    "display_name": {
      "ko_kr": "오박사",
      "en_us": "Professor Oak"
    },
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/scientist",
    "appearance": {
      "source": "rct_single",
      "type": "skin",
      "resource": "rctmod:trainers/single/prof_prof_oak_01ff"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "invulnerable": true,
      "collision": true
    }
  },
  "event_runtime": {
    "engine": "cves_v5",
    "authoring": "custom",
    "script_id": "cobbleventure:event_script/story/professor_oak"
  },
  "event_design": {
    "mode": "easy_npc_events"
  },
  "events": [
    {
      "id": "on_interact",
      "trigger": {
        "type": "interact",
        "range": 4
      },
      "commands": [
        {
          "type": "label",
          "name": "greeting"
        },
        {
          "type": "branch",
          "conditions": [
            {
              "type": "flag_equals",
              "key": "cobbleventure:flag/story/pokedex_received",
              "value": true
            }
          ],
          "target": "starter_received"
        },
        {
          "type": "branch",
          "conditions": [
            {
              "type": "flag_equals",
              "key": "cobbleventure:flag/story/starter_received",
              "value": true
            }
          ],
          "target": "starter_chosen"
        },
        {
          "type": "dialogue",
          "id": "greeting_1",
          "speaker": "npc",
          "text": {
            "ko_kr": "어서 오너라! 나는 포켓몬을 연구하는 오박사란다.",
            "en_us": "Welcome! I'm Professor Oak, a Pokémon researcher."
          }
        },
        {
          "type": "dialogue",
          "id": "greeting_2",
          "speaker": "npc",
          "text": {
            "ko_kr": "이제 너와 함께 모험할 첫 포켓몬을 정해 보자꾸나!",
            "en_us": "Let's choose the first Pokémon that will join you on your adventure!"
          }
        },
        {
          "type": "start_starter_roulette",
          "target": "starter_chosen_praise"
        },
        {
          "type": "end"
        },
        {
          "type": "label",
          "name": "starter_chosen"
        },
        {
          "type": "dialogue",
          "id": "starter_chosen_praise",
          "speaker": "npc",
          "text": {
            "ko_kr": "좋은 포켓몬을 골랐구나!",
            "en_us": "You chose a fine Pokémon!"
          }
        },
        {
          "type": "dialogue",
          "id": "pokedex_offer",
          "speaker": "npc",
          "text": {
            "ko_kr": "그럼 이것도 받아라. 포켓몬 도감이란다.",
            "en_us": "Then take this as well. It's a Pokédex."
          }
        },
        {
          "type": "give_item",
          "item": "cobblemon:pokedex_red",
          "count": 1
        },
        {
          "type": "set_flag",
          "key": "cobbleventure:flag/story/pokedex_received",
          "value": true
        },
        {
          "type": "dialogue",
          "id": "pokedex_explanation",
          "speaker": "npc",
          "text": {
            "ko_kr": "포켓몬 도감은 만난 포켓몬과 잡은 포켓몬의 정보를 자동으로 기록해 준단다. 여러 포켓몬을 만나 도감을 완성해 보렴!",
            "en_us": "The Pokédex automatically records information about Pokémon you meet and catch. Meet many Pokémon and try to complete it!"
          }
        },
        {
          "type": "end"
        },
        {
          "type": "label",
          "name": "starter_received"
        },
        {
          "type": "dialogue",
          "id": "starter_received",
          "speaker": "npc",
          "text": {
            "ko_kr": "이미 첫 포켓몬을 골랐구나. 그 아이와 함께 멋진 모험을 해 보렴!",
            "en_us": "You've already chosen your first Pokémon. Have a wonderful adventure together!"
          }
        },
        {
          "type": "end"
        }
      ]
    }
  ]
}
