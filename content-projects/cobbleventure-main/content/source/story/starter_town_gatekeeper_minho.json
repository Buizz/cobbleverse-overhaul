{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/starter_town_gatekeeper_minho",
  "enabled": true,
  "name": { "ko_kr": "태초마을 길지기 민호" },
  "description": { "ko_kr": "첫 파트너를 확인하고 태초마을을 떠나는 트레이너에게 포켓내비를 건네는 문지기입니다." },
  "tags": ["story", "required", "gatekeeper", "starter_town", "key_item"],
  "placement_profile": {
    "classification": "ambient",
    "preferred_biomes": ["minecraft:plains"],
    "automatic_town_placement": false,
    "automatic_route_placement": false
  },
  "npc": {
    "display_name": { "ko_kr": "길지기 민호" },
    "role": "gatekeeper",
    "trainer_class": "cobbleventure:trainer_class/pokemon_ranger_male",
    "appearance": {
      "source": "custom",
      "type": "skin",
      "resource": "cobbleventure:trainer_skin/police_officer",
      "arm_model": "classic"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "invulnerable": true,
      "collision": true
    }
  },
  "event_runtime": {
    "engine": "cves_v5",
    "authoring": "custom",
    "script_id": "cobbleventure:event_script/story/starter_town_gatekeeper_minho"
  },
  "event_design": { "mode": "easy_npc_events" },
  "events": [{
    "id": "on_interact",
    "trigger": { "type": "interact", "range": 4 },
    "commands": [
      {
        "type": "branch",
        "conditions": [{
          "type": "flag_equals",
          "key": "cobbleventure:flag/story/starter_received",
          "value": false
        }],
        "target": "needs_partner"
      },
      {
        "type": "branch",
        "conditions": [{
          "type": "flag_equals",
          "key": "cobbleventure:flag/story/pokenav_received",
          "value": true
        }],
        "target": "ready"
      },
      {
        "type": "dialogue",
        "id": "offer",
        "speaker": "npc",
        "text": { "ko_kr": "이제 출발하는구나! 오박사님이 네가 마을을 나설 때 전해 달라며 포켓내비를 맡기셨어." }
      },
      { "type": "give_item", "item": "cobblenav:pokenav_item_red", "count": 1 },
      { "type": "set_flag", "key": "cobbleventure:flag/story/pokenav_received", "value": true },
      {
        "type": "dialogue",
        "id": "explanation",
        "speaker": "npc",
        "text": { "ko_kr": "포켓내비를 사용하면 주변에 사는 포켓몬을 찾는 데 도움이 될 거야. 첫 여행, 조심해서 다녀와!" }
      },
      { "type": "end" },
      { "type": "label", "name": "needs_partner" },
      {
        "type": "dialogue",
        "id": "needs_partner",
        "speaker": "npc",
        "text": { "ko_kr": "이 앞부터는 야생 포켓몬이 나타나. 오박사님께 첫 파트너를 받은 뒤 다시 오렴." }
      },
      { "type": "end" },
      { "type": "label", "name": "ready" },
      {
        "type": "dialogue",
        "id": "ready",
        "speaker": "npc",
        "text": { "ko_kr": "파트너와 포켓내비도 준비됐네. 길에서 어떤 포켓몬을 만날지 기대되는걸!" }
      },
      { "type": "end" }
    ]
  }]
}
