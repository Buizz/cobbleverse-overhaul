{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/field_move_flash_instructor", "enabled": true,
  "name": { "ko_kr": "동굴 조사원" },
  "description": { "ko_kr": "플레이어에게 플래시 사용 권한을 한 번 지급하는 수동 배치 NPC입니다." },
  "tags": ["reward", "field_move", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": {
    "display_name": { "ko_kr": "동굴 조사원" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/scientist",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/scientist_ivan_015b" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true }
  },
  "event_runtime": { "engine": "easy_npc_v4", "authoring": "custom" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/field_move/flash", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "어두운 동굴에서는 주변을 밝히는 기술이 필요해. 플래시 사용법을 알려 줄게." } },
    { "type": "grant_field_move", "move": "flash" },
    { "type": "set_flag", "key": "cobbleventure:flag/rewards/field_move/flash", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 어두운 장소에서 플래시를 사용할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "빛이 있어도 발밑은 항상 조심해." } }, { "type": "end" }
  ] }]
}
