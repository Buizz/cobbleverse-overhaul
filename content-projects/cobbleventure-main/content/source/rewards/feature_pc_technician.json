{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/feature_pc_technician", "enabled": true,
  "name": { "ko_kr": "이수재" }, "description": { "ko_kr": "25번도로 끝의 집에서 PC를 설명하고 원격 PC 기능을 해금하는 이수재입니다." },
  "tags": ["reward", "menu_feature", "bill", "fixed_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "이수재" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/scientist",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/scientist_rodney_0153" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "cves_v5", "authoring": "custom", "script_id": "cobbleventure:event_script/rewards/feature_pc_technician" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/feature/pc", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "introduction", "speaker": "npc", "text": { "ko_kr": "나는 이수재야. 포켓몬 전송 시스템을 연구하고 있지." } },
    { "type": "dialogue", "id": "pc_explanation", "speaker": "npc", "text": { "ko_kr": "PC를 사용하면 파티에 데리고 다니지 않는 포켓몬을 박스에 맡기거나, 맡긴 포켓몬을 다시 꺼낼 수 있어." } },
    { "type": "dialogue", "id": "remote_explanation", "speaker": "npc", "text": { "ko_kr": "네 사용자 정보를 전송망에 등록해 둘게. 그러면 플레이어 메뉴에서도 원격으로 PC를 열 수 있어." } },
    { "type": "unlock_feature", "feature": "pc" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/feature/pc", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "등록 완료! 이제 플레이어 메뉴의 PC를 선택하면 어디서든 포켓몬 박스를 이용할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "원격 PC 연결은 정상 작동 중이야. 플레이어 메뉴에서 PC를 선택하면 돼." } }, { "type": "end" }
  ] }]
}
