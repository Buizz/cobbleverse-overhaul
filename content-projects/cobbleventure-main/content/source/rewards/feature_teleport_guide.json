{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/feature_teleport_guide", "enabled": true,
  "name": { "ko_kr": "블루시티 초능력자" }, "description": { "ko_kr": "달맞이산을 넘어온 플레이어에게 방문한 마을로 순간이동하는 권한을 지급합니다." },
  "tags": ["reward", "menu_feature", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "초능력자" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/psychic",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/psychic_johan_0118" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "cves_v5", "authoring": "custom", "script_id": "cobbleventure:event_script/rewards/feature_teleport_guide" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/feature/settlement_teleport", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "달맞이산을 넘어오느라 고생했구나. 집으로 돌아가고 싶을 때 쓸 수 있도록 순간이동을 가르쳐 줄게." } },
    { "type": "unlock_feature", "feature": "settlement_teleport" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/feature/settlement_teleport", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 지도에서 네가 방문한 마을을 골라 순간이동할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "순간이동으로 갈 수 있는 곳은 네가 직접 방문해 기억한 마을뿐이야." } }, { "type": "end" }
  ] }]
}
