{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/field_move_defog_instructor", "enabled": true,
  "name": { "ko_kr": "안개 관측가" }, "description": { "ko_kr": "플레이어에게 안개제거 사용 권한을 한 번 지급하는 수동 배치 NPC입니다." },
  "tags": ["reward", "field_move", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "안개 관측가" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/psychic",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/psychic_johan_0118" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "cves_v5", "authoring": "custom", "script_id": "cobbleventure:event_script/rewards/field_move_defog_instructor" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/field_move/defog", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "짙은 안개도 흐름을 읽으면 걷어낼 수 있어. 안개제거 방법을 알려 주지." } },
    { "type": "grant_field_move", "move": "defog" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/field_move/defog", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 짙은 안개를 만났을 때 안개제거를 사용할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "안개가 걷혀도 서두르지는 마." } }, { "type": "end" }
  ] }]
}
