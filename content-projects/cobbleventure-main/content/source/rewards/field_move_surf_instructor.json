{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/field_move_surf_instructor", "enabled": true,
  "name": { "ko_kr": "수상 안전요원" }, "description": { "ko_kr": "플레이어에게 파도타기 사용 권한을 한 번 지급하는 수동 배치 NPC입니다." },
  "tags": ["reward", "field_move", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "수상 안전요원" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/swimmer_male",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/swimmerm_roland_00f8" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "easy_npc_v4", "authoring": "custom" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/field_move/surf", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "물살을 읽고 포켓몬에게 몸을 맡기는 게 중요해. 파도타기 안전수칙을 알려 줄게." } },
    { "type": "grant_field_move", "move": "surf" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/field_move/surf", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 물가에서 파도타기를 사용할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "먼바다로 나가기 전에는 반드시 날씨를 확인해." } }, { "type": "end" }
  ] }]
}
