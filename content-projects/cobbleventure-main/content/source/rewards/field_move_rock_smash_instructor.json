{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/rewards/field_move_rock_smash_instructor",
  "enabled": true,
  "name": { "ko_kr": "바위 작업반장" },
  "description": { "ko_kr": "플레이어에게 바위깨기 사용 권한을 한 번 지급하는 수동 배치 NPC입니다." },
  "tags": ["reward", "field_move", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": {
    "display_name": { "ko_kr": "바위 작업반장" },
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/hiker",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/hiker_alan_00b9" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true }
  },
  "event_runtime": { "engine": "easy_npc_v4", "authoring": "custom" },
  "event_design": { "mode": "easy_npc_events" },
  "events": [{
    "id": "on_interact",
    "trigger": { "type": "interact", "range": 4 },
    "commands": [
      { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/field_move/rock_smash", "value": true }], "target": "claimed" },
      { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "금이 간 바위는 힘보다 요령이 중요하지. 바위깨기 요령을 알려 주마." } },
      { "type": "grant_field_move", "move": "rock_smash" },
      { "type": "set_flag", "key": "cobbleventure:flag/rewards/field_move/rock_smash", "value": true },
      { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 금이 간 바위를 조사하면 바위깨기를 사용할 수 있을 거다." } },
      { "type": "end" },
      { "type": "label", "name": "claimed" },
      { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "바위의 금을 잘 보고 힘을 한곳에 모아라." } },
      { "type": "end" }
    ]
  }]
}
