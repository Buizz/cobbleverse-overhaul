{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/field_move_rock_climb_instructor", "enabled": true,
  "name": { "ko_kr": "절벽 등반가" }, "description": { "ko_kr": "플레이어에게 락클라임 사용 권한을 한 번 지급하는 수동 배치 NPC입니다." },
  "tags": ["reward", "field_move", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "절벽 등반가" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/hiker",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/hiker_jeremy_01d1" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "cves_v5", "authoring": "custom", "script_id": "cobbleventure:event_script/rewards/field_move_rock_climb_instructor" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/field_move/rock_climb", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "가파른 벽도 발 디딜 곳은 있어. 락클라임 경로를 찾는 법을 알려 주마." } },
    { "type": "grant_field_move", "move": "rock_climb" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/field_move/rock_climb", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 오를 수 있는 절벽에서 락클라임을 사용할 수 있다." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "오르기 전에 내려올 길도 먼저 살펴라." } }, { "type": "end" }
  ] }]
}
