{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/feature_map_guide", "enabled": true,
  "name": { "ko_kr": "상록시티 여행 안내원" }, "description": { "ko_kr": "상록시티 마을 안에서 여행자에게 마을지도를 건네고 지도 메뉴를 해금하는 NPC입니다." },
  "tags": ["reward", "menu_feature", "resident", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "여행 안내원" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/pokemon_ranger_male",
    "appearance": { "source": "custom", "type": "skin", "resource": "cobbleventure:trainer_skin/pokemon_ranger_male" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "cves_v5", "authoring": "custom", "script_id": "cobbleventure:event_script/rewards/feature_map_guide" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/feature/map", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "상록시티에 처음 왔구나! 여행 중이라면 이 마을지도를 가져가. 처음 가는 길에서도 도움이 될 거야." } },
    { "type": "unlock_feature", "feature": "map" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/feature/map", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 메뉴에서 지도를 펼칠 수 있어. 마을과 길을 살펴보고 다음 목적지를 정해 봐!" } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "길이 헷갈리면 메뉴에서 지도를 펼쳐 봐. 마을과 길의 위치를 확인하면 다음 목적지를 찾기 쉬울 거야." } }, { "type": "end" }
  ] }]
}
