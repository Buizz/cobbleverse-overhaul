{
  "$schema": "../../schemas/npc-event-script.schema.json", "schema_version": 4,
  "id": "cobbleventure:npc/rewards/feature_map_guide", "enabled": true,
  "name": { "ko_kr": "지도 제작자" }, "description": { "ko_kr": "플레이어 메뉴의 지도 기능을 한 번 해금하는 수동 배치 NPC입니다." },
  "tags": ["reward", "menu_feature", "manual_placement"],
  "placement_profile": { "classification": "ambient", "preferred_biomes": [], "automatic_town_placement": false, "automatic_route_placement": false },
  "npc": { "display_name": { "ko_kr": "지도 제작자" }, "role": "default", "trainer_class": "cobbleventure:trainer_class/gentleman",
    "appearance": { "source": "rct_single", "type": "skin", "resource": "rctmod:trainers/single/gentleman_arthur_01a6" },
    "behavior": { "movement": "stationary", "look_at_player": true, "invulnerable": true, "collision": true } },
  "event_runtime": { "engine": "easy_npc_v4", "authoring": "custom" }, "event_design": { "mode": "easy_npc_events" },
  "events": [{ "id": "on_interact", "trigger": { "type": "interact", "range": 4 }, "commands": [
    { "type": "branch", "conditions": [{ "type": "flag_equals", "key": "cobbleventure:flag/rewards/feature/map", "value": true }], "target": "claimed" },
    { "type": "dialogue", "id": "offer", "speaker": "npc", "text": { "ko_kr": "처음 가는 길이라면 기록을 남겨야지. 네 메뉴에 지도를 등록해 줄게." } },
    { "type": "unlock_feature", "feature": "map" }, { "type": "set_flag", "key": "cobbleventure:flag/rewards/feature/map", "value": true },
    { "type": "dialogue", "id": "granted", "speaker": "npc", "text": { "ko_kr": "이제 메뉴에서 지도를 확인할 수 있어." } }, { "type": "end" },
    { "type": "label", "name": "claimed" }, { "type": "dialogue", "id": "repeat", "speaker": "npc", "text": { "ko_kr": "새로운 장소를 발견할 때마다 지도를 확인해 봐." } }, { "type": "end" }
  ] }]
}
