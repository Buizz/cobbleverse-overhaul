{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/sample_antidote_giver",
  "enabled": true,
  "name": {
    "ko_kr": "해독제를 나눠주는 약초꾼"
  },
  "description": {
    "ko_kr": "해독제을(를) 플레이어당 한 번 지급하는 테스트용 NPC입니다."
  },
  "tags": [
    "sample",
    "ambient",
    "item_giver"
  ],
  "placement_profile": {
    "classification": "ambient",
    "preferred_biomes": [
      "minecraft:forest"
    ],
    "automatic_town_placement": true,
    "automatic_route_placement": false
  },
  "npc": {
    "display_name": {
      "ko_kr": "해독제를 나눠주는 약초꾼"
    },
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/picnicker",
    "appearance": {
      "source": "custom",
      "type": "skin",
      "resource": "cobbleventure:trainer_skin/picnicker"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "invulnerable": true,
      "collision": true
    }
  },
  "events": [
    {
      "id": "on_interact",
      "trigger": {
        "type": "interact",
        "range": 4
      },
      "commands": [
        {
          "type": "branch",
          "conditions": [
            {
              "type": "flag_equals",
              "key": "cobbleventure:flag/sample/sample_antidote_giver/claimed",
              "value": true
            }
          ],
          "target": "already_received"
        },
        {
          "type": "label",
          "name": "greeting"
        },
        {
          "type": "dialogue",
          "id": "greeting",
          "speaker": "npc",
          "text": {
            "ko_kr": "숲에는 독을 쓰는 포켓몬이 많아. 이 해독제를 가져가."
          }
        },
        {
          "type": "give_item",
          "item": "cobblemon:antidote",
          "count": 2
        },
        {
          "type": "set_flag",
          "key": "cobbleventure:flag/sample/sample_antidote_giver/claimed",
          "value": true
        },
      {
        "type": "label",
        "name": "already_received"
        },
        {
          "type": "dialogue",
          "id": "already_received",
          "speaker": "npc",
          "text": {
            "ko_kr": "숲에서는 독 상태를 조심해. 해독제는 이미 건넸단다."
          }
        },
        {
          "type": "label",
          "name": "end"
        },
        {
          "type": "end"
        }
      ]
    }
  ]
}
