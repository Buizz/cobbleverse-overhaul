{
  "$schema": "../../schemas/npc-event-script.schema.json",
  "schema_version": 4,
  "id": "cobbleventure:npc/sample_hiker_seok",
  "enabled": true,
  "name": {
    "ko_kr": "등산가 석"
  },
  "description": {
    "ko_kr": "레벨 12의 단일 포켓몬으로 반복 대전할 수 있는 테스트용 기본 트레이너입니다."
  },
  "tags": [
    "sample",
    "trainer",
    "basic_battle"
  ],
  "placement_profile": {
    "classification": "trainer",
    "expected_level": 12,
    "preferred_biomes": [
      "minecraft:stony_peaks",
      "minecraft:dripstone_caves"
    ],
    "automatic_town_placement": false,
    "automatic_route_placement": true
  },
  "npc": {
    "display_name": {
      "ko_kr": "등산가 석"
    },
    "role": "default",
    "trainer_class": "cobbleventure:trainer_class/youngster",
    "appearance": {
      "source": "rct_single",
      "type": "skin",
      "resource": "rctmod:trainers/single/hiker_alan_00b9"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "invulnerable": true,
      "collision": true
    }
  },
  "events": [
    {
      "id": "on_interact",
      "trigger": {
        "type": "interact",
        "range": 4
      },
      "commands": [
        {
          "type": "label",
          "name": "greeting"
        },
        {
          "type": "dialogue",
          "id": "greeting",
          "speaker": "npc",
          "text": {
            "ko_kr": "산길에서 단련한 근성을 받아 봐라!"
          }
        },
        {
          "type": "choices",
          "options": [
            {
              "id": "battle",
              "text": {
                "ko_kr": "승부한다"
              },
              "target": "battle"
            },
            {
              "id": "cancel",
              "text": {
                "ko_kr": "다음에"
              },
              "target": "end"
            }
          ]
        },
        {
          "type": "label",
          "name": "battle"
        },
        {
          "type": "start_battle",
          "battle": "cobbleventure:battle/sample_hiker_seok",
          "results": {
            "player_win": "victory",
            "player_loss": "defeat",
            "cancelled": "end"
          }
        },
        {
          "type": "label",
          "name": "victory"
        },
        {
          "type": "set_flag",
          "key": "cobbleventure:flag/trainer/sample_hiker_seok/defeated",
          "value": true
        },
        {
          "type": "dialogue",
          "id": "victory",
          "speaker": "npc",
          "text": {
            "ko_kr": "좋은 승부였어! 다음에 다시 겨뤄 보자."
          }
        },
        {
          "type": "goto",
          "target": "end"
        },
        {
          "type": "label",
          "name": "defeat"
        },
        {
          "type": "dialogue",
          "id": "defeat",
          "speaker": "npc",
          "text": {
            "ko_kr": "멋진 승부였어. 준비가 되면 언제든 다시 도전해!"
          }
        },
        {
          "type": "label",
          "name": "end"
        },
        {
          "type": "end"
        }
      ]
    }
  ]
}
