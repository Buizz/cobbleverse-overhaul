{
  "multipart": [
    { "when": {"facing":"north"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_core", "uvlock":true} },
    { "when": {"facing":"east"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_core", "uvlock":true, "y":90} },
    { "when": {"facing":"south"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_core", "uvlock":true, "y":180} },
    { "when": {"facing":"west"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_core", "uvlock":true, "y":270} },

    { "when": {"facing":"north", "left":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_right_end", "uvlock":true} },
    { "when": {"facing":"east", "left":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_right_end", "uvlock":true, "y":90} },
    { "when": {"facing":"south", "left":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_right_end", "uvlock":true, "y":180} },
    { "when": {"facing":"west", "left":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_right_end", "uvlock":true, "y":270} },

    { "when": {"facing":"north", "right":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_left_end", "uvlock":true} },
    { "when": {"facing":"east", "right":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_left_end", "uvlock":true, "y":90} },
    { "when": {"facing":"south", "right":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_left_end", "uvlock":true, "y":180} },
    { "when": {"facing":"west", "right":"false"}, "apply": {"model":"cobbleventure_theme_blocks:block/professor_lab_connecting_bookshelf_left_end", "uvlock":true, "y":270} }
  ]
