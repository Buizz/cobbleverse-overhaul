{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/dependencies-lock.schema.json",
  "title": "Cobbleventure dependency lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "profile", "minecraft", "mods", "content_packs"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "enum": ["draft", "locked"] },
    "profile": { "type": "string", "minLength": 1 },
    "minecraft": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "loader"],
      "properties": {
        "version": { "type": ["string", "null"] },
        "loader": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "version"],
          "properties": {
            "type": { "const": "neoforge" },
            "version": { "type": ["string", "null"] }
          }
        }
      }
    },
    "mods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "classification",
          "side",
          "enabled",
          "version",
          "curseforge",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": ["required", "required-candidate", "optional", "profile-optional", "development"]
          },
          "side": { "enum": ["client", "server", "both"] },
          "enabled": { "type": "boolean" },
          "version": { "type": ["string", "null"] },
          "curseforge": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "file_id"],
            "properties": {
              "project_id": { "type": ["integer", "null"], "minimum": 1 },
              "file_id": { "type": ["integer", "null"], "minimum": 1 }
            }
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "content_packs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "display_name",
          "kind",
          "classification",
          "side",
          "selected",
          "version",
          "artifact_format",
          "packaging_status",
          "runtime_status",
          "modrinth",
          "install_path",
          "vendored_path",
          "source_url",
          "sha1",
          "sha512",
          "license",
          "reason"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_-]*$" },
          "display_name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["datapack", "resourcepack", "mod"] },
          "classification": {
            "enum": ["required", "required-candidate", "optional", "profile-optional", "development"]
          },
          "side": { "enum": ["client", "server", "both"] },
          "selected": { "type": "boolean" },
          "version": { "type": ["string", "null"] },
          "artifact_format": { "enum": ["zip", "fabric_mod", "neoforge_mod"] },
          "packaging_status": { "enum": ["ready", "blocked"] },
          "runtime_status": { "enum": ["ready", "blocked"] },
          "modrinth": {
            "type": "object",
            "additionalProperties": false,
            "required": ["project_id", "version_id"],
            "properties": {
              "project_id": { "type": ["string", "null"], "minLength": 1 },
              "version_id": { "type": ["string", "null"], "minLength": 1 }
            }
          },
          "install_path": { "enum": ["datapacks", "resourcepacks", "mods"] },
          "vendored_path": { "type": ["string", "null"], "minLength": 1 },
          "source_url": { "type": "string", "format": "uri", "minLength": 1 },
          "sha1": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "sha512": { "type": "string", "pattern": "^[0-9a-f]{128}$" },
          "license": { "type": "string", "minLength": 1 },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
