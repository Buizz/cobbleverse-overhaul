{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/content-bundle.schema.json",
  "title": "Cobbleventure trainer encounter content bundle",
  "description": "트레이너 NPC 한 명의 외형, 배치, 전투, 대화와 진행 결과를 함께 관리하는 기준 데이터",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "enabled",
    "name",
    "tags",
    "npc",
    "battle",
    "dialogue",
    "progression",
    "outcomes"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 2 },
    "id": { "$ref": "#/$defs/resource_id" },
    "enabled": { "type": "boolean" },
    "name": { "$ref": "#/$defs/localized_text" },
    "description": { "$ref": "#/$defs/localized_text" },
    "tags": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
    },
    "npc": { "$ref": "#/$defs/npc" },
    "battle": { "$ref": "#/$defs/battle" },
    "dialogue": { "$ref": "#/$defs/dialogue_graph" },
    "progression": { "$ref": "#/$defs/progression" },
    "outcomes": { "$ref": "#/$defs/outcomes" },
    "rewards": { "$ref": "#/$defs/rewards" },
    "export_overrides": {
      "type": "object",
      "description": "기준 데이터로 표현할 수 없는 대상별 임시 설정. 일반 콘텐츠에는 사용하지 않는다.",
      "additionalProperties": false,
      "properties": {
        "rct": { "type": "object" },
        "easy_npc": { "type": "object" }
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "vector3": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "z": { "type": "number" }
      }
    },
    "npc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["display_name", "trainer_class", "appearance", "behavior"],
      "properties": {
        "display_name": { "$ref": "#/$defs/localized_text" },
        "role": { "enum": ["default", "gatekeeper"] },
        "trainer_class": { "$ref": "#/$defs/resource_id" },
        "character": { "$ref": "#/$defs/resource_id" },
        "battle_rewards": {
          "type": "object",
          "additionalProperties": false,
          "required": ["money"],
          "properties": {
            "money": { "$ref": "#/$defs/npc_money_reward" }
          }
        },
        "double_battle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["partner", "group_id", "shared_clear_key"],
          "properties": {
            "partner": { "$ref": "#/$defs/resource_id" },
            "group_id": { "$ref": "#/$defs/resource_id" },
            "shared_clear_key": { "$ref": "#/$defs/resource_id" }
          }
        },
        "appearance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source", "type", "resource"],
          "properties": {
            "source": { "enum": ["custom", "rct_single", "rct_group"] },
            "type": { "enum": ["skin", "model"] },
            "resource": { "$ref": "#/$defs/resource_id" },
            "portrait": { "$ref": "#/$defs/resource_id" }
          }
        },
        "behavior": {
          "type": "object",
          "additionalProperties": false,
          "required": ["movement", "look_at_player", "invulnerable"],
          "properties": {
            "movement": { "enum": ["stationary", "wander", "patrol"] },
            "look_at_player": { "type": "boolean" },
            "invulnerable": { "type": "boolean" },
            "collision": { "type": "boolean" }
          }
        }
      }
    },
    "npc_money_reward": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "mode", "held_item_bonus", "conditions"],
      "properties": {
        "enabled": { "type": "boolean" },
        "mode": { "enum": ["fixed", "regional_level"] },
        "amount": { "type": "integer", "minimum": 0 },
        "fallback_region_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "per_level": { "type": "integer", "minimum": 0 },
        "offset": { "type": "integer" },
        "held_item_bonus": { "type": "boolean" },
        "held_item": { "$ref": "#/$defs/resource_id" },
        "held_item_multiplier": { "type": "integer", "minimum": 1 },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "fixed" } } },
          "then": { "required": ["amount"] },
          "else": { "required": ["fallback_region_level", "per_level", "offset"] }
        },
        {
          "if": { "properties": { "held_item_bonus": { "const": true } } },
          "then": { "required": ["held_item", "held_item_multiplier"] }
        }
      ]
    },
    "battle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trainer_id",
        "format",
        "battle_type",
        "ai",
        "level_mode",
        "rules",
        "bag",
        "mechanics",
        "team"
      ],
      "properties": {
        "trainer_id": { "$ref": "#/$defs/resource_id" },
        "format": { "enum": ["GEN_9_SINGLES", "GEN_9_DOUBLES"] },
        "battle_type": { "enum": ["singles", "doubles"] },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["controller", "difficulty", "strategy", "options"],
          "properties": {
            "controller": { "const": "cobbleventure" },
            "difficulty": {
              "enum": ["novice", "standard", "advanced", "expert", "expert_winrate", "expert_search", "cheater"]
            },
            "strategy": {
              "enum": ["balanced", "aggressive", "defensive", "ace_check", "reckless_ace", "setup", "hazard", "tempo", "unpredictable"]
            },
            "options": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "cheat_probability": { "type": "number", "minimum": 0, "maximum": 1 }
              }
            }
          },
          "allOf": [
            {
              "if": { "properties": { "difficulty": { "const": "cheater" } } },
              "then": { "properties": { "options": { "required": ["cheat_probability"] } } },
              "else": { "properties": { "options": { "not": { "required": ["cheat_probability"] } } } }
            }
          ]
        },
        "level_mode": { "enum": ["fixed", "scale_to_player", "cap_to_player"] },
        "rules": {
          "type": "object",
          "properties": {
            "max_item_uses": { "type": "integer", "minimum": 0 }
          }
        },
        "bag": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["item", "quantity"],
            "properties": {
              "item": { "$ref": "#/$defs/resource_id" },
              "quantity": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "mechanics": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mega_evolution", "z_move", "dynamax", "terastallization"],
          "properties": {
            "mega_evolution": { "type": "boolean" },
            "z_move": { "type": "boolean" },
            "dynamax": { "type": "boolean" },
            "terastallization": { "type": "boolean" }
          }
        },
        "team": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/pokemon" }
        }
      }
    },
    "pokemon": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "not": {
            "required": ["held_item", "gimmick"],
            "properties": {
              "held_item": { "type": "string" },
              "gimmick": { "type": "object" }
            }
          }
        }
      ],
      "required": ["species", "level", "gender", "moves", "tera_type", "shiny"],
      "properties": {
        "species": { "$ref": "#/$defs/resource_id" },
        "level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "form": { "type": ["string", "null"] },
        "aspects": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "gender": { "enum": ["male", "female", "genderless", "random"] },
        "nature": { "type": ["string", "null"] },
        "ability": { "type": ["string", "null"] },
        "held_item": {
          "oneOf": [
            { "$ref": "#/$defs/resource_id" },
            { "type": "null" }
          ]
        },
        "gimmick": {
          "description": "메가진화 또는 Z기술 사용 의도. RCT 출력 시 item을 실제 소지품으로 변환한다.",
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "item"],
              "properties": {
                "type": { "enum": ["mega_evolution", "z_move"] },
                "item": { "$ref": "#/$defs/resource_id" }
              }
            }
          ]
        },
        "moves": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "ivs": { "$ref": "#/$defs/ivs" },
        "evs": { "$ref": "#/$defs/evs" },
        "tera_type": {
          "description": "auto이면 RCT 출력 시 포켓몬의 원래 타입 중 하나로 확정한다.",
          "enum": [
            "auto", "normal", "fire", "water", "electric", "grass", "ice",
            "fighting", "poison", "ground", "flying", "psychic", "bug", "rock",
            "ghost", "dragon", "dark", "steel", "fairy"
          ]
        },
        "shiny": { "type": "boolean" },
        "gigantamax_factor": { "type": "boolean" }
      }
    },
    "ivs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hp": { "type": "integer", "minimum": 0, "maximum": 31 },
        "attack": { "type": "integer", "minimum": 0, "maximum": 31 },
        "defense": { "type": "integer", "minimum": 0, "maximum": 31 },
        "special_attack": { "type": "integer", "minimum": 0, "maximum": 31 },
        "special_defense": { "type": "integer", "minimum": 0, "maximum": 31 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 31 }
      }
    },
    "evs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hp": { "type": "integer", "minimum": 0, "maximum": 252 },
        "attack": { "type": "integer", "minimum": 0, "maximum": 252 },
        "defense": { "type": "integer", "minimum": 0, "maximum": 252 },
        "special_attack": { "type": "integer", "minimum": 0, "maximum": 252 },
        "special_defense": { "type": "integer", "minimum": 0, "maximum": 252 },
        "speed": { "type": "integer", "minimum": 0, "maximum": 252 }
      }
    },
    "dialogue_graph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entry", "nodes"],
      "properties": {
        "entry": { "$ref": "#/$defs/resource_id" },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/dialogue_node" }
        }
      }
    },
    "dialogue_node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "speaker", "text", "conditions", "actions", "choices"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "speaker": { "enum": ["npc", "player", "system"] },
        "text": { "$ref": "#/$defs/localized_text" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/dialogue_choice" }
        }
      }
    },
    "dialogue_choice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "conditions", "actions"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "text": { "$ref": "#/$defs/localized_text" },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "always",
            "flag_equals",
            "has_item",
            "next_dialogue",
            "close_dialogue",
            "start_battle",
            "set_flag",
            "mark_clear",
            "give_item",
            "give_money",
            "take_money",
            "grant_loot",
            "start_quest",
            "complete_quest",
            "teleport",
            "open_dialogue",
            "teleport_to_gate"
          ]
        },
        "target": { "$ref": "#/$defs/resource_id" },
        "trainer": { "$ref": "#/$defs/resource_id" },
        "battle": { "$ref": "#/$defs/resource_id" },
        "results": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "player_win": { "$ref": "#/$defs/resource_id" },
            "player_loss": { "$ref": "#/$defs/resource_id" },
            "cancelled": { "$ref": "#/$defs/resource_id" }
          }
        },
        "key": { "$ref": "#/$defs/resource_id" },
        "value": { "type": ["string", "number", "boolean"] },
        "item": { "$ref": "#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1 },
        "mode": { "enum": ["fixed", "level_cap_multiplier"] },
        "amount": { "type": "integer", "minimum": 0 },
        "multiplier": { "type": "number", "exclusiveMinimum": 0 },
        "currency_objective": { "type": "string" },
        "level_cap_objective": { "type": "string" },
        "loot_table": { "$ref": "#/$defs/resource_id" },
        "gate": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "subject": { "enum": ["player", "npc"] },
        "side": { "enum": ["front", "back", "center"] }
      }
    },
    "rewards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["money", "items"],
      "properties": {
        "money": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "amount"],
              "properties": {
                "mode": { "const": "fixed" },
                "amount": { "type": "integer", "minimum": 0 },
                "currency_objective": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "multiplier"],
              "properties": {
                "mode": { "const": "level_cap_multiplier" },
                "multiplier": { "type": "number", "exclusiveMinimum": 0 },
                "currency_objective": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" },
                "level_cap_objective": { "type": "string", "pattern": "^[A-Za-z0-9_.+-]+$" }
              }
            }
          ]
        },
        "items": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "entries"],
              "properties": {
                "mode": { "const": "fixed" },
                "entries": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["item", "count"],
                    "properties": {
                      "item": { "$ref": "#/$defs/resource_id" },
                      "count": { "type": "integer", "minimum": 1 }
                    }
                  }
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["mode", "loot_table"],
              "properties": {
                "mode": { "const": "loot_table" },
                "loot_table": { "$ref": "#/$defs/resource_id" }
              }
            }
          ]
        }
      }
    },
    "progression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requirements", "victory_flag", "rematch", "dialogue_routes"],
      "properties": {
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        },
        "victory_flag": { "$ref": "#/$defs/resource_id" },
        "rematch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "cooldown_ticks": { "type": "integer", "minimum": 0 }
          }
        },
        "dialogue_routes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["when", "entry"],
            "properties": {
              "when": { "$ref": "#/$defs/operation" },
              "entry": { "$ref": "#/$defs/resource_id" }
            }
          }
        }
      }
    },
    "outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["on_player_win", "on_player_loss"],
      "properties": {
        "on_player_win": { "$ref": "#/$defs/outcome" },
        "on_player_loss": { "$ref": "#/$defs/outcome" }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actions"],
      "properties": {
        "actions": {
          "type": "array",
          "items": { "$ref": "#/$defs/operation" }
        }
      }
    }
  }
}
