{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/pokemon-habitats.schema.json",
  "title": "Pokemon habitat catalog",
  "type": "object",
  "required": ["schema_version", "pokemon"],
  "properties": {
    "schema_version": { "const": 1 },
    "source": { "type": "object" },
    "pokemon": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dex_number", "id", "display_name", "generation", "types", "preferences", "habitats"],
        "properties": {
          "dex_number": { "type": "integer", "minimum": 1 },
          "id": { "$ref": "#/$defs/resource_id" },
          "display_name": { "type": "object", "required": ["ko_kr"] },
          "generation": { "type": "integer", "minimum": 1, "maximum": 9 },
          "types": { "type": "array", "minItems": 1, "maxItems": 2 },
          "preferences": { "type": "object" },
          "habitats": { "type": "object", "required": ["primary"] },
          "implemented": { "type": "boolean" }
        }
      }
    }
  },
  "$defs": {
    "resource_id": { "type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$" }
  }
}
