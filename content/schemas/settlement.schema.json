{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/settlement.schema.json",
  "title": "Cobbleventure settlement definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "enabled",
    "display_name",
    "region",
    "dimension",
    "town_radius_cells",
    "bounds",
    "center",
    "anchors",
    "content_profile",
    "biome_layout",
    "connections",
    "structure_profile",
    "npc_placement"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "id": { "$ref": "#/$defs/resource_id" },
    "enabled": { "type": "boolean" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "region": { "$ref": "#/$defs/resource_id" },
    "dimension": { "$ref": "#/$defs/resource_id" },
    "town_radius_cells": { "type": "integer", "enum": [1, 3, 5, 7, 19] },
    "town_footprint_shape": { "type": "string", "enum": ["triangle_up", "triangle_down", "line_q", "line_r", "line_s", "five_up", "five_down", "custom"] },
    "town_footprint_cells": {
      "type": "array", "minItems": 1, "maxItems": 19, "uniqueItems": true,
      "items": { "$ref": "#/$defs/axial_coordinate" }
    },
    "town_road_exits": {
      "type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
      "items": { "$ref": "#/$defs/axial_coordinate" }
    },
    "bounds": { "$ref": "#/$defs/horizontal_bounds" },
    "center": { "$ref": "#/$defs/block_position" },
    "anchors": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/block_position" }
    },
    "content_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pokemon", "trainers", "level_scaling"],
      "properties": {
        "pokemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spawn_profile", "density_multiplier"],
          "properties": {
            "spawn_profile": { "$ref": "#/$defs/resource_id" },
            "density_multiplier": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "biome_set": { "$ref": "#/$defs/resource_id" },
            "unconditional_spawns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } }
          }
        },
        "trainers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population_profile", "max_active", "class_pool"],
          "properties": {
            "population_profile": { "$ref": "#/$defs/resource_id" },
            "max_active": { "type": "integer", "minimum": 0, "maximum": 128 },
            "class_pool": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/resource_id" }
            }
          }
        },
        "level_scaling": { "$ref": "#/$defs/level_scaling" }
      }
    },
    "biome_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrangement", "transition_width", "zones", "boundary"],
      "properties": {
        "arrangement": { "enum": ["organic_patches", "sectors", "concentric"] },
        "transition_width": { "type": "integer", "minimum": 0, "maximum": 64 },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "items": { "$ref": "#/$defs/biome_zone" }
        },
        "boundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "connections": {
      "type": "array",
      "maxItems": 0,
      "items": { "$ref": "#/$defs/settlement_connection" }
    },
    "structure_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "gym_theme", "commercial_center", "required_facilities", "special_district", "gym"],
      "properties": {
        "structure": { "$ref": "#/$defs/resource_id" },
        "gym_theme": {
          "enum": [
            "normal", "fire", "water", "electric", "grass", "ice",
            "fighting", "poison", "ground", "flying", "psychic", "bug",
            "rock", "ghost", "dragon", "dark", "steel", "fairy"
          ]
        },
        "village_preset": {
          "deprecated": true,
          "description": "이전 마을 데이터 호환용. 새 편집 화면과 저장 데이터에서는 사용하지 않음",
          "enum": [
            "default_small", "default_mid", "default_large",
            "fighting_small", "fighting_mid", "fighting_large",
            "dark_small", "dark_mid",
            "ice_small", "ice_mid", "ice_large",
            "cobbleventure_starter"
          ]
        },
        "commercial_center": {
          "enum": ["none", "pokemart", "department_store", "preset"],
          "description": "없음·포켓몬상점·백화점 중 하나. preset은 이전 데이터 호환용"
        },
        "shop_configuration": { "$ref": "#/$defs/shop_configuration" },
        "pokemon_center_enabled": { "type": "boolean" },
        "civic_facilities_explicit": { "type": "boolean" },
        "starter_layout": {
          "deprecated": true,
          "type": "object",
          "additionalProperties": false,
          "required": ["laboratory_structure", "jigsaw_depth"],
          "properties": {
            "laboratory_structure": { "$ref": "#/$defs/resource_id" },
            "jigsaw_depth": { "type": "integer", "minimum": 0, "maximum": 4 }
          }
        },
        "house_style": {
          "$ref": "#/$defs/resource_id",
          "deprecated": true,
          "description": "이전 마을 데이터 호환용 Jigsaw 주택 풀 ID"
        },
        "layout_shape": {
          "enum": ["branching", "linear", "radial", "loop", "terraced"],
          "description": "표준 부지를 연결하는 마을 도로망 형태"
        },
        "road_profile": { "$ref": "#/$defs/road_profile" },
        "required_facilities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
          "additionalProperties": { "$ref": "#/$defs/resource_id" }
        },
        "facility_placements": {
          "type": "array",
          "items": { "$ref": "#/$defs/facility_placement" }
        },
        "facility_requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/facility_requirement" }
        },
        "special_district": {
          "$ref": "#/$defs/special_district"
        },
        "gym": {
          "$ref": "#/$defs/gym_config"
        }
      }
    },
    "npc_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_ambient_npcs",
        "default_wander_radius",
        "trainer_slots",
        "zones"
      ],
      "properties": {
        "max_ambient_npcs": { "type": "integer", "minimum": 0 },
        "default_wander_radius": { "type": "number", "minimum": 0 },
        "trainer_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/trainer_slot" }
        },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/npc_zone" }
        }
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "shop_configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_id", "vendor_units", "assignments"],
      "properties": {
        "catalog_id": { "$ref": "#/$defs/resource_id" },
        "vendor_units": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/resource_id" },
          "description": "NPC·역할·판매 품목을 함께 보존하는 판매원 카탈로그 단위 ID"
        },
        "assignments": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["slot_id", "vendor_unit"],
            "properties": {
              "slot_id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
              "vendor_unit": { "$ref": "#/$defs/resource_id" }
            }
          }
        }
      }
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "required": ["ko_kr"],
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "axial_coordinate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["q", "r"],
      "properties": {
        "q": { "type": "integer", "minimum": -8, "maximum": 8 },
        "r": { "type": "integer", "minimum": -8, "maximum": 8 }
      }
    },
    "block_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "horizontal_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x", "min_z", "max_x", "max_z"],
      "properties": {
        "min_x": { "type": "integer" },
        "min_z": { "type": "integer" },
        "max_x": { "type": "integer" },
        "max_z": { "type": "integer" }
      }
    },
    "horizontal_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "level_scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_level", "min_level", "max_level", "per_badge", "per_region", "pokemon_offset", "trainer_offset"],
      "properties": {
        "mode": { "enum": ["fixed", "badges", "region_progress", "badge_and_region", "player_average"] },
        "base_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "per_badge": { "type": "number", "minimum": 0, "maximum": 20 },
        "per_region": { "type": "number", "minimum": 0, "maximum": 30 },
        "pokemon_offset": { "type": "integer", "minimum": -50, "maximum": 50 },
        "trainer_offset": { "type": "integer", "minimum": -50, "maximum": 50 }
      }
    },
    "biome_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "biome", "size_blocks", "placement", "weight"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "biome": { "$ref": "#/$defs/resource_id" },
        "size_blocks": { "type": "integer", "minimum": 32, "maximum": 2048 },
        "placement": { "enum": ["center", "inner", "middle", "outer", "auto"] },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "offset": { "$ref": "#/$defs/horizontal_offset" },
        "habitat_profile": { "$ref": "#/$defs/resource_id" },
        "spawn_settings": { "$ref": "#/$defs/spawn_settings" }
      }
    },
    "spawn_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "habitat_variant", "temperature", "humidity", "weather", "time", "rarities", "include_secondary"],
      "properties": {
        "generation": { "type": "integer", "minimum": 0, "maximum": 9 },
        "series": { "type": "string", "pattern": "^[a-z0-9_-]+$" },
        "habitat_variant": { "type": "integer", "minimum": 0 },
        "temperature": { "enum": ["any", "cold", "cool", "temperate", "hot"] },
        "humidity": { "enum": ["any", "dry", "normal", "humid", "aquatic"] },
        "weather": { "enum": ["any", "clear", "rain", "thunder", "snow", "fog"] },
        "time": { "enum": ["any", "day", "night", "twilight"] },
        "rarities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["common", "medium", "uncommon", "rare", "legendary"] } },
        "include_secondary": { "type": "boolean" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "width", "wall_height", "wall_thickness"],
      "properties": {
        "profile": { "$ref": "#/$defs/resource_id" },
        "width": { "type": "integer", "minimum": 1, "maximum": 128 },
        "wall_height": { "type": "integer", "minimum": 3, "maximum": 128 },
        "wall_thickness": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "settlement_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_settlement", "placement", "gate_width", "path_width"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "target_settlement": { "$ref": "#/$defs/resource_id" },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preferred_side", "offset"],
          "properties": {
            "mode": { "enum": ["toward_target", "fixed_side"] },
            "preferred_side": { "enum": ["north", "south", "east", "west"] },
            "offset": { "type": "integer", "minimum": -1024, "maximum": 1024 }
          }
        },
        "gate_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "path_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "requirement": { "$ref": "#/$defs/resource_id" }
      }
    },
    "facility_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "structure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "mode": { "enum": ["instanced_entry", "direct_template", "placeholder"] },
        "structure": { "$ref": "#/$defs/resource_id" },
        "facility_type": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "footprint": { "$ref": "#/$defs/facility_footprint" },
        "clearance": { "type": "integer", "minimum": 0, "maximum": 16 },
        "anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "entry_anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "return_anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "instance_origin": { "$ref": "#/$defs/block_position" },
        "instance_entry_offset": { "$ref": "#/$defs/block_position" },
        "instance_exit_offset": { "$ref": "#/$defs/block_position" },
        "trigger_radius": { "type": "number", "minimum": 0.5, "maximum": 8 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "instanced_entry" } } },
          "then": {
            "required": [
              "entry_anchor", "return_anchor", "instance_origin",
              "instance_entry_offset", "instance_exit_offset", "trigger_radius"
            ]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "direct_template" } } },
          "then": { "required": ["anchor"] }
        },
        {
          "if": { "properties": { "mode": { "const": "placeholder" } } },
          "then": { "required": ["anchor", "facility_type", "label", "footprint"] }
        }
      ]
    },
    "facility_footprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "depth", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 8, "maximum": 96 },
        "depth": { "type": "integer", "minimum": 8, "maximum": 96 },
        "height": { "type": "integer", "minimum": 4, "maximum": 48 }
      }
    },
        "road_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "material"],
      "properties": {
        "width": { "enum": [3, 5, 7, 9] },
        "material": {
          "enum": ["cobblestone", "stone_bricks", "gravel", "packed_mud", "sandstone", "snow"]
        }
      }
    },
    "facility_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "count", "required", "footprint"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "label": { "type": "string", "minLength": 1, "maxLength": 32 },
        "count": { "type": "integer", "minimum": 1, "maximum": 8 },
        "required": { "const": true },
        "footprint": { "$ref": "#/$defs/facility_footprint" }
      }
    },
    "special_district": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "anchor", "footprint", "clearance", "building"],
      "properties": {
        "enabled": { "type": "boolean" },
        "anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "placement_mode": { "enum": ["auto", "manual"] },
        "footprint": {
          "type": "object",
          "additionalProperties": false,
          "required": ["width", "depth"],
          "properties": {
            "width": { "type": "integer", "minimum": 8, "maximum": 192 },
            "depth": { "type": "integer", "minimum": 8, "maximum": 192 }
          }
        },
        "generation_profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["seed", "depth", "basic_buildings"],
          "properties": {
            "seed": { "type": "integer", "minimum": 1, "maximum": 999999999 },
            "depth": { "type": "integer", "minimum": 1, "maximum": 7 },
            "building_density": { "enum": ["sparse", "normal", "dense", "packed"] },
            "basic_buildings": {
              "type": "array",
              "minItems": 1,
              "maxItems": 12,
              "items": { "$ref": "#/$defs/resource_id" }
            },
            "house_palette": {
              "type": "object",
              "additionalProperties": false,
              "required": ["bases", "roofs", "roof_colors"],
              "properties": {
                "bases": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": { "enum": ["one_story", "two_story", "five_story"] }
                },
                "roofs": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": { "enum": ["gable", "gambrel", "shed", "flat"] }
                },
                "roof_colors": {
                  "type": "array", "minItems": 1, "uniqueItems": true,
                  "items": { "enum": ["red", "orange", "yellow", "green", "blue", "purple", "brown", "gray", "black", "white"] }
                }
              }
            }
          }
        },
        "clearance": { "type": "integer", "minimum": 0, "maximum": 32 },
        "building": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "structure"],
          "properties": {
            "enabled": { "type": "boolean" },
            "structure": { "type": "string" }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } } },
              "then": { "properties": { "structure": { "$ref": "#/$defs/resource_id" } } }
            }
          ]
        }
      }
    },
    "gym_config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "structure", "theme", "anchor", "leader_trainer_id"],
      "properties": {
        "enabled": { "type": "boolean" },
        "gym_id": { "$ref": "#/$defs/resource_id" },
        "structure": { "type": "string" },
        "theme": {
          "enum": [
            "normal", "fire", "water", "electric", "grass", "ice",
            "fighting", "poison", "ground", "flying", "psychic", "bug",
            "rock", "ghost", "dragon", "dark", "steel", "fairy"
          ]
        },
        "anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "leader_trainer_id": { "type": "string" },
        "league_entry_id": { "type": "string" },
        "entrance": { "$ref": "#/$defs/gym_entrance" },
        "interior": { "$ref": "#/$defs/gym_interior" }
      },
      "allOf": [
        {
          "if": { "properties": { "enabled": { "const": true } } },
          "then": {
            "required": ["gym_id"],
            "properties": {
              "structure": { "$ref": "#/$defs/resource_id" }
            }
          }
        }
      ]
    },
    "gym_entrance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "door_offset": { "$ref": "#/$defs/block_position" },
        "outside_offset": { "$ref": "#/$defs/block_position" },
        "facing": { "enum": ["north", "east", "south", "west"] },
        "condition_mode": { "enum": ["all", "any"] },
        "conditions": {
          "type": "array",
          "items": { "$ref": "#/$defs/gym_condition" }
        },
        "locked_dialogue": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        },
        "enter_dialogue": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "maxLength": 256 }
        }
      }
    },
    "gym_interior": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structure": { "$ref": "#/$defs/resource_id" },
        "entry_offset": { "$ref": "#/$defs/block_position" },
        "exit_door_offset": { "$ref": "#/$defs/block_position" },
        "leader_offset": { "$ref": "#/$defs/block_position" },
        "leader_npc": { "$ref": "#/$defs/resource_id" }
      }
    },
    "gym_condition": {
      "oneOf": [
        { "$ref": "#/$defs/gym_variable_condition" },
        { "$ref": "#/$defs/gym_item_condition" },
        { "$ref": "#/$defs/gym_pokemon_condition" }
      ]
    },
    "gym_variable_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "source", "key", "operator", "value"],
      "properties": {
        "type": { "const": "variable" },
        "source": { "enum": ["scoreboard", "persistent_data"] },
        "key": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+$" },
        "operator": { "enum": ["==", "!=", ">", ">=", "<", "<="] },
        "value": { "type": "number" }
      }
    },
    "gym_item_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "item", "count"],
      "properties": {
        "type": { "const": "item" },
        "item": { "$ref": "#/$defs/resource_id" },
        "count": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "negate": { "type": "boolean" }
      }
    },
    "gym_pokemon_condition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "species"],
      "properties": {
        "type": { "const": "pokemon" },
        "species": { "$ref": "#/$defs/resource_id" },
        "negate": { "type": "boolean" }
      }
    },
    "trainer_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trainer_id", "battle_type", "members", "spawn_policy", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "trainer_id": { "$ref": "#/$defs/resource_id" },
        "battle_type": { "enum": ["singles", "doubles"] },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/trainer_slot_member" }
        },
        "spawn_policy": { "enum": ["persistent", "on_region_load", "manual"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "battle_type": { "const": "singles" } } },
          "then": { "properties": { "members": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "battle_type": { "const": "doubles" } } },
          "then": { "properties": { "members": { "minItems": 2, "maxItems": 2 } } }
        }
      ]
    },
    "trainer_slot_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "npc_profile", "position", "rotation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "npc_profile": { "$ref": "#/$defs/resource_id" },
        "position": { "$ref": "#/$defs/block_position" },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "npc_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bounds", "max_npcs", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "bounds": { "$ref": "#/$defs/horizontal_bounds" },
        "max_npcs": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        }
      }
    }
  }
}
