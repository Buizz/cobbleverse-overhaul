{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/settlement.schema.json",
  "title": "Cobbleventure settlement definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "enabled",
    "display_name",
    "region",
    "dimension",
    "bounds",
    "center",
    "anchors",
    "content_profile",
    "biome_layout",
    "connections",
    "structure_profile",
    "npc_placement"
  ],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 3 },
    "id": { "$ref": "#/$defs/resource_id" },
    "enabled": { "type": "boolean" },
    "display_name": { "$ref": "#/$defs/localized_text" },
    "region": { "$ref": "#/$defs/resource_id" },
    "dimension": { "$ref": "#/$defs/resource_id" },
    "bounds": { "$ref": "#/$defs/horizontal_bounds" },
    "center": { "$ref": "#/$defs/block_position" },
    "anchors": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
      "additionalProperties": { "$ref": "#/$defs/block_position" }
    },
    "content_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pokemon", "trainers", "level_scaling"],
      "properties": {
        "pokemon": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spawn_profile", "density_multiplier"],
          "properties": {
            "spawn_profile": { "$ref": "#/$defs/resource_id" },
            "density_multiplier": { "type": "number", "exclusiveMinimum": 0, "maximum": 10 },
            "biome_set": { "$ref": "#/$defs/resource_id" },
            "unconditional_spawns": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/resource_id" } }
          }
        },
        "trainers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["population_profile", "max_active", "class_pool"],
          "properties": {
            "population_profile": { "$ref": "#/$defs/resource_id" },
            "max_active": { "type": "integer", "minimum": 0, "maximum": 128 },
            "class_pool": {
              "type": "array",
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/resource_id" }
            }
          }
        },
        "level_scaling": { "$ref": "#/$defs/level_scaling" }
      }
    },
    "biome_layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["arrangement", "transition_width", "zones", "boundary"],
      "properties": {
        "arrangement": { "enum": ["organic_patches", "sectors", "concentric"] },
        "transition_width": { "type": "integer", "minimum": 0, "maximum": 64 },
        "zones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "items": { "$ref": "#/$defs/biome_zone" }
        },
        "boundary": { "$ref": "#/$defs/boundary" }
      }
    },
    "connections": {
      "type": "array",
      "items": { "$ref": "#/$defs/settlement_connection" }
    },
    "structure_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "gym_theme", "gym_entrance_offset", "required_facilities"],
      "properties": {
        "structure": { "$ref": "#/$defs/resource_id" },
        "gym_theme": {
          "enum": [
            "normal", "fire", "water", "electric", "grass", "ice",
            "fighting", "poison", "ground", "flying", "psychic", "bug",
            "rock", "ghost", "dragon", "dark", "steel", "fairy"
          ]
        },
        "gym_entrance_offset": { "$ref": "#/$defs/block_position" },
        "required_facilities": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[a-z0-9_.-]+$" },
          "additionalProperties": { "$ref": "#/$defs/resource_id" }
        },
        "facility_placements": {
          "type": "array",
          "items": { "$ref": "#/$defs/facility_placement" }
        }
      }
    },
    "npc_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_ambient_npcs",
        "default_wander_radius",
        "trainer_slots",
        "zones"
      ],
      "properties": {
        "max_ambient_npcs": { "type": "integer", "minimum": 0 },
        "default_wander_radius": { "type": "number", "minimum": 0 },
        "trainer_slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/trainer_slot" }
        },
        "zones": {
          "type": "array",
          "items": { "$ref": "#/$defs/npc_zone" }
        }
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "required": ["ko_kr"],
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "block_position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "integer" },
        "y": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "horizontal_bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x", "min_z", "max_x", "max_z"],
      "properties": {
        "min_x": { "type": "integer" },
        "min_z": { "type": "integer" },
        "max_x": { "type": "integer" },
        "max_z": { "type": "integer" }
      }
    },
    "horizontal_offset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "z"],
      "properties": {
        "x": { "type": "integer" },
        "z": { "type": "integer" }
      }
    },
    "level_scaling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "base_level", "min_level", "max_level", "per_badge", "per_region", "pokemon_offset", "trainer_offset"],
      "properties": {
        "mode": { "enum": ["fixed", "badges", "region_progress", "badge_and_region", "player_average"] },
        "base_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "min_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "max_level": { "type": "integer", "minimum": 1, "maximum": 100 },
        "per_badge": { "type": "number", "minimum": 0, "maximum": 20 },
        "per_region": { "type": "number", "minimum": 0, "maximum": 30 },
        "pokemon_offset": { "type": "integer", "minimum": -50, "maximum": 50 },
        "trainer_offset": { "type": "integer", "minimum": -50, "maximum": 50 }
      }
    },
    "biome_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "biome", "size_blocks", "placement", "weight"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "biome": { "$ref": "#/$defs/resource_id" },
        "size_blocks": { "type": "integer", "minimum": 32, "maximum": 2048 },
        "placement": { "enum": ["center", "inner", "middle", "outer", "auto"] },
        "weight": { "type": "integer", "minimum": 1, "maximum": 100 },
        "offset": { "$ref": "#/$defs/horizontal_offset" },
        "habitat_profile": { "$ref": "#/$defs/resource_id" },
        "spawn_settings": { "$ref": "#/$defs/spawn_settings" }
      }
    },
    "spawn_settings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generation", "temperature", "humidity", "weather", "time", "rarities", "include_secondary"],
      "properties": {
        "generation": { "type": "integer", "minimum": 0, "maximum": 9 },
        "temperature": { "enum": ["any", "cold", "cool", "temperate", "hot"] },
        "humidity": { "enum": ["any", "dry", "normal", "humid", "aquatic"] },
        "weather": { "enum": ["any", "clear", "rain", "thunder", "snow", "fog"] },
        "time": { "enum": ["any", "day", "night", "twilight"] },
        "rarities": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["common", "medium", "uncommon", "rare", "legendary"] } },
        "include_secondary": { "type": "boolean" }
      }
    },
    "boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "width", "wall_height", "wall_thickness"],
      "properties": {
        "profile": { "$ref": "#/$defs/resource_id" },
        "width": { "type": "integer", "minimum": 1, "maximum": 128 },
        "wall_height": { "type": "integer", "minimum": 3, "maximum": 128 },
        "wall_thickness": { "type": "integer", "minimum": 1, "maximum": 32 }
      }
    },
    "settlement_connection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "target_settlement", "placement", "gate_width", "path_width"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "target_settlement": { "$ref": "#/$defs/resource_id" },
        "placement": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "preferred_side", "offset"],
          "properties": {
            "mode": { "enum": ["toward_target", "fixed_side"] },
            "preferred_side": { "enum": ["north", "south", "east", "west"] },
            "offset": { "type": "integer", "minimum": -1024, "maximum": 1024 }
          }
        },
        "gate_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "path_width": { "type": "integer", "minimum": 3, "maximum": 31 },
        "requirement": { "$ref": "#/$defs/resource_id" }
      }
    },
    "facility_placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "mode", "structure"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "mode": { "enum": ["instanced_entry", "direct_template"] },
        "structure": { "$ref": "#/$defs/resource_id" },
        "anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "entry_anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "return_anchor": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "instance_origin": { "$ref": "#/$defs/block_position" },
        "instance_entry_offset": { "$ref": "#/$defs/block_position" },
        "instance_exit_offset": { "$ref": "#/$defs/block_position" },
        "trigger_radius": { "type": "number", "minimum": 0.5, "maximum": 8 }
      },
      "allOf": [
        {
          "if": { "properties": { "mode": { "const": "instanced_entry" } } },
          "then": {
            "required": [
              "entry_anchor", "return_anchor", "instance_origin",
              "instance_entry_offset", "instance_exit_offset", "trigger_radius"
            ]
          }
        },
        {
          "if": { "properties": { "mode": { "const": "direct_template" } } },
          "then": { "required": ["anchor"] }
        }
      ]
    },
    "trainer_slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "trainer_id", "battle_type", "members", "spawn_policy", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "trainer_id": { "$ref": "#/$defs/resource_id" },
        "battle_type": { "enum": ["singles", "doubles"] },
        "members": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/trainer_slot_member" }
        },
        "spawn_policy": { "enum": ["persistent", "on_region_load", "manual"] },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "battle_type": { "const": "singles" } } },
          "then": { "properties": { "members": { "minItems": 1, "maxItems": 1 } } }
        },
        {
          "if": { "properties": { "battle_type": { "const": "doubles" } } },
          "then": { "properties": { "members": { "minItems": 2, "maxItems": 2 } } }
        }
      ]
    },
    "trainer_slot_member": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "npc_profile", "position", "rotation"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "npc_profile": { "$ref": "#/$defs/resource_id" },
        "position": { "$ref": "#/$defs/block_position" },
        "rotation": { "type": "number", "minimum": -360, "maximum": 360 }
      }
    },
    "npc_zone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bounds", "max_npcs", "tags"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "bounds": { "$ref": "#/$defs/horizontal_bounds" },
        "max_npcs": { "type": "integer", "minimum": 1 },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        }
      }
    }
  }
}
