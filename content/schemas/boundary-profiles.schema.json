{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/boundary-profiles.schema.json",
  "title": "Cobbleventure hex boundary profiles",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/profile" }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "block_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "type", "width", "height", "foundation_depth",
        "collision", "core_block", "surface_blocks"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "type": { "enum": ["wall", "earthwork", "tree_line"] },
        "width": { "type": "integer", "minimum": 1, "maximum": 32 },
        "height": { "type": "integer", "minimum": 1, "maximum": 64 },
        "foundation_depth": { "type": "integer", "minimum": 0, "maximum": 32 },
        "collision": { "enum": ["hard", "protected", "soft"] },
        "core_block": { "$ref": "#/$defs/block_id" },
        "surface_blocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": { "$ref": "#/$defs/block_id" }
        },
        "tree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["log", "leaves", "spacing", "min_height", "max_height"],
          "properties": {
            "log": { "$ref": "#/$defs/block_id" },
            "leaves": { "$ref": "#/$defs/block_id" },
            "spacing": { "type": "integer", "minimum": 1, "maximum": 16 },
            "min_height": { "type": "integer", "minimum": 2, "maximum": 32 },
            "max_height": { "type": "integer", "minimum": 2, "maximum": 48 }
          }
        }
      }
    }
  }
}

