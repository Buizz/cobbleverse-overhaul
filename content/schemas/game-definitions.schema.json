{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.local/schemas/game-definitions.schema.json",
  "title": "Cobbleventure game data definitions",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "items", "variables"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "items": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "variables": {
      "type": "array",
      "items": { "$ref": "#/$defs/variable" }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "additionalProperties": { "type": "string" },
      "required": ["ko_kr"],
      "properties": {
        "ko_kr": { "type": "string", "minLength": 1 },
        "en_us": { "type": "string" }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "base_item", "display_name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "base_item": { "$ref": "#/$defs/resource_id" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "description": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    },
    "variable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scope", "type", "default", "display_name", "description"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "scope": { "enum": ["global", "player"] },
        "type": { "enum": ["boolean", "integer", "string"] },
        "default": { "type": ["boolean", "integer", "string"] },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "description": { "type": "object", "additionalProperties": { "type": "string" } }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "boolean" } } }, "then": { "properties": { "default": { "type": "boolean" } } } },
        { "if": { "properties": { "type": { "const": "integer" } } }, "then": { "properties": { "default": { "type": "integer" } } } },
        { "if": { "properties": { "type": { "const": "string" } } }, "then": { "properties": { "default": { "type": "string" } } } }
      ]
    }
  }
}
