{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/trainer-roster.schema.json",
  "title": "Cobbleventure named trainer and organization roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "asset_policy", "organizations", "league_characters"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "asset_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rct_source", "distribution", "states"],
      "properties": {
        "rct_source": { "type": "string", "format": "uri" },
        "distribution": { "const": "dependency_reference" },
        "states": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      }
    },
    "organizations": {
      "type": "array",
      "items": { "$ref": "#/$defs/organization" }
    },
    "league_characters": {
      "type": "array",
      "items": { "$ref": "#/$defs/character" }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "required": ["ko_kr", "en_us"],
      "additionalProperties": false,
      "properties": {
        "ko_kr": { "type": "string", "minLength": 1 },
        "en_us": { "type": "string", "minLength": 1 }
      }
    },
    "appearance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "type", "resource", "implementation_status", "asset_status", "distribution"],
      "properties": {
        "source": { "enum": ["custom", "rct_single"] },
        "type": { "enum": ["skin", "model"] },
        "resource": { "$ref": "#/$defs/resource_id" },
        "candidate_resource": { "$ref": "#/$defs/resource_id" },
        "implementation_status": { "enum": ["ready", "placeholder"] },
        "asset_status": { "enum": ["verified", "definition_only", "missing"] },
        "distribution": { "enum": ["dependency_reference", "original_required"] }
      }
    },
    "character": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "role", "gender", "generation", "region", "appearance"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "role": { "enum": ["grunt", "admin", "boss", "named_agent", "gym_leader", "elite_four", "champion"] },
        "gender": { "enum": ["male", "female", "nonbinary", "unspecified"] },
        "generation": { "type": "integer", "minimum": 1, "maximum": 9 },
        "region": { "type": "string", "pattern": "^[a-z0-9_.-]+$" },
        "appearance": { "$ref": "#/$defs/appearance" }
      }
    },
    "organization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "display_name", "generations", "regions", "grunt_variants", "named_characters"],
      "properties": {
        "id": { "$ref": "#/$defs/resource_id" },
        "display_name": { "$ref": "#/$defs/localized_text" },
        "generations": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "integer", "minimum": 1, "maximum": 9 }
        },
        "regions": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
        },
        "grunt_variants": {
          "type": "array", "minItems": 2,
          "items": { "$ref": "#/$defs/character" }
        },
        "named_characters": {
          "type": "array",
          "items": { "$ref": "#/$defs/character" }
        }
      }
    }
  }
}
