{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cobbleventure.example/schema/trainer-classes.schema.json",
  "title": "Cobbleventure trainer class catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "classes"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": 1 },
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "title_pattern", "default_appearance", "tags"],
        "properties": {
          "id": { "$ref": "#/$defs/resource_id" },
          "display_name": { "$ref": "#/$defs/localized_text" },
          "title_pattern": { "$ref": "#/$defs/localized_text" },
          "default_appearance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "type", "resource"],
            "properties": {
              "source": { "enum": ["custom", "rct_single", "rct_group"] },
              "type": { "enum": ["skin", "model"] },
              "resource": { "$ref": "#/$defs/resource_id" },
              "portrait": { "$ref": "#/$defs/resource_id" }
            }
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9_.-]+$" }
          }
        }
      }
    }
  },
  "$defs": {
    "resource_id": {
      "type": "string",
      "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"
    },
    "localized_text": {
      "type": "object",
      "minProperties": 1,
      "required": ["ko_kr"],
      "propertyNames": { "pattern": "^[a-z]{2}_[a-z]{2}$" },
      "additionalProperties": { "type": "string", "minLength": 1 }
    }
  }
}
