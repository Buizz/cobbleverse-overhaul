{
  "$schema": "../../schemas/content-bundle.schema.json",
  "schema_version": 1,
  "id": "cobbleventure:trainer/starter_town_leader",
  "enabled": true,
  "name": {
    "ko_kr": "태산",
    "en_us": "Tae-san"
  },
  "description": {
    "ko_kr": "대화, RCT 전투, 승리 플래그와 보상을 검증하기 위한 첫 번째 기준 트레이너입니다."
  },
  "tags": ["gym_leader", "starter_town", "main_story"],
  "npc": {
    "display_name": {
      "ko_kr": "체육관 관장 태산",
      "en_us": "Gym Leader Tae-san"
    },
    "trainer_class": "cobbleventure:trainer_class/gym_leader",
    "appearance": {
      "source": "custom",
      "type": "skin",
      "resource": "cobbleventure:npc/starter_town_leader",
      "portrait": "cobbleventure:gui/portrait/starter_town_leader"
    },
    "behavior": {
      "movement": "stationary",
      "look_at_player": true,
      "interaction_range": 4.0,
      "invulnerable": true,
      "collision": true
    }
  },
  "placement": {
    "region": "cobbleventure:region/generation_1/region_01",
    "settlement": "cobbleventure:settlement/starter_town",
    "anchor": "cobbleventure:anchor/starter_town/gym_leader",
    "offset": { "x": 0, "y": 0, "z": 0 },
    "rotation": 180,
    "spawn_policy": "persistent"
  },
  "battle": {
    "trainer_id": "cobbleventure:trainer/starter_town_leader",
    "format": "GEN_9_SINGLES",
    "battle_type": "singles",
    "ai": "cobbleventure:ai/balanced",
    "level_mode": "fixed",
    "rules": {
      "max_item_uses": 1,
      "can_forfeit": true
    },
    "bag": [
      {
        "item": "cobblemon:potion",
        "quantity": 1
      }
    ],
    "mechanics": {
      "mega_evolution": false,
      "z_move": false,
      "dynamax": false,
      "terastallization": false
    },
    "team": [
      {
        "species": "cobblemon:geodude",
        "level": 12,
        "form": null,
        "aspects": [],
        "gender": "random",
        "nature": "impish",
        "ability": "sturdy",
        "held_item": null,
        "gimmick": null,
        "moves": ["tackle", "defense_curl", "rock_throw"],
        "ivs": {
          "hp": 20,
          "attack": 20,
          "defense": 20,
          "special_attack": 10,
          "special_defense": 20,
          "speed": 10
        },
        "evs": {},
        "tera_type": "rock",
        "shiny": false,
        "gigantamax_factor": false
      }
    ]
  },
  "dialogue": {
    "entry": "cobbleventure:dialogue/starter_town_leader/first_meet",
    "nodes": [
      {
        "id": "cobbleventure:dialogue/starter_town_leader/first_meet",
        "speaker": "npc",
        "text": {
          "ko_kr": "처음 보는 얼굴이군. 나와 승부하겠나?",
          "en_us": "A new face. Would you like to challenge me?"
        },
        "conditions": [],
        "actions": [],
        "choices": [
          {
            "id": "battle",
            "text": { "ko_kr": "승부한다", "en_us": "Battle" },
            "conditions": [],
            "actions": [
              {
                "type": "start_battle",
                "trainer": "cobbleventure:trainer/starter_town_leader"
              }
            ]
          },
          {
            "id": "cancel",
            "text": { "ko_kr": "아직 준비가 안 됐다", "en_us": "Not yet" },
            "conditions": [],
            "actions": [
              {
                "type": "next_dialogue",
                "target": "cobbleventure:dialogue/starter_town_leader/cancel"
              }
            ]
          }
        ]
      },
      {
        "id": "cobbleventure:dialogue/starter_town_leader/cancel",
        "speaker": "npc",
        "text": {
          "ko_kr": "준비가 되면 다시 찾아오게.",
          "en_us": "Come back when you are ready."
        },
        "conditions": [],
        "actions": [{ "type": "close_dialogue" }],
        "choices": []
      },
      {
        "id": "cobbleventure:dialogue/starter_town_leader/after_victory",
        "speaker": "npc",
        "text": {
          "ko_kr": "훌륭한 승부였다. 이 배지는 네 것이다.",
          "en_us": "That was an excellent battle. This badge is yours."
        },
        "conditions": [],
        "actions": [{ "type": "close_dialogue" }],
        "choices": []
      },
      {
        "id": "cobbleventure:dialogue/starter_town_leader/after_defeat",
        "speaker": "npc",
        "text": {
          "ko_kr": "좋은 승부였다. 준비해서 다시 도전하게.",
          "en_us": "A good battle. Prepare yourself and challenge me again."
        },
        "conditions": [],
        "actions": [{ "type": "close_dialogue" }],
        "choices": []
      }
    ]
  },
  "progression": {
    "requirements": [],
    "victory_flag": "cobbleventure:flag/trainer/starter_town_leader/defeated",
    "rematch": { "enabled": false },
    "dialogue_routes": [
      {
        "when": {
          "type": "flag_equals",
          "key": "cobbleventure:flag/trainer/starter_town_leader/defeated",
          "value": true
        },
        "entry": "cobbleventure:dialogue/starter_town_leader/after_victory"
      },
      {
        "when": { "type": "always" },
        "entry": "cobbleventure:dialogue/starter_town_leader/first_meet"
      }
    ]
  },
  "outcomes": {
    "on_player_win": {
      "actions": [
        {
          "type": "set_flag",
          "key": "cobbleventure:flag/trainer/starter_town_leader/defeated",
          "value": true
        },
        {
          "type": "give_item",
          "item": "cobbleventure:starter_badge",
          "count": 1
        },
        {
          "type": "open_dialogue",
          "target": "cobbleventure:dialogue/starter_town_leader/after_victory"
        }
      ]
    },
    "on_player_loss": {
      "actions": [
        {
          "type": "open_dialogue",
          "target": "cobbleventure:dialogue/starter_town_leader/after_defeat"
        }
      ]
    }
  }
}
